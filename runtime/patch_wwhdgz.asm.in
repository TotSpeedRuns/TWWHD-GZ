0x025B5C8C = _gz_grapple_native_mark_get:
.origin = codecave
; Called inside the existing frame wrapper, after route-finish. Integer-only
; native callee, no FPR/paired-single instructions on the admitted bit0 path.
; Preserve all GPR0/3..31, CR, LR. GPR1/2, CTR, XER, all FPR/paired lanes unchanged.
_gz_grapple_acquisition_tick:
    stwu r1, -0xA0(r1)
    stw r0, 8(r1)
    mflr r0
    stw r0, 12(r1)
    .int 0x7C000026 ; mfcr r0
    stw r0, 16(r1)
    stmw r3, 20(r1)
    lis r8, _gz_grapple_acquisition_diag@ha
    lwz r8, _gz_grapple_acquisition_diag@l(r8)
    cmpwi r8, 2
    beq _gz_grapple_acquisition_done
    lis r8, _gz_state@ha
    lwz r8, _gz_state@l(r8)
    cmpwi r8, 0
    bne _gz_grapple_acquisition_done
    lis r8, _gz_pending@ha
    lwz r8, _gz_pending@l(r8)
    cmpwi r8, 0
    bne _gz_grapple_acquisition_done
    lis r8, _gz_life_phase@ha
    lwz r8, _gz_life_phase@l(r8)
    cmpwi r8, 0
    bne _gz_grapple_acquisition_done
    lis r8, _gz_route_active@ha
    lwz r8, _gz_route_active@l(r8)
    cmpwi r8, 0
    bne _gz_grapple_acquisition_done
    lis r8, _gz_loading_store@ha
    lbz r8, _gz_loading_store@l(r8)
    cmpwi r8, 0
    bne _gz_grapple_acquisition_done
    lis r8, _gz_next_store@ha
    addi r8, r8, _gz_next_store@l
    lbz r8, 12(r8)
    cmpwi r8, 0
    bne _gz_grapple_acquisition_done
    lis r8, 0x1047
    lbz r8, 0x4342(r8)
    cmpwi r8, 0
    bne _gz_grapple_acquisition_done
    lis r8, _gz_stage_store@ha
    lbz r8, _gz_stage_store@l(r8)
    cmpwi r8, 0
    beq _gz_grapple_acquisition_done
    lis r8, _gz_link_slot@ha
    lwz r11, _gz_link_slot@l(r8)
    lis r9, 0x1000
    cmplw r11, r9
    blt _gz_grapple_acquisition_done
    lis r9, 0xBFFE
    addi r9, r9, -0x65F4
    cmplw r11, r9
    bgt _gz_grapple_acquisition_done
    andi. r9, r11, 3
    bne _gz_grapple_acquisition_done
    lhz r9, 8(r11)
    cmpwi r9, 168
    bne _gz_grapple_acquisition_done
    lwz r9, 0xC4(r11)
    lis r10, 0x0913
    ori r10, r10, 5
    cmpw r9, r10
    bne _gz_grapple_acquisition_done
    lwz r9, 0x65F0(r11)
    cmpwi r9, 169
    blt _gz_grapple_acquisition_player_ready
    cmpwi r9, 221
    ble _gz_grapple_acquisition_done
_gz_grapple_acquisition_player_ready:
    lis r8, _gz_heap_slot@ha
    lwz r10, _gz_heap_slot@l(r8)
    lis r9, 0x1000
    cmplw r10, r9
    blt _gz_grapple_acquisition_done
    lis r9, 0xBFFE
    addi r9, r9, -0x75
    cmplw r10, r9
    bgt _gz_grapple_acquisition_done
    andi. r9, r10, 3
    bne _gz_grapple_acquisition_done
    lbz r9, 0x5F(r10)
    cmpwi r9, 0x25
    bne _gz_grapple_acquisition_done
    lbz r9, 0x74(r10)
    andi. r9, r9, 1
    bne _gz_grapple_acquisition_done
    ; Final same-allocation fence before native marking. No item/equip rewrite.
    lwz r9, _gz_heap_slot@l(r8)
    cmpw r9, r10
    bne _gz_grapple_acquisition_done
    mr r30, r10
    lbz r31, 0x74(r30)
    addi r3, r10, 0x71
    li r4, 3
    li r5, 0
    bl _gz_grapple_native_mark_get
    ; Void native setter: success is exact current-allocation/byte readback.
    li r11, 2
    li r12, -1
    lis r8, _gz_heap_slot@ha
    lwz r9, _gz_heap_slot@l(r8)
    cmpw r9, r30
    bne _gz_grapple_acquisition_publish
    lbz r12, 0x74(r30)
    ori r9, r31, 1
    cmpw r9, r12
    bne _gz_grapple_acquisition_publish
    li r11, 1
_gz_grapple_acquisition_publish:
    lis r8, _gz_grapple_acquisition_diag@ha
    addi r8, r8, _gz_grapple_acquisition_diag@l
    stw r30, 4(r8)
    stw r31, 8(r8)
    stw r12, 12(r8)
    lwz r9, 16(r8)
    addi r9, r9, 1
    stw r9, 16(r8)
    sync
    stw r11, 0(r8)
_gz_grapple_acquisition_done:
    lmw r3, 20(r1)
    lwz r0, 16(r1)
    .int 0x7C0FF120 ; mtcrf 255,r0
    lwz r0, 12(r1)
    mtlr r0
    lwz r0, 8(r1)
    addi r1, r1, 0xA0
    blr
.origin = codecave
