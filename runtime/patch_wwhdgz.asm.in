    beq _gz_user_totg_arrival_scene_selected
    cmplwi r3, 583
    beq _gz_user_totg_arrival_scene_selected
    cmplwi r3, 552
    blt _gz_v103_arrival_before_floor_aliases
    cmplwi r3, 583
    bgt _gz_v103_arrival_before_floor_aliases
    addi r3, r3, -552
    mulli r3, r3, 4
