.align 4
; Return one navigation pulse in r3. Native normalized stick units +/-1000.
; Own repeat timer handles horizontal directions and analog input as well.
_gz_map_navigation_v02:
    li r3, 0
    lis r4, _gz_map_navigation_state@ha
    addi r4, r4, _gz_map_navigation_state@l
    lis r5, _gz_page@ha
    lwz r5, _gz_page@l(r5)
    lwz r8, 0(r31)
    lis r9, _gz_bind_masks@ha
    addi r9, r9, _gz_bind_masks@l
    lwz r6, 12(r9)
    and r7, r8, r6
    cmpw r7, r6
    bne _gz_map_v02_check_down
    mr r3, r6
_gz_map_v02_check_down:
    lwz r6, 16(r9)
    and r7, r8, r6
    cmpw r7, r6
    bne _gz_map_v02_check_horizontal
    cmpwi r3, 0
    bne _gz_map_v02_nav_reset
    mr r3, r6
_gz_map_v02_check_horizontal:
    cmpwi r5, 13
    bne _gz_map_v02_check_stick
    andi. r7, r8, 0x0C00
    cmpwi r7, 0x0C00
    beq _gz_map_v02_nav_reset
    cmpwi r7, 0
    beq _gz_map_v02_check_stick
    cmpwi r3, 0
    bne _gz_map_v02_nav_reset
    mr r3, r7
_gz_map_v02_check_stick:
    cmpwi r3, 0
    bne _gz_map_v02_nav_direction
    lis r8, _gz_input_snapshot@ha
    addi r8, r8, _gz_input_snapshot@l
    lwz r6, 20(r8)
    lwz r7, 24(r8)
    mr r10, r6
    cmpwi r10, 0
    bge _gz_map_v02_x_abs
    neg r10, r10
_gz_map_v02_x_abs:
    mr r11, r7
    cmpwi r11, 0
    bge _gz_map_v02_y_abs
    neg r11, r11
_gz_map_v02_y_abs:
    cmpwi r5, 14
    beq _gz_map_v02_vertical_stick
    cmpw r10, r11
    ble _gz_map_v02_vertical_stick
    cmpwi r10, 400
    blt _gz_map_v02_nav_reset
    li r3, 0x0400
    cmpwi r6, 0
    bge _gz_map_v02_nav_direction
    li r3, 0x0800
    b _gz_map_v02_nav_direction
_gz_map_v02_vertical_stick:
    cmpwi r11, 400
    blt _gz_map_v02_nav_reset
    lwz r3, 12(r9)
    cmpwi r7, 0
    bge _gz_map_v02_nav_direction
    lwz r3, 16(r9)
_gz_map_v02_nav_direction:
    lis r6, 0x1020
    lwz r6, -0xAA8(r6)
    lwz r7, 0(r4)
    cmpw r3, r7
    bne _gz_map_v02_nav_start
    lwz r7, 8(r4)
    cmpw r5, r7
    bne _gz_map_v02_nav_start
    lwz r7, 4(r4)
    subf r7, r7, r6
    cmpwi r7, 0
    blt _gz_map_v02_nav_wait
    addi r6, r6, 3
    stw r6, 4(r4)
    blr
_gz_map_v02_nav_start:
    stw r3, 0(r4)
    stw r5, 8(r4)
    addi r6, r6, 15
    stw r6, 4(r4)
    blr
_gz_map_v02_nav_wait:
    li r3, 0
    blr
_gz_map_v02_nav_reset:
    li r3, 0
    stw r3, 0(r4)
    blr
.align 4
_gz_map_navigation_state:
.int 0,0,0

