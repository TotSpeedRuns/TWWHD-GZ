    cmpwi r3, 0
    bne _gz_foliage_preflight_bad
    lwz r8, 12(r29)
    lwz r9, 4(r31)
    cmpw r8, r9
    bne _gz_foliage_preflight_bad
    lhz r8, 0x98(r29)
    lwz r9, 8(r31)
    cmpw r8, r9
    bne _gz_foliage_preflight_bad
    addi r26, r31, 16
    addi r27, r29, 0x9C
    lwz r28, 4(r30)
_gz_foliage_preflight_unit:
    cmpwi r28, 0
