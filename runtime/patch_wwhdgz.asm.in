    lwz r5, 0(r29)
    li r4, 255
    bl _gz_life_find_actor
    mr r28, r3
    cmpwi r28, 0
    beq _gz_field_preflight_bad
    lwz r8, 4(r29)
    cmpw r8, r28
    bne _gz_field_preflight_bad
    lwz r8, 0xB0(r28)
    lwz r9, 8(r29)
    cmpw r8, r9
    bne _gz_field_preflight_bad
    lbz r8, 0x326(r28)
    lwz r9, 12(r29)
    cmpw r8, r9
    bne _gz_field_preflight_bad
    lbz r8, 0x785(r28)
    cmplwi r8, 2
    ble _gz_field_preflight_live_kind
    lbz r8, 213(r29)
    cmpwi r8, 6
    bne _gz_field_preflight_bad
_gz_field_preflight_live_kind:
    bl _gz_field_live_safe
    cmpwi r3, 0
    bne _gz_field_preflight_bad
    lwz r8, 0x3B4(r28)
    lwz r9, 36(r29)
    cmpw r8, r9
    bne _gz_field_preflight_bad
    mr r3, r28
    mr r4, r29
    li r5, 1
    bl _gz_field_frames
    cmpwi r3, 0
    bne _gz_field_preflight_bad
    addi r29, r29, 384
    addi r30, r30, -1
    b _gz_field_preflight_row
_gz_field_preflight_ok:
    li r3, 0
    b _gz_field_preflight_done
_gz_field_preflight_bad:
    li r3, 28
_gz_field_preflight_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr

_gz_field_apply:
    stwu r1, -0x140(r1)
    mflr r0
    stw r0, 0x144(r1)
    stmw r26, 0x28(r1)
    stfd f0, 64(r1)
    .int 0x100004A0
    stfs f0, 72(r1)
    stfd f1, 80(r1)
    .int 0x10210CA0
    stfs f1, 88(r1)
    stfd f2, 96(r1)
    .int 0x104214A0
    stfs f2, 104(r1)
    stfd f3, 112(r1)
    .int 0x10631CA0
    stfs f3, 120(r1)
    stfd f4, 128(r1)
    .int 0x108424A0
    stfs f4, 136(r1)
    stfd f5, 144(r1)
    .int 0x10A52CA0
    stfs f5, 152(r1)
    stfd f6, 160(r1)
    .int 0x10C634A0
    stfs f6, 168(r1)
    stfd f7, 176(r1)
    .int 0x10E73CA0
    stfs f7, 184(r1)
    stfd f8, 192(r1)
    .int 0x110844A0
    stfs f8, 200(r1)
    stfd f9, 208(r1)
    .int 0x11294CA0
    stfs f9, 216(r1)
    stfd f10, 224(r1)
    .int 0x114A54A0
    stfs f10, 232(r1)
    stfd f11, 240(r1)
    .int 0x116B5CA0
    stfs f11, 248(r1)
    stfd f12, 256(r1)
    .int 0x118C64A0
    stfs f12, 264(r1)
    stfd f13, 272(r1)
    .int 0x11AD6CA0
    stfs f13, 280(r1)
    bl _gz_field_base
    mr r31, r3
    lis r8, 0x1047
    lwz r9, 16(r31)
    stw r9, 0x4BF4(r8)
    lwz r9, 20(r31)
    stw r9, 0x4BF8(r8)
    lwz r30, 4(r31)
    addi r29, r31, 32
_gz_field_apply_row:
    cmpwi r30, 0
    beq _gz_field_apply_end
    lwz r28, 4(r29)
    lbz r8, 212(r29)
    lbz r9, 0x784(r28)
    cmpwi r8, 2
    beq _gz_field_apply_water_owner
    cmpwi r9, 2
    bne _gz_field_apply_display
_gz_field_apply_water_owner:
    ; Publish the saved pose for the native background/water query first.
    mr r3, r28
    mr r4, r29
    li r5, 1
    bl _gz_field_transfer
    bl _gz_field_native_get_info
    addi r4, r3, 0x12A0
    addi r3, r28, 0x3D4
    bl _gz_field_native_acch_correct
    ; Native wait init retires the current ripple. Water init then creates a
    ; fresh emitter pointing at this actor, including newly constructed ones.
    mr r3, r28
    bl _gz_field_native_wait_init
    lbz r8, 212(r29)
    cmpwi r8, 2
    bne _gz_field_apply_display
    mr r3, r28
    bl _gz_field_native_water_init
_gz_field_apply_display:
    lbz r8, 213(r29)
    cmpwi r8, 6
    bne _gz_field_apply_scalars
    ; Native display init disables collision and releases its current particle
    ; callbacks. It does not call execItemGet or grant the captured reward.
    mr r3, r28
    bl _gz_field_native_init_display
_gz_field_apply_scalars:
    mr r3, r28
    mr r4, r29
    li r5, 1
    bl _gz_field_transfer
    mr r3, r28
    mr r4, r29
    li r5, 2
    bl _gz_field_frames
    mr r3, r28
    bl _gz_field_native_set_matrix
    addi r29, r29, 384
    addi r30, r30, -1
    b _gz_field_apply_row
_gz_field_apply_end:
    lis r8, _gz_field_phase@ha
    li r9, 0
    stw r9, _gz_field_phase@l(r8)
_gz_field_apply_done:
    lfs f0, 72(r1)
    lfd f0, 64(r1)
    lfs f1, 88(r1)
    lfd f1, 80(r1)
    lfs f2, 104(r1)
    lfd f2, 96(r1)
    lfs f3, 120(r1)
    lfd f3, 112(r1)
    lfs f4, 136(r1)
    lfd f4, 128(r1)
    lfs f5, 152(r1)
    lfd f5, 144(r1)
    lfs f6, 168(r1)
    lfd f6, 160(r1)
    lfs f7, 184(r1)
    lfd f7, 176(r1)
    lfs f8, 200(r1)
    lfd f8, 192(r1)
    lfs f9, 216(r1)
    lfd f9, 208(r1)
    lfs f10, 232(r1)
    lfd f10, 224(r1)
    lfs f11, 248(r1)
    lfd f11, 240(r1)
    lfs f12, 264(r1)
    lfd f12, 256(r1)
    lfs f13, 280(r1)
    lfd f13, 272(r1)
    lmw r26, 0x28(r1)
    lwz r0, 0x144(r1)
    mtlr r0
    addi r1, r1, 0x140
    blr

; r3=0 in-place, 1 native cross-area replay. A missing actor is only
; constructed for measured simple free rupees/hearts; no blanket profile skip.
_gz_field_reconcile:
    stwu r1, -0x140(r1)
    mflr r0
    stw r0, 0x144(r1)
    stmw r26, 0x28(r1)
    stfd f0, 64(r1)
    .int 0x100004A0
    stfs f0, 72(r1)
    stfd f1, 80(r1)
    .int 0x10210CA0
    stfs f1, 88(r1)
    stfd f2, 96(r1)
    .int 0x104214A0
    stfs f2, 104(r1)
    stfd f3, 112(r1)
    .int 0x10631CA0
    stfs f3, 120(r1)
    stfd f4, 128(r1)
    .int 0x108424A0
    stfs f4, 136(r1)
    stfd f5, 144(r1)
    .int 0x10A52CA0
    stfs f5, 152(r1)
    stfd f6, 160(r1)
    .int 0x10C634A0
    stfs f6, 168(r1)
    stfd f7, 176(r1)
    .int 0x10E73CA0
    stfs f7, 184(r1)
    stfd f8, 192(r1)
    .int 0x110844A0
    stfs f8, 200(r1)
    stfd f9, 208(r1)
    .int 0x11294CA0
    stfs f9, 216(r1)
    stfd f10, 224(r1)
    .int 0x114A54A0
    stfs f10, 232(r1)
    stfd f11, 240(r1)
    .int 0x116B5CA0
    stfs f11, 248(r1)
    stfd f12, 256(r1)
    .int 0x118C64A0
    stfs f12, 264(r1)
    stfd f13, 272(r1)
    .int 0x11AD6CA0
    stfs f13, 280(r1)
    stw r3, 20(r1)
    lis r26, _gz_field_phase@ha
    addi r26, r26, _gz_field_phase@l
    bl _gz_field_base
    mr r31, r3
    cmpwi r31, 0
    beq _gz_field_reconcile_bad
    bl _gz_field_record_safe
    cmpwi r3, 0
    bne _gz_field_reconcile_bad
    lwz r8, 0(r26)
    cmpwi r8, 0
    bne _gz_field_reconcile_guard
    lwz r30, 4(r31)
    cmpwi r30, 0
    bne _gz_field_reconcile_guard
    lis r8, 0x101F
    lwz r28, 0x3328(r8)
    li r27, 4096
_gz_field_reconcile_empty:
    cmpwi r28, 0
    beq _gz_field_reconcile_ok
    addi r27, r27, -1
    cmpwi r27, 0
    beq _gz_field_reconcile_bad
    lwz r8, 12(r28)
    cmpwi r8, 0
    beq _gz_field_reconcile_empty_next
    lhz r8, 8(r8)
    cmpwi r8, 255
    beq _gz_field_reconcile_guard
_gz_field_reconcile_empty_next:
    lwz r28, 8(r28)
    b _gz_field_reconcile_empty
_gz_field_reconcile_guard:
    lwz r8, 20(r1)
    cmpwi r8, 1
    beq _gz_field_reconcile_phase
    bl _gz_v103_restore_ready
    cmpwi r3, 0
    bne _gz_field_reconcile_done
    mr r3, r11
    bl _gz_player_preflight
    cmpwi r3, 0
    bne _gz_field_reconcile_bad
    bl _gz_camera_preflight
    cmpwi r3, 0
    bne _gz_field_reconcile_bad
    bl _gz_mca_blend_preflight
    cmpwi r3, 0
    bne _gz_field_reconcile_bad
    bl _gz_bflower_preflight
    cmpwi r3, 0
    bne _gz_field_reconcile_bad
    li r3, 255
    bl _gz_v104_actor_registry_validate
    cmpwi r3, 1
    bne _gz_field_reconcile_bad
_gz_field_reconcile_phase:
    lwz r8, 0(r26)
    cmpwi r8, 0
    beq _gz_field_reconcile_rows
    lwz r9, 12(r26)
    lwz r10, 20(r1)
    cmpw r9, r10
    bne _gz_field_reconcile_bad
    lis r9, _gz_slots_selected@ha
    lwz r9, _gz_slots_selected@l(r9)
    lwz r10, 16(r26)
    cmpw r9, r10
    bne _gz_field_reconcile_bad
    lis r9, _gz_mss_frame_counter@ha
    lwz r9, _gz_mss_frame_counter@l(r9)
    lwz r10, 8(r26)
    subf r9, r10, r9
    cmplwi r9, 120
    bgt _gz_field_reconcile_bad
    stw r8, 24(r1)
    lwz r5, 4(r26)
    li r4, 255
    bl _gz_life_find_actor
    lwz r8, 24(r1)
    cmpwi r8, 2
    beq _gz_field_reconcile_delete_wait
    cmpwi r8, 3
    beq _gz_field_reconcile_collect_wait
    cmpwi r3, 0
    beq _gz_field_reconcile_pending
    lwz r8, 0x3B4(r3)
    cmpwi r8, 0
    beq _gz_field_reconcile_pending
    b _gz_field_reconcile_phase_ready
_gz_field_reconcile_collect_wait:
    cmpwi r3, 0
    beq _gz_field_reconcile_phase_ready
    bl _gz_field_collect_wait_safe
    cmpwi r3, 0
    bne _gz_field_reconcile_bad
    b _gz_field_reconcile_pending
_gz_field_reconcile_delete_wait:
    cmpwi r3, 0
    bne _gz_field_reconcile_pending
_gz_field_reconcile_phase_ready:
    li r8, 0
    stw r8, 0(r26)
_gz_field_reconcile_rows:
    ; A display owns native callbacks until its own deletion completes.
    ; Drain it before any replacement construction or identity rebinding:
    ; creating first can overlap the retiring and replacement resource owners.
    lis r8, 0x101F
    lwz r28, 0x3328(r8)
    li r27, 4096
_gz_field_reconcile_drain_node:
    cmpwi r28, 0
    beq _gz_field_reconcile_drain_done
    addi r27, r27, -1
    cmpwi r27, 0
    beq _gz_field_reconcile_bad
    lwz r3, 12(r28)
    cmpwi r3, 0
    beq _gz_field_reconcile_drain_next
    lhz r8, 8(r3)
    cmpwi r8, 255
    bne _gz_field_reconcile_drain_next
    lbz r8, 0x785(r3)
    cmpwi r8, 5
    beq _gz_field_reconcile_collect_start
    cmpwi r8, 6
    beq _gz_field_reconcile_collect_start
_gz_field_reconcile_drain_next:
    lwz r28, 8(r28)
    b _gz_field_reconcile_drain_node
_gz_field_reconcile_drain_done:
    addi r29, r31, 32
    lwz r30, 4(r31)
_gz_field_reconcile_row:
    cmpwi r30, 0
    beq _gz_field_reconcile_extras
    mr r3, r29
    bl _gz_field_find
    cmpwi r3, -1
    beq _gz_field_reconcile_bad
    cmpwi r3, 0
    beq _gz_field_reconcile_missing
    lbz r8, 0x785(r3)
    cmpwi r8, 5
    beq _gz_field_reconcile_collect_start
    cmpwi r8, 6
    beq _gz_field_reconcile_collect_start
    mr r4, r29
    bl _gz_field_bind
    cmpwi r3, 0
    bne _gz_field_reconcile_bad
    addi r29, r29, 384
    addi r30, r30, -1
    b _gz_field_reconcile_row
_gz_field_reconcile_missing:
    lbz r8, 158(r29)
    cmplwi r8, 6
    bgt _gz_field_reconcile_bad
    lwz r8, 148(r29)
    cmpwi r8, 127
    bne _gz_field_reconcile_bad
    li r3, 255
    lwz r4, 8(r29)
    addi r5, r29, 16
    lwz r6, 12(r29)
    addi r7, r29, 28
    addi r8, r29, 112
    li r9, -1
    li r10, 0
    bl _gz_life_native_create
    cmpwi r3, -1
    beq _gz_field_reconcile_bad
    stw r3, 4(r26)
    li r8, 1
    b _gz_field_reconcile_started
_gz_field_reconcile_extras:
    lis r8, 0x101F
    lwz r28, 0x3328(r8)
    li r27, 4096
_gz_field_reconcile_extra_node:
    cmpwi r28, 0
    beq _gz_field_reconcile_final
    addi r27, r27, -1
    cmpwi r27, 0
    beq _gz_field_reconcile_bad
    lwz r30, 12(r28)
    cmpwi r30, 0
    beq _gz_field_reconcile_extra_next
    lhz r8, 8(r30)
    cmpwi r8, 255
    bne _gz_field_reconcile_extra_next
    lwz r8, 4(r30)
    lwz r9, 4(r31)
    addi r10, r31, 32
_gz_field_reconcile_extra_lookup:
    cmpwi r9, 0
    beq _gz_field_reconcile_retire
    lwz r11, 0(r10)
    cmpw r11, r8
    beq _gz_field_reconcile_extra_next
    addi r10, r10, 384
    addi r9, r9, -1
    b _gz_field_reconcile_extra_lookup
_gz_field_reconcile_extra_next:
    lwz r28, 8(r28)
    b _gz_field_reconcile_extra_node
_gz_field_reconcile_retire:
    lbz r8, 0x785(r30)
    cmpwi r8, 5
    beq _gz_field_reconcile_extra_collect
    cmpwi r8, 6
    beq _gz_field_reconcile_extra_collect
    mr r3, r30
    bl _gz_field_live_safe
    cmpwi r3, 0
    bne _gz_field_reconcile_bad
    lbz r8, 0x74E(r30)
    cmplwi r8, 6
    bgt _gz_field_reconcile_bad
    lwz r8, 0x744(r30)
    cmpwi r8, 127
    bne _gz_field_reconcile_bad
    lwz r8, 4(r30)
    stw r8, 4(r26)
    mr r3, r30
    bl _gz_life_native_delete
    li r8, 2
    b _gz_field_reconcile_started
_gz_field_reconcile_extra_collect:
    mr r3, r30
_gz_field_reconcile_collect_start:
    mr r28, r3
    bl _gz_field_collect_wait_safe
    cmpwi r3, 0
    bne _gz_field_reconcile_bad
    lwz r8, 4(r28)
    stw r8, 4(r26)
    li r8, 3
_gz_field_reconcile_started:
    stw r8, 0(r26)
    lis r8, _gz_mss_frame_counter@ha
    lwz r8, _gz_mss_frame_counter@l(r8)
    stw r8, 8(r26)
    lwz r8, 20(r1)
    stw r8, 12(r26)
    lis r8, _gz_slots_selected@ha
    lwz r8, _gz_slots_selected@l(r8)
    stw r8, 16(r26)
_gz_field_reconcile_pending:
    lwz r8, 20(r1)
    cmpwi r8, 1
    beq _gz_field_reconcile_pending_result
    lis r8, _gz_pending@ha
    li r9, 11
    stw r9, _gz_pending@l(r8)
_gz_field_reconcile_pending_result:
    li r3, 5
    b _gz_field_reconcile_done
_gz_field_reconcile_final:
    bl _gz_field_preflight
    b _gz_field_reconcile_done
_gz_field_reconcile_ok:
    li r3, 0
    b _gz_field_reconcile_done
_gz_field_reconcile_bad:
    bl _gz_field_abort_phase
    li r3, 28
_gz_field_reconcile_done:
    lfs f0, 72(r1)
    lfd f0, 64(r1)
    lfs f1, 88(r1)
    lfd f1, 80(r1)
    lfs f2, 104(r1)
    lfd f2, 96(r1)
    lfs f3, 120(r1)
    lfd f3, 112(r1)
    lfs f4, 136(r1)
    lfd f4, 128(r1)
    lfs f5, 152(r1)
    lfd f5, 144(r1)
    lfs f6, 168(r1)
    lfd f6, 160(r1)
    lfs f7, 184(r1)
    lfd f7, 176(r1)
    lfs f8, 200(r1)
    lfd f8, 192(r1)
    lfs f9, 216(r1)
    lfd f9, 208(r1)
    lfs f10, 232(r1)
    lfd f10, 224(r1)
    lfs f11, 248(r1)
    lfd f11, 240(r1)
    lfs f12, 264(r1)
    lfd f12, 256(r1)
    lfs f13, 280(r1)
    lfd f13, 272(r1)
    lmw r26, 0x28(r1)
    lwz r0, 0x144(r1)
    mtlr r0
    addi r1, r1, 0x140
    blr

_gz_field_abort_phase:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    lis r31, _gz_field_phase@ha
    addi r31, r31, _gz_field_phase@l
    lwz r8, 0(r31)
    cmpwi r8, 1
    bne _gz_field_abort_clear
    lwz r5, 4(r31)
    li r4, 255
    bl _gz_life_find_actor
    cmpwi r3, 0
    beq _gz_field_abort_clear
    bl _gz_life_native_delete
_gz_field_abort_clear:
    li r8, 0
    stw r8, 0(r31)
_gz_field_abort_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr

_gz_field_travel_tick:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    lis r31, _gz_field_travel_pending@ha
    addi r31, r31, _gz_field_travel_pending@l
    lwz r8, 0(r31)
    cmpwi r8, 1
    bne _gz_field_travel_done
    lis r8, _gz_route_active@ha
    lwz r8, _gz_route_active@l(r8)
    cmpwi r8, 0
    bne _gz_field_travel_done
    lis r8, _gz_ftravel_pending@ha
    lwz r8, _gz_ftravel_pending@l(r8)
    cmpwi r8, 0
    bne _gz_field_travel_done
    li r3, 1
    bl _gz_field_reconcile
    stw r3, 4(r31)
    cmpwi r3, 0
    bne _gz_field_travel_done
    bl _gz_field_apply
    li r8, 0
    stw r8, 0(r31)
_gz_field_travel_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr

; Owned EUR entries: Execute starts mflr r0; frame setter is a native API.
0x0217F5B0 = b _gz_field_execute_hook
0x0217F5B4 = _gz_field_execute_resume:
0x0217F3F0 = _gz_field_native_set_matrix:
0x0217EBAC = _gz_field_native_init_display:
0x025200D8 = _gz_field_native_get_info:
0x024F08AC = _gz_field_native_acch_correct:
0x02181C4C = _gz_field_native_wait_init:
0x0218214C = _gz_field_native_water_init:
.origin = codecave
_gz_field_execute_hook:
    lis r8, _gz_field_phase@ha
    lwz r8, _gz_field_phase@l(r8)
    cmpwi r8, 3
    beq _gz_field_execute_collect
    cmpwi r8, 0
    bne _gz_field_execute_paused
    lis r8, _gz_world_resume_pending@ha
    lwz r8, _gz_world_resume_pending@l(r8)
    cmpwi r8, 0
    bne _gz_field_execute_paused
    b _gz_field_execute_run
_gz_field_execute_collect:
    lis r8, _gz_field_phase@ha
    lwz r8, _gz_field_phase@l+4(r8)
    lwz r9, 4(r3)
    cmpw r8, r9
    bne _gz_field_execute_paused
_gz_field_execute_run:
    mflr r0
    b _gz_field_execute_resume
_gz_field_execute_paused:
    li r3, 1
    blr
.align 4
.string "WWHDGZ_FIELD_ITEMS_PROBE1"
.align 4
.int _gz_field_phase,_gz_field_travel_pending
_gz_field_phase:
.int 0,0,0,0,0
_gz_field_travel_pending:
.int 0,0

.align 4
_gz_field_fields:
.int 768,20,64
.int 788,20,84
.int 808,6,104
.int 816,24,112
.int 880,12,136
.int 1860,12,148
.int 1872,80,160
.int 0,0,0
_gz_field_float_offsets:
