_gz_debug_join:
    lis r6, _gz_debug_line@ha
    addi r6, r6, _gz_debug_line@l
    mr r8, r6
    li r10, 0
_gz_join_label:
    lbz r9, 0(r3)
    cmpwi r9, 0
    bne _gz_widget_skip238
    b _gz_join_value
_gz_widget_skip238:
    stb r9, 0(r8)
    addi r3, r3, 1
    addi r8, r8, 1
