0x020FA614 = b _gz_boss_owner_hook
0x020FA618 = _gz_boss_owner_resume:
0x0210602C = b _gz_life_child_execute_hook
0x02106030 = _gz_life_child_execute_resume:
0x0240CDD4 = b _gz_life_player_execute_hook
0x0240CDD8 = _gz_life_player_execute_resume:
0x025D57F4 = _gz_life_native_create:
0x025D57A0 = _gz_life_native_delete:
.origin = codecave
_gz_boss_owner_hook:
    stwu r1, -0x10(r1)
    mflr r0
    stw r0, 0x14(r1)
    bl _gz_boss_owner_tick
    lwz r0, 0x14(r1)
    mtlr r0
    addi r1, r1, 0x10
    lis r8, _gz_life_phase@ha
    lwz r8, _gz_life_phase@l(r8)
    cmpwi r8, 0
    bne _gz_life_boss_paused
    lis r8, _gz_world_resume_pending@ha
    lwz r8, _gz_world_resume_pending@l(r8)
    cmpwi r8, 0
    bne _gz_life_boss_paused
    stwu r1, -0x368(r1)
    b _gz_boss_owner_resume
_gz_life_boss_paused:
    li r3, 1
    blr
_gz_life_child_execute_hook:
    lis r8, _gz_life_phase@ha
    lwz r8, _gz_life_phase@l(r8)
    cmpwi r8, 0
    bne _gz_life_child_paused
    lis r8, _gz_world_resume_pending@ha
    lwz r8, _gz_world_resume_pending@l(r8)
    cmpwi r8, 0
    bne _gz_life_child_paused
    stwu r1, -0x2F8(r1)
    b _gz_life_child_execute_resume
_gz_life_child_paused:
    li r3, 1
    blr
_gz_life_player_execute_hook:
    lis r8, _gz_camera_pending@ha
    lwz r8, _gz_camera_pending@l(r8)
    cmpwi r8, 0
    bne _gz_life_player_paused
    lis r8, _gz_life_phase@ha
    lwz r8, _gz_life_phase@l(r8)
    cmpwi r8, 0
    bne _gz_life_player_paused
    stwu r1, -0xF0(r1)
    b _gz_life_player_execute_resume
_gz_life_player_paused:
    li r3, 1
    blr
; r4=profile, r5=PID. Return the live allocation in r3, never an old pointer.
_gz_life_find_actor:
    lis r8, 0x101F
    lwz r8, 0x3328(r8)
    li r9, 4096
_gz_life_find_loop:
    cmpwi r8, 0
    beq _gz_life_find_missing
    addi r9, r9, -1
    cmpwi r9, 0
    beq _gz_life_find_missing
    lwz r3, 12(r8)
    cmpwi r3, 0
    beq _gz_life_find_next
    lhz r10, 8(r3)
    cmpw r10, r4
    bne _gz_life_find_next
    lwz r10, 4(r3)
    cmpw r10, r5
    beqlr
_gz_life_find_next:
    lwz r8, 8(r8)
    b _gz_life_find_loop
_gz_life_find_missing:
    li r3, 0
    blr
 ; Larva reconciliation may change only larva instances. Every other actor
; must remain exactly the captured PID/profile set; queue order is irrelevant.
_gz_life_generic_matches:
    li r3, 218
    b _gz_v104_actor_registry_validate
_gz_life_try_begin:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    lis r8, _gz_inplace_enabled@ha
    lwz r8, _gz_inplace_enabled@l(r8)
    cmpwi r8, 2
    bne _gz_life_not_needed
    lis r8, _gz_life_phase@ha
    lwz r8, _gz_life_phase@l(r8)
    cmpwi r8, 0
    bne _gz_life_wait
    lis r8, _gz_v73_state_valid@ha
    lwz r8, _gz_v73_state_valid@l(r8)
    cmpwi r8, 1
    bne _gz_life_not_needed
    lis r8, _gz_inplace_meta@ha
    lwz r8, _gz_inplace_meta@l(r8)
    cmpwi r8, 1
    bne _gz_life_not_needed
    lis r8, _gz_route_active@ha
    lwz r8, _gz_route_active@l(r8)
    cmpwi r8, 0
    bne _gz_life_not_needed
    lis r8, _gz_world_resume_pending@ha
    lwz r8, _gz_world_resume_pending@l(r8)
    cmpwi r8, 0
    bne _gz_life_not_needed
    bl _gz_live_check
    cmpwi r3, 0
    bne _gz_life_begin_end
    lis r8, 0x1047
    lbz r8, 0x4342(r8)
    cmpwi r8, 0
    bne _gz_life_not_needed
    lis r8, _gz_inplace_meta@ha
    lwz r9, _gz_inplace_meta@l+8(r8)
    lwz r10, 4(r11)
    cmpw r9, r10
    bne _gz_life_not_needed
    ; Use the same validated model/resource/lifetime and procedure checks as
    ; an ordinary in-place restore. An idle-only test is no longer adequate.
    mr r3, r11
    bl _gz_player_preflight
    cmpwi r3, 0
    bne _gz_life_not_needed
    bl _gz_camera_meta_preflight
    cmpwi r3, 0
    bne _gz_life_not_needed
    lis r31, _gz_route_records@ha
    addi r31, r31, _gz_route_records@l
    addi r31, r31, 13600
    lis r8, _gz_stage_store@ha
    addi r8, r8, _gz_stage_store@l
    lwz r9, 0(r8)
    lwz r10, 4(r31)
    cmpw r9, r10
    bne _gz_life_not_needed
    lwz r9, 4(r8)
    lwz r10, 8(r31)
    cmpw r9, r10
    bne _gz_life_not_needed
    lwz r9, 12(r31)
    srwi r9, r9, 8
    andi. r9, r9, 255
    lis r8, _gz_room_store@ha
    lbz r8, _gz_room_store@l(r8)
    cmpw r9, r8
    bne _gz_life_not_needed
    lwz r9, 12(r31)
    andi. r9, r9, 255
    lis r8, _gz_layer_store@ha
    lbz r8, _gz_layer_store@l(r8)
    cmpw r9, r8
    bne _gz_life_not_needed
    lis r8, _gz_larva_count@ha
    addi r8, r8, _gz_larva_count@l
    lwz r9, 4(r8)
    cmpwi r9, 0
    bne _gz_life_not_needed
    lwz r26, 0(r8)
    cmplwi r26, 32
    bgt _gz_life_not_needed
    bl _gz_life_generic_matches
    cmpwi r3, 1
    bne _gz_life_not_needed
    ; Seed the logical slot map from the captured IDs; actor addresses are
    ; resolved from the live queue, never from saved heap pointers.
    lis r27, _gz_larva_records@ha
    addi r27, r27, _gz_larva_records@l
    lis r28, _gz_life_slots@ha
    addi r28, r28, _gz_life_slots@l
    li r29, 0
_gz_life_seed_slot:
    cmpwi r26, 0
    beq _gz_life_seed_done
    lwz r9, 0(r27)
    cmpwi r9, 1
    bne _gz_life_not_needed
    lbz r9, 96(r27)
    cmpwi r9, 0x23
    bne _gz_life_not_needed
    lwz r5, 4(r27)
    stw r5, 0(r28)
    stw r5, 4(r28)
    li r4, 218
    bl _gz_life_find_actor
    stw r3, 8(r28)
    li r9, 0
    stw r9, 12(r28)
    cmpwi r3, 0
    bne _gz_life_seed_present
    li r29, 1
    stw r3, 4(r28)
_gz_life_seed_present:
    addi r27, r27, 1024
    addi r28, r28, 16
    addi r26, r26, -1
    b _gz_life_seed_slot
_gz_life_seed_done:
    ; Detect any post-snapshot births too, including a snapshot with no larvae.
    lis r26, 0x101F
    lwz r26, 0x3328(r26)
    li r30, 4096
_gz_life_extra_scan:
    cmpwi r26, 0
    beq _gz_life_difference_checked
    addi r30, r30, -1
    cmpwi r30, 0
    beq _gz_life_not_needed
    lwz r8, 12(r26)
    cmpwi r8, 0
    beq _gz_life_extra_next
    lhz r9, 8(r8)
    cmpwi r9, 218
    bne _gz_life_extra_next
    lwz r5, 4(r8)
    bl _gz_life_id_is_mapped
    cmpwi r3, 0
    bne _gz_life_extra_next
    li r29, 1
_gz_life_extra_next:
    lwz r26, 8(r26)
