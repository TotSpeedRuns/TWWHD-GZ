# r3 source 0 GamePad, 1..4 Pro channel+1; r4 normalized sample.
# Keep held history per controller. An idle backend cannot overwrite the owner.
_gz_choose_controller:
    lis r8, _gz_controller_state@ha
    addi r8, r8, _gz_controller_state@l
    slwi r9, r3, 2
    addi r10, r8, 16
    lwzx r11, r10, r9
    lwz r12, 0(r4)
