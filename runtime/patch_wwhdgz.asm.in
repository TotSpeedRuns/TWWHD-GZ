.origin = codecave
_gz_world_bokoblin_animation_hook:
    stwu r1, -0x50(r1)
    mflr r0
    stw r0, 0x54(r1)
    stw r3, 8(r1)
    stw r4, 12(r1)
    stw r5, 16(r1)
    stw r6, 20(r1)
    stw r7, 24(r1)
    stw r8, 28(r1)
    stw r9, 32(r1)
    stw r10, 36(r1)
    stw r11, 40(r1)
    stw r12, 44(r1)
