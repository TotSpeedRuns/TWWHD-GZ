0x0242912C = bla _gz_roll_gate_hook
0x0242914C = bla _gz_roll_gate_hook
0x023F14E4 = _gz_roll_native_next_mode:
_gz_roll_gate_hook:
    stwu r1, -0x20(r1)
    mflr r0
    stw r0, 0x24(r1)
    stw r3, 8(r1)
    stw r4, 12(r1)
    bl _gz_roll_gate_before
    lwz r3, 8(r1)
    lwz r4, 12(r1)
    bl _gz_roll_native_next_mode
    stw r3, 16(r1)
    lwz r3, 8(r1)
    bl _gz_roll_gate_after
    lwz r3, 16(r1)
    lwz r0, 0x24(r1)
    mtlr r0
    addi r1, r1, 0x20
    blr
_gz_roll_allowed:
    lis r8, _gz_tools_flags@ha
    lwz r8, _gz_tools_flags@l(r8)
    andi. r8, r8, 4
    beq _gz_roll_not_allowed
    lis r8, _gz_state@ha
    lwz r8, _gz_state@l(r8)
    cmpwi r8, 0
    bne _gz_roll_not_allowed
    li r8, 1
    blr
_gz_roll_not_allowed:
    li r8, 0
    blr
_gz_roll_gate_before:
    stwu r1, -16(r1)
    mflr r0
    stw r0, 20(r1)
    bl _gz_roll_allowed
    cmpwi r8, 0
    beq _gz_roll_gate_before_done
    bl _gz_roll_gate_mark
_gz_roll_gate_before_done:
    lwz r0, 20(r1)
    mtlr r0
    addi r1, r1, 16
    blr
_gz_roll_gate_after:
    stwu r1, -16(r1)
    mflr r0
    stw r0, 20(r1)
    bl _gz_roll_allowed
    cmpwi r8, 0
    beq _gz_roll_gate_after_done
    bl _gz_roll_gate_finish
_gz_roll_gate_after_done:
    lwz r0, 20(r1)
    mtlr r0
    addi r1, r1, 16
    blr
_gz_roll_input_preserved:
    stwu r1, -0x50(r1)
    mflr r0
    stw r0, 0x54(r1)
    .int 0x7C000026
    stw r0, 8(r1)
    stw r3, 12(r1)
    stw r4, 16(r1)
    stw r5, 20(r1)
    stw r6, 24(r1)
    stw r7, 28(r1)
    stw r8, 32(r1)
    stw r9, 36(r1)
    stw r10, 40(r1)
    stw r11, 44(r1)
    stw r12, 48(r1)
    mfctr r0
    stw r0, 52(r1)
    mfxer r0
    stw r0, 56(r1)
    lwz r10, 0(r31)
    bl _gz_roll_input
    lwz r0, 56(r1)
    mtxer r0
    lwz r0, 52(r1)
    mtctr r0
    lwz r3, 12(r1)
    lwz r4, 16(r1)
    lwz r5, 20(r1)
    lwz r6, 24(r1)
    lwz r7, 28(r1)
    lwz r8, 32(r1)
    lwz r9, 36(r1)
    lwz r10, 40(r1)
    lwz r11, 44(r1)
    lwz r12, 48(r1)
    lwz r0, 8(r1)
    .int 0x7C0FF120
    lwz r0, 0x54(r1)
    mtlr r0
    addi r1, r1, 0x50
    blr
_gz_roll_input:
    stwu r1, -16(r1)
    mflr r0
    stw r0, 20(r1)
    lis r8, _gz_roll_state@ha
    addi r8, r8, _gz_roll_state@l
    lwz r9, 32(r8)
    stw r10, 32(r8)
    andc r10, r10, r9
    andi. r10, r10, 0x8000
    beq _gz_roll_input_done
    bl _gz_roll_allowed
    cmpwi r8, 0
    beq _gz_roll_input_done
    bl _gz_live_check
    cmpwi r3, 0
    bne _gz_roll_input_done
    mr r3, r11
    bl _gz_roll_press
_gz_roll_input_done:
    lwz r0, 20(r1)
    mtlr r0
    addi r1, r1, 16
    blr
_gz_roll_update:
    stwu r1, -16(r1)
    mflr r0
    stw r0, 20(r1)
    bl _gz_roll_allowed
    cmpwi r8, 0
    beq _gz_roll_update_cancel
    bl _gz_live_check
    cmpwi r3, 0
    bne _gz_roll_update_cancel
    mr r3, r11
    bl _gz_roll_observe
    b _gz_roll_update_done
_gz_roll_update_cancel:
    bl _gz_roll_cancel
_gz_roll_update_done:
    lwz r0, 20(r1)
    mtlr r0
    addi r1, r1, 16
    blr
_gz_roll_window_delta:
    cmpwi r3, 0
    blelr
    addi r3, r3, -1
    blr
_gz_roll_draw:
    stwu r1, -0x20(r1)
    mflr r0
    stw r0, 0x24(r1)
    stw r31, 0x18(r1)
    bl _gz_roll_feedback_expire
    bl _gz_roll_allowed
    cmpwi r8, 0
    beq _gz_roll_draw_done
    lis r31, _gz_roll_feedback@ha
    addi r31, r31, _gz_roll_feedback@l
    lis r6, _gz_roll_idle@ha
    addi r6, r6, _gz_roll_idle@l
    lis r7, 0xE0E0
    ori r7, r7, 0xE0FF
    lwz r8, 0(r31)
    cmpwi r8, 0
    beq _gz_roll_draw_result
    lwz r3, 4(r31)
    bl _gz_roll_window_delta
    cmpwi r3, 0
    bne _gz_roll_draw_delta
    lwz r8, 12(r31)
    cmpwi r8, 0
    beq _gz_roll_draw_result
    lis r6, _gz_roll_success@ha
    addi r6, r6, _gz_roll_success@l
    lis r7, 0x40FF
    ori r7, r7, 0x70FF
    b _gz_roll_draw_result
_gz_roll_draw_delta:
    lis r8, _gz_roll_late@ha
    addi r8, r8, _gz_roll_late@l
    lis r9, _gz_roll_frame_late@ha
    addi r9, r9, _gz_roll_frame_late@l
    cmpwi r3, 0
    bgt _gz_roll_draw_plural
    neg r3, r3
    lis r8, _gz_roll_early@ha
    addi r8, r8, _gz_roll_early@l
    lis r9, _gz_roll_frame_early@ha
    addi r9, r9, _gz_roll_frame_early@l
_gz_roll_draw_plural:
    cmpwi r3, 1
    bne _gz_roll_draw_count
    mr r8, r9
_gz_roll_draw_count:
    stw r8, 8(r1)
    bl _gz_decimal
    mr r3, r6
    lwz r4, 8(r1)
    bl _gz_debug_join
    lis r7, 0xFF40
    ori r7, r7, 0x40FF
_gz_roll_draw_result:
    li r3, 1
    li r4, 16
    li r5, 548
    bl _gz_font_draw_px
    lis r6, _gz_roll_clip_wait@ha
    addi r6, r6, _gz_roll_clip_wait@l
    li r7, -256
    lwz r8, 8(r31)
    cmpwi r8, 0
    beq _gz_roll_draw_clip
    lis r6, _gz_roll_clip_no@ha
    addi r6, r6, _gz_roll_clip_no@l
    lis r7, 0xFF40
    ori r7, r7, 0x40FF
    cmpwi r8, 2
    bne _gz_roll_draw_clip
    lis r6, _gz_roll_clip_yes@ha
    addi r6, r6, _gz_roll_clip_yes@l
    lis r7, 0x40FF
    ori r7, r7, 0x70FF
_gz_roll_draw_clip:
    li r3, 1
    li r4, 16
    li r5, 574
    bl _gz_font_draw_px
_gz_roll_draw_done:
    lwz r31, 0x18(r1)
    lwz r0, 0x24(r1)
    mtlr r0
    addi r1, r1, 0x20
    blr
.align 4
