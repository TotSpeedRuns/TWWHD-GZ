_gz_ff1_doomzoom_prepare:
    ; Target-specific native sword reveal switch. Preserve r8/r9 queue pointers.
    lwz r10, 4(r9)
    lis r11, 0x4D61
    ori r11, r11, 0x6A79
    cmpw r10, r11
    bnelr
    lwz r10, 8(r9)
    lis r11, 0x7545
    cmpw r10, r11
    bnelr
    lwz r10, 12(r9)
    lis r11, 0x0010
    ori r11, r11, 0x00FF
    cmpw r10, r11
    bnelr
    ; Owned MajyuE item parameter 0x0304FF3D requires switch4 to be visible.
    lis r12, 0x1020
    lwz r12, -0x7B0C(r12)
    addi r12, r12, 0x20
    lwz r10, 0x3CC(r12)
    ori r10, r10, 0x10
    stw r10, 0x3CC(r12)
    ; Same-stage departure commits the current mirror over the persistent bank.
    lis r11, 0x1047
    lwz r10, 0x41E4(r11)
    lis r11, 0x4D61
    ori r11, r11, 0x6A79
    cmpw r10, r11
    bnelr
    lis r11, 0x1047
    lwz r10, 0x41E8(r11)
    lis r11, 0x7545
    cmpw r10, r11
    bnelr
    lwz r10, 0x77C(r12)
    ori r10, r10, 0x10
    stw r10, 0x77C(r12)
    blr

.origin = codecave
_gz_animation_reclaim_stale:
    ; r3 current actor, r4/f1/f2 native setter parameters. No calls or actor writes.
    stwu r1, -0x10(r1)
    stw r6, 8(r1)
    lis r8, _gz_world_bokoblin_animation_observed@ha
    addi r8, r8, _gz_world_bokoblin_animation_observed@l
    li r9, 32
_gz_animation_reclaim_entry:
    lwz r10, 0(r8)
    lis r11, 0x101F
    lwz r11, 0x3328(r11)
    li r12, 4096
_gz_animation_reclaim_live_scan:
    cmpwi r11, 0
    beq _gz_animation_reclaim_free
    cmpwi r12, 0
    beq _gz_animation_reclaim_full
    lwz r6, 12(r11)
    cmpwi r6, 0
    beq _gz_animation_reclaim_next_node
    lwz r0, 4(r6)
    cmpw r0, r10
    beq _gz_animation_reclaim_next_entry
_gz_animation_reclaim_next_node:
    lwz r11, 8(r11)
    addi r12, r12, -1
    b _gz_animation_reclaim_live_scan
_gz_animation_reclaim_next_entry:
    addi r8, r8, 32
    addi r9, r9, -1
    cmpwi r9, 0
    bne _gz_animation_reclaim_entry
    b _gz_animation_reclaim_full
_gz_animation_reclaim_free:
    lwz r6, 8(r1)
    addi r1, r1, 0x10
    b _gz_world_animation_record
_gz_animation_reclaim_full:
    lwz r6, 8(r1)
    addi r1, r1, 0x10
    lis r8, _gz_world_animation_trace_full@ha
    li r9, 1
    stw r9, _gz_world_animation_trace_full@l(r8)
    blr

