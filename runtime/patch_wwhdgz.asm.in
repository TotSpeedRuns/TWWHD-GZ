_gz_widget_skip139:
    lwz r12, 12(r9)
    srwi r12, r12, 8
    andi. r12, r12, 255
    lis r8, _gz_room_store@ha
    addi r8, r8, _gz_room_store@l
    lbz r10, 0(r8)
    cmpw r10, r12
    beq _gz_widget_skip140
    b _gz_route_finish_done
_gz_widget_skip140:
    lwz r12, 12(r9)
    andi. r12, r12, 255
    lis r8, _gz_layer_store@ha
    addi r8, r8, _gz_layer_store@l
    lbz r10, 0(r8)
    cmpw r10, r12
    beq _gz_widget_skip141
