_gz_slot_location_marker:
.string "WWHDGZ_SLOT_LOCATION_V105"
.align 4
.int _gz_slot_origin_current,_gz_slot_origin_captured,_gz_slot_origin_sidecars,_gz_slot_origin_pending,_gz_slot_label_buffers,_gz_slot_detail_buffer

; Draft telemetry only. Nothing in this block is an identity/restore provider.
; All game-object writes are the exact displaced native instructions.
; Table RAM: header64 + requests32*64 + births64*80 + trace64*16 =8256.
0x025C1180 = bl _gz_stone_birth_stage_request_hook
0x025D4D98 = b _gz_stone_birth_create_hook
0x0249B574 = b _gz_stone_birth_rng_hook
0x025D4B68 = b _gz_stone_birth_retire_hook
0x025E1468 = _gz_stone_birth_native_request:
0x025D4D9C = _gz_stone_birth_create_resume:
0x0249B578 = _gz_stone_birth_rng_resume:
0x025D4B6C = _gz_stone_birth_retire_resume:

.origin = codecave

_gz_stone_birth_create_hook:
    stwu r1, -0xA0(r1)
    stmw r0, 8(r1)
    mflr r0
    stw r0, 0x88(r1)
    .int 0x7C000026 ; mfcr r0
    stw r0, 0x8C(r1)
    .int 0x7C0902A6 ; mfctr r0
    stw r0, 0x90(r1)
    .int 0x7C0102A6 ; mfxer r0
    stw r0, 0x94(r1)
    mr r3, r31
    bl _gz_stone_birth_create
    lwz r0, 0x88(r1)
    mtlr r0
    lwz r0, 0x8C(r1)
    .int 0x7C0FF120 ; mtcrf 255, r0
    lwz r0, 0x90(r1)
    mtctr r0
    lwz r0, 0x94(r1)
    .int 0x7C0103A6 ; mtxer r0
    lmw r2, 16(r1)
    lwz r0, 8(r1)
    addi r1, r1, 0xA0
    lwz r12, 0x2EC(r31)
    b _gz_stone_birth_create_resume

_gz_stone_birth_rng_hook:
    stwu r1, -0xA0(r1)
    stmw r0, 8(r1)
    mflr r0
    stw r0, 0x88(r1)
    .int 0x7C000026 ; mfcr r0
    stw r0, 0x8C(r1)
    .int 0x7C0902A6 ; mfctr r0
    stw r0, 0x90(r1)
    .int 0x7C0102A6 ; mfxer r0
    stw r0, 0x94(r1)
    mr r3, r30
    bl _gz_stone_birth_rng
    lwz r0, 0x88(r1)
    mtlr r0
    lwz r0, 0x8C(r1)
    .int 0x7C0FF120 ; mtcrf 255, r0
    lwz r0, 0x90(r1)
    mtctr r0
    lwz r0, 0x94(r1)
    .int 0x7C0103A6 ; mtxer r0
    lmw r2, 16(r1)
    lwz r0, 8(r1)
    addi r1, r1, 0xA0
    lha r10, 0x2FA(r30)
    b _gz_stone_birth_rng_resume

_gz_stone_birth_retire_hook:
    stwu r1, -0xA0(r1)
    stmw r0, 8(r1)
    mflr r0
    stw r0, 0x88(r1)
    .int 0x7C000026 ; mfcr r0
    stw r0, 0x8C(r1)
    .int 0x7C0902A6 ; mfctr r0
    stw r0, 0x90(r1)
    .int 0x7C0102A6 ; mfxer r0
    stw r0, 0x94(r1)
    mr r3, r31
    bl _gz_stone_birth_retire
    lwz r0, 0x88(r1)
    mtlr r0
    lwz r0, 0x8C(r1)
    .int 0x7C0FF120 ; mtcrf 255, r0
    lwz r0, 0x90(r1)
    mtctr r0
    lwz r0, 0x94(r1)
    .int 0x7C0103A6 ; mtxer r0
    lmw r2, 16(r1)
    lwz r0, 8(r1)
    addi r1, r1, 0xA0
    lbz r0, 0x3AA(r31)
    b _gz_stone_birth_retire_resume

; Original bl's LR is the native call-site return address. The native request
; executes first, then its complete integer return context is saved for tracing.
_gz_stone_birth_stage_request_hook:
    stwu r1, -0xD0(r1)
    stw r0, 8(r1)
    mflr r0
    stw r0, 0xC4(r1)
    lwz r0, 8(r1)
    bl _gz_stone_birth_native_request
    stmw r0, 8(r1)
    .int 0x7C000026 ; mfcr r0
    stw r0, 0x8C(r1)
    .int 0x7C0902A6 ; mfctr r0
    stw r0, 0x90(r1)
    .int 0x7C0102A6 ; mfxer r0
    stw r0, 0x94(r1)
    mr r4, r30
    mr r5, r31
    bl _gz_stone_birth_stage_request
    lwz r0, 0x8C(r1)
    .int 0x7C0FF120 ; mtcrf 255, r0
    lwz r0, 0x90(r1)
    mtctr r0
    lwz r0, 0x94(r1)
    .int 0x7C0103A6 ; mtxer r0
    lwz r0, 0xC4(r1)
    mtlr r0
    lmw r2, 16(r1)
    lwz r0, 8(r1)
    addi r1, r1, 0xD0
    blr

; Integer-only leaf byte helpers; no imports, allocations or floating registers.
_gz_stone_birth_copy:
    cmpwi r5, 0
    beqlr
_gz_stone_birth_copy_loop:
    lbz r6, 0(r4)
    stb r6, 0(r3)
    addi r3, r3, 1
    addi r4, r4, 1
    addi r5, r5, -1
    cmpwi r5, 0
    bne _gz_stone_birth_copy_loop
    blr
_gz_stone_birth_equal:
    cmpwi r5, 0
    beq _gz_stone_birth_equal_yes
_gz_stone_birth_equal_loop:
    lbz r6, 0(r3)
    lbz r7, 0(r4)
    cmpw r6, r7
    bne _gz_stone_birth_equal_no
    addi r3, r3, 1
    addi r4, r4, 1
    addi r5, r5, -1
    cmpwi r5, 0
    bne _gz_stone_birth_equal_loop
_gz_stone_birth_equal_yes:
    li r3, 1
    blr
_gz_stone_birth_equal_no:
    li r3, 0
    blr
_gz_stone_birth_error:
    lis r8, _gz_stone_birth_header@ha
    addi r8, r8, _gz_stone_birth_header@l
    lwz r9, 16(r8)
    or r9, r9, r3
    stw r9, 16(r8)
    li r9, 1
    stw r9, 60(r8)
    blr

; Normal ABI, called from the already-wrapped native scene phase_1.
_gz_stone_birth_new_epoch:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    lis r31, _gz_stone_birth_header@ha
    addi r31, r31, _gz_stone_birth_header@l
    lwz r8, 0(r31)
    lis r9, 0x5342
    ori r9, r9, 0x5031
    cmpw r8, r9
    beq _gz_stone_birth_epoch_existing
    cmpwi r8, 0
    bne _gz_stone_birth_epoch_corrupt
    mr r8, r31
    li r9, 2064
    li r10, 0
_gz_stone_birth_init_zero:
    stw r10, 0(r8)
    addi r8, r8, 4
    addi r9, r9, -1
    cmpwi r9, 0
    bne _gz_stone_birth_init_zero
    lis r8, 0x5342
    ori r8, r8, 0x5031
    stw r8, 0(r31)
    li r8, 1
    stw r8, 4(r31)
_gz_stone_birth_epoch_existing:
    lwz r8, 4(r31)
    cmpwi r8, 1
    bne _gz_stone_birth_epoch_corrupt
    lwz r8, 16(r31)
    andi. r8, r8, 4
    bne _gz_stone_birth_epoch_overflow
    lwz r8, 8(r31)
    lis r9, 0x00FF
    ori r9, r9, 0xFFFF
    cmplw r8, r9
    bge _gz_stone_birth_epoch_overflow
    addi r8, r8, 1
    stw r8, 8(r31)
    b _gz_stone_birth_epoch_clear
_gz_stone_birth_epoch_overflow:
    li r8, 0
    stw r8, 8(r31)
    li r3, 4
    bl _gz_stone_birth_error
    b _gz_stone_birth_epoch_clear
_gz_stone_birth_epoch_corrupt:
    li r8, 0
    stw r8, 8(r31)
    li r3, 128
    bl _gz_stone_birth_error
_gz_stone_birth_epoch_clear:
    lis r8, _gz_stone_birth_pending@ha
    addi r8, r8, _gz_stone_birth_pending@l
    li r9, 1792
    li r10, 0
_gz_stone_birth_epoch_clear_loop:
    stw r10, 0(r8)
    addi r8, r8, 4
    addi r9, r9, -1
    cmpwi r9, 0
    bne _gz_stone_birth_epoch_clear_loop
    li r3, 1
    li r4, 0
    li r5, 0
    bl _gz_stone_birth_trace
_gz_stone_birth_epoch_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr

; r3 event,r4 process ID,r5 actor audit pointer. Saturation never alters game.
_gz_stone_birth_trace:
    lis r8, _gz_stone_birth_header@ha
    addi r8, r8, _gz_stone_birth_header@l
    stw r3, 48(r8)
    stw r4, 52(r8)
    stw r5, 56(r8)
    lwz r9, 44(r8)
    cmplwi r9, 64
    bge _gz_stone_birth_trace_full
    lis r10, _gz_stone_birth_events@ha
    addi r10, r10, _gz_stone_birth_events@l
    mulli r11, r9, 16
    add r10, r10, r11
    stw r3, 0(r10)
    stw r4, 4(r10)
    stw r5, 8(r10)
    lwz r11, 8(r8)
    stw r11, 12(r10)
    addi r9, r9, 1
    stw r9, 44(r8)
    blr
_gz_stone_birth_trace_full:
    lwz r9, 16(r8)
    ori r9, r9, 32
    stw r9, 16(r8)
    li r9, 1
    stw r9, 60(r8)
    blr

; r3 returned PID,r4 original append pointer,r5 verified stage-request profile.
_gz_stone_birth_stage_request:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    mr r30, r3
    mr r29, r4
    cmpwi r5, 454
    bne _gz_stone_birth_request_done
    cmpwi r30, -1
    beq _gz_stone_birth_request_done
    lis r8, 0x1000
    cmplw r29, r8
    blt _gz_stone_birth_request_done
    lis r8, 0xBFFF
    cmplw r29, r8
    bge _gz_stone_birth_request_done
    lis r31, _gz_stone_birth_header@ha
    addi r31, r31, _gz_stone_birth_header@l
    lwz r8, 8(r31)
    cmpwi r8, 0
    beq _gz_stone_birth_request_done
    lis r27, _gz_stone_birth_pending@ha
    addi r27, r27, _gz_stone_birth_pending@l
    li r26, 32
    li r28, 0
_gz_stone_birth_request_scan:
    lwz r8, 0(r27)
    cmpwi r8, 0
    beq _gz_stone_birth_request_free
    lwz r8, 4(r27)
    cmpw r8, r30
    beq _gz_stone_birth_request_collision
    lwz r8, 8(r27)
    cmpw r8, r29
    bne _gz_stone_birth_request_next
_gz_stone_birth_request_collision:
    li r8, 0
    stw r8, 0(r27)
    lwz r8, 36(r31)
    addi r8, r8, 1
    stw r8, 36(r31)
_gz_stone_birth_request_free:
    cmpwi r28, 0
    bne _gz_stone_birth_request_next
    mr r28, r27
_gz_stone_birth_request_next:
    addi r27, r27, 64
    addi r26, r26, -1
    cmpwi r26, 0
    bne _gz_stone_birth_request_scan
    cmpwi r28, 0
    bne _gz_stone_birth_request_write
    li r3, 1
    bl _gz_stone_birth_error
    b _gz_stone_birth_request_done
_gz_stone_birth_request_write:
    stw r30, 4(r28)
    stw r29, 8(r28)
    lwz r8, 8(r31)
    stw r8, 12(r28)
    lwz r8, 0(r29)
    stw r8, 16(r28)
    lwz r8, 0x1C(r29)
    stw r8, 20(r28)
