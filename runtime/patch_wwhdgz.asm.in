.origin = codecave
; Snapshot-local identity metadata. Audit pointers are never replayed.
; Header32, rows40, capacity512; fits unused typed-component bank tail.
_gz_identity_base:
    lis r8, _gz_bflower_saved@ha
    lwz r3, _gz_bflower_saved@l(r8)
    cmpwi r3, 0
    beqlr
    lis r8, 4
    ori r8, r8, 42496
    add r3, r3, r8
    blr

_gz_identity_capture:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    mr r31, r3
    li r8, 0
    stw r8, 0(r31)
    stw r8, 4(r31)
    stw r8, 12(r31)
    li r8, 2
    stw r8, 8(r31)
    lis r8, _gz_stage_store@ha
    addi r8, r8, _gz_stage_store@l
    lwz r9, 0(r8)
    stw r9, 16(r31)
    lwz r9, 4(r8)
    stw r9, 20(r31)
    lis r8, _gz_room_store@ha
    lbz r9, _gz_room_store@l(r8)
    stw r9, 24(r31)
    lis r8, _gz_layer_store@ha
    lbz r9, _gz_layer_store@l(r8)
    stw r9, 28(r31)
    lis r8, 0x101F
    lwz r30, 0x3328(r8)
    li r29, 4096
    li r28, 0
    addi r27, r31, 32
_gz_identity_capture_node:
    cmpwi r30, 0
    beq _gz_identity_capture_end
    addi r29, r29, -1
    cmpwi r29, 0
    beq _gz_identity_capture_bad
    lwz r26, 12(r30)
    cmpwi r26, 0
    beq _gz_identity_capture_next
    cmplwi r28, 512
    bge _gz_identity_capture_bad
    lis r8, 0x1000
    cmplw r26, r8
    blt _gz_identity_capture_bad
    lis r8, 0xBFFF
    cmplw r26, r8
    bge _gz_identity_capture_bad
    lwz r8, 4(r26)
    stw r8, 0(r27)
    lhz r8, 8(r26)
    sth r8, 4(r27)
    lhz r8, 0x2D8(r26)
    sth r8, 6(r27)
    lwz r8, 0xB0(r26)
    stw r8, 8(r27)
    lwz r8, 0x2E8(r26)
    stw r8, 12(r27)
    addi r3, r27, 16
    addi r4, r26, 0x2EC
    li r5, 20
    bl _gz_player_copy_bytes
    stw r26, 36(r27)
    addi r27, r27, 40
    addi r28, r28, 1
_gz_identity_capture_next:
    lwz r30, 8(r30)
    b _gz_identity_capture_node
_gz_identity_capture_end:
    stw r28, 4(r31)
    lis r8, 0x4944
    ori r8, r8, 0x4731
    stw r8, 0(r31)
    mr r3, r31
    bl _gz_identity_edges_capture
    cmpwi r3, 0
    bne _gz_identity_capture_bad
    mr r3, r31
    bl _gz_identity_record_safe
    cmpwi r3, 0
    beq _gz_identity_capture_done
_gz_identity_capture_bad:
    li r8, 0
    stw r8, 0(r31)
    li r3, 23
_gz_identity_capture_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr

; Archive installation requires preservation of all volatile scan registers.
_gz_identity_record_safe:
    stwu r1, -0xA0(r1)
    mflr r0
    stw r0, 0xA4(r1)
    stmw r6, 0x38(r1)
    mr r31, r3
    lwz r8, 0(r31)
    cmpwi r8, 0
    beq _gz_identity_record_ok
    lis r9, 0x4944
    ori r9, r9, 0x4731
    cmpw r8, r9
    bne _gz_identity_record_bad
    lwz r30, 4(r31)
    cmplwi r30, 512
    bgt _gz_identity_record_bad
    lwz r8, 8(r31)
    cmpwi r8, 1
    beq _gz_identity_record_legacy
    cmpwi r8, 2
    bne _gz_identity_record_bad
    lwz r8, 12(r31)
    cmplwi r8, 208
    bgt _gz_identity_record_bad
    b _gz_identity_record_header
_gz_identity_record_legacy:
    lwz r8, 12(r31)
    cmpwi r8, 0
    bne _gz_identity_record_bad
_gz_identity_record_header:
    lwz r8, 24(r31)
    cmplwi r8, 255
    bgt _gz_identity_record_bad
    lwz r8, 28(r31)
    cmplwi r8, 255
    bgt _gz_identity_record_bad
    addi r29, r31, 32
    li r28, 0
_gz_identity_record_row:
    cmpw r28, r30
    beq _gz_identity_record_edges
    lhz r8, 4(r29)
    cmplwi r8, 483
    bgt _gz_identity_record_bad
    lwz r8, 0(r29)
    cmpwi r8, -1
    beq _gz_identity_record_bad
    addi r27, r31, 32
    li r26, 0
_gz_identity_record_unique:
    cmpw r26, r28
    beq _gz_identity_record_floats
    lwz r9, 0(r27)
    cmpw r8, r9
    beq _gz_identity_record_bad
    addi r26, r26, 1
    addi r27, r27, 40
    b _gz_identity_record_unique
_gz_identity_record_floats:
    addi r27, r29, 16
    li r26, 3
_gz_identity_record_float:
    lwz r8, 0(r27)
    rlwinm r8, r8, 0, 1, 8
    lis r9, 0x7F80
    cmpw r8, r9
    beq _gz_identity_record_bad
    addi r27, r27, 4
    addi r26, r26, -1
    cmpwi r26, 0
    bne _gz_identity_record_float
    addi r29, r29, 40
    addi r28, r28, 1
    b _gz_identity_record_row
_gz_identity_record_edges:
    mr r3, r31
    bl _gz_identity_edges_safe
    cmpwi r3, 0
    bne _gz_identity_record_bad
_gz_identity_record_ok:
    li r3, 0
    b _gz_identity_record_done
_gz_identity_record_bad:
    li r3, 28
_gz_identity_record_done:
    lmw r6, 0x38(r1)
    lwz r0, 0xA4(r1)
    mtlr r0
    addi r1, r1, 0xA0
    blr

; r3=validated graph, r4=saved PID; return row or0. No game writes.
_gz_identity_row:
    lwz r8, 4(r3)
    cmplwi r8, 512
    bgt _gz_identity_row_missing
    addi r3, r3, 32
_gz_identity_row_loop:
    cmpwi r8, 0
    beq _gz_identity_row_missing
    lwz r9, 0(r3)
    cmpw r9, r4
    beqlr
    addi r3, r3, 40
    addi r8, r8, -1
    b _gz_identity_row_loop
_gz_identity_row_missing:
    li r3, 0
    blr

; r3=graph,r4=saved PID,r5=depth(initial0). r3=current actor or0.
; r4 reason:0 exact PID,1 verified rebound,2 missing,3 ambiguous,
; 4 invalid/stage mismatch,5 unresolved/cyclic parent or owner. Depth<=16.
_gz_identity_resolve:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    mr r31, r3
    mr r26, r5
    stw r3, 24(r1)
    stw r5, 16(r1)
    cmplwi r26, 16
    bge _gz_identity_resolve_parent_bad
    stw r4, 20(r1)
    cmpwi r26, 0
    bne _gz_identity_resolve_validated
    bl _gz_identity_record_safe
    cmpwi r3, 0
    bne _gz_identity_resolve_bad
_gz_identity_resolve_validated:
    lwz r8, 0(r31)
    lis r9, 0x4944
    ori r9, r9, 0x4731
    cmpw r8, r9
    bne _gz_identity_resolve_bad
    lis r8, _gz_stage_store@ha
    addi r8, r8, _gz_stage_store@l
    lwz r9, 0(r8)
    lwz r10, 16(r31)
    cmpw r9, r10
    bne _gz_identity_resolve_bad
    lwz r9, 4(r8)
    lwz r10, 20(r31)
    cmpw r9, r10
    bne _gz_identity_resolve_bad
    lis r8, _gz_room_store@ha
    lbz r9, _gz_room_store@l(r8)
    lwz r10, 24(r31)
    cmpw r9, r10
    bne _gz_identity_resolve_bad
    lis r8, _gz_layer_store@ha
    lbz r9, _gz_layer_store@l(r8)
    lwz r10, 28(r31)
    cmpw r9, r10
    bne _gz_identity_resolve_bad
    mr r3, r31
    lwz r4, 20(r1)
    bl _gz_identity_row
    mr r30, r3
    cmpwi r30, 0
    beq _gz_identity_resolve_missing
    lwz r29, 12(r30)
    cmpwi r29, -1
    beq _gz_identity_resolve_scan
    cmpwi r29, 0
    beq _gz_identity_resolve_scan
    mr r3, r31
    mr r4, r29
    addi r5, r26, 1
    bl _gz_identity_resolve
    cmpwi r3, 0
    beq _gz_identity_resolve_parent_bad
    lwz r29, 4(r3)
_gz_identity_resolve_scan:
    li r26, 0
    lis r8, 0x101F
    lwz r28, 0x3328(r8)
    li r27, 4096
_gz_identity_resolve_node:
    cmpwi r28, 0
    beq _gz_identity_resolve_end
    addi r27, r27, -1
    cmpwi r27, 0
    beq _gz_identity_resolve_bad
    lwz r31, 12(r28)
    cmpwi r31, 0
    beq _gz_identity_resolve_next
    lhz r8, 8(r31)
    lhz r9, 4(r30)
    cmpw r8, r9
    bne _gz_identity_resolve_next
    lhz r8, 0x2D8(r31)
    lhz r9, 6(r30)
    cmpw r8, r9
    bne _gz_identity_resolve_next
    lwz r8, 0xB0(r31)
    lwz r9, 8(r30)
    cmpw r8, r9
    bne _gz_identity_resolve_next
    lwz r8, 0x2E8(r31)
    cmpw r8, r29
    bne _gz_identity_resolve_next
    addi r8, r31, 0x2EC
    addi r9, r30, 16
    li r10, 19
_gz_identity_resolve_home:
    lbz r11, 0(r8)
    lbz r12, 0(r9)
    cmpw r11, r12
    bne _gz_identity_resolve_next
    addi r8, r8, 1
    addi r9, r9, 1
    addi r10, r10, -1
    cmpwi r10, 0
    bne _gz_identity_resolve_home
    lwz r8, 4(r31)
    lwz r9, 0(r30)
    cmpw r8, r9
    beq _gz_identity_resolve_exact
    cmpwi r26, 0
    beq _gz_identity_resolve_first
    li r26, -1
    b _gz_identity_resolve_next
_gz_identity_resolve_first:
    mr r26, r31
_gz_identity_resolve_next:
    lwz r28, 8(r28)
    b _gz_identity_resolve_node
_gz_identity_resolve_exact:
    mr r3, r31
    li r4, 0
    b _gz_identity_resolve_done
_gz_identity_resolve_end:
    lwz r3, 24(r1)
    lwz r4, 20(r1)
    lwz r5, 16(r1)
    addi r5, r5, 1
    mr r6, r29
    bl _gz_identity_owner_resolve
    cmpwi r4, 0
    beq _gz_identity_resolve_unowned
    cmpwi r3, 0
    beq _gz_identity_resolve_parent_bad
    li r4, 1
    b _gz_identity_resolve_done
_gz_identity_resolve_unowned:
    cmpwi r26, -1
    beq _gz_identity_resolve_ambiguous
    mr r3, r26
    li r4, 1
    cmpwi r3, 0
    bne _gz_identity_resolve_done
_gz_identity_resolve_missing:
    li r4, 2
    b _gz_identity_resolve_zero
_gz_identity_resolve_ambiguous:
    li r4, 3
    b _gz_identity_resolve_zero
_gz_identity_resolve_bad:
    li r4, 4
    b _gz_identity_resolve_zero
_gz_identity_resolve_parent_bad:
    li r4, 5
_gz_identity_resolve_zero:
    li r3, 0
_gz_identity_resolve_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr

.origin = codecave

; Optional positive shared match. Existing lifecycle matching remains the
; fallback for legacy metadata and freshly constructed replacement actors.
_gz_identity_field_match:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
