    lis r6, _gz_inplace_enabled@ha
    lwz r6, _gz_inplace_enabled@l(r6)
    cmpwi r6, 0
    beq _gz_world_animation_capture_blending
_gz_mca_blend_allowed:
    ; B0 must be exactly native completed blend weight 1.0. The prior
    ; blended joint pose is not yet reconstructed, so refuse that capture.
    lwz r6, 4(r3)
    lis r7, _gz_world_bokoblin_animation_observed@ha
    addi r7, r7, _gz_world_bokoblin_animation_observed@l
    li r8, 32
_gz_world_animation_capture_find:
    lwz r9, 0(r7)
    cmpw r9, r6
    beq _gz_world_animation_capture_found
    addi r7, r7, 32
    addi r8, r8, -1
    cmpwi r8, 0
    bne _gz_world_animation_capture_find
    ; A native hiding enemy may never call the later setter. Only its
    ; verified untouched constructor state can use the constructor assets.
    lis r8, _gz_world_animation_trace_full@ha
    lwz r8, _gz_world_animation_trace_full@l(r8)
    cmpwi r8, 0
    bne _gz_world_animation_capture_bad
    lhz r8, 0x4A0(r3)
    cmpwi r8, 0
    bne _gz_world_animation_capture_bad
    lhz r8, 0x4A2(r3)
    cmpwi r8, 15
    bne _gz_world_animation_capture_bad
    lbz r8, 0x3D0(r3)
    cmpwi r8, 2
    beq _gz_world_animation_capture_constructor
    cmpwi r8, 3
    bne _gz_world_animation_capture_bad
_gz_world_animation_capture_constructor:
    li r8, 74
    sth r8, 98(r4)
    li r8, 33
    sth r8, 100(r4)
    li r8, 2
    stb r8, 102(r4)
    li r8, 0
    stb r8, 103(r4)
    addi r8, r4, 104
    b _gz_world_animation_capture_controller_start
_gz_world_animation_capture_found:
    lhz r9, 0x4A2(r3)
    cmpwi r9, 19
    bne _gz_world_animation_capture_allowed
    lwz r9, 8(r7)
    cmpwi r9, 70
    beq _gz_world_animation_capture_allowed
    cmpwi r9, 71
    bne _gz_world_animation_capture_bad
_gz_world_animation_capture_allowed:
    lwz r9, 8(r7)
    cmpwi r9, 0
    ble _gz_world_animation_capture_bad
    cmplwi r9, 65535
    bgt _gz_world_animation_capture_bad
    sth r9, 98(r4)
    lwz r9, 16(r7)
    cmpwi r9, -32768
    blt _gz_world_animation_capture_bad
    cmpwi r9, 32767
    bgt _gz_world_animation_capture_bad
    sth r9, 100(r4)
    lwz r9, 12(r7)
    cmpwi r9, -128
    blt _gz_world_animation_capture_bad
    cmpwi r9, 127
    bgt _gz_world_animation_capture_bad
    stb r9, 102(r4)
    li r9, 0
    stb r9, 103(r4)
    addi r8, r4, 104
_gz_world_animation_capture_controller_start:
    addi r5, r5, 0x98
    li r10, 16
_gz_world_animation_capture_controller:
    lbz r9, 0(r5)
    stb r9, 0(r8)
    addi r5, r5, 1
    addi r8, r8, 1
    addi r10, r10, -1
    cmpwi r10, 0
    bne _gz_world_animation_capture_controller
    ; Native signed countdown: constructor initializes +0x426, execute decrements it.
    lhz r9, 0xCD8(r3)
    sth r9, 120(r4)
    lbz r9, 0xCDA(r3)
    stb r9, 122(r4)
    lhz r9, 0x426(r3)
    sth r9, 124(r4)
    ; Include the native completion/wrap flags at +0xA7; stop before resource pointer +0xA8.
    li r3, 0
    blr
_gz_world_animation_capture_bad:
    li r3, 18
    blr
_gz_world_animation_capture_blending:
    li r3, 17
    blr
_gz_world_apply_enemy_animation:
    stwu r1, -0x20(r1)
    mflr r0
    stw r0, 0x24(r1)
    stw r3, 8(r1)
    stw r4, 12(r1)
    lwz r8, 0x3D8(r3)
    cmpwi r8, 0
    beq _gz_world_animation_apply_bad
    mr r7, r4
    lhz r4, 98(r7)
    lbz r5, 102(r7)
    extsb r5, r5
    lha r6, 100(r7)
    ; Stable saved poses have completed blending. Native zero-blend sets
    ; fresh weights to 1 instead of blending from the new actor's old pose.
    lis r8, _gz_world_animation_zero@ha
    lfs f1, _gz_world_animation_zero@l(r8)
    lfs f2, 104(r7)
    bl _gz_world_bokoblin_animation_native
    lwz r3, 8(r1)
