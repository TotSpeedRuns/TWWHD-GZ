_gz_dry_storage_name:
.string "Dry Storage"
.align 4
_gz_wind_waker_dive_init:
    lis r5, _gz_tools_flags@ha
    lwz r5, _gz_tools_flags@l(r5)
    andi. r5, r5, 1024
    li r5, -30
    beq _gz_wind_waker_dive_store
    cmpwi r31, -1
    bne _gz_wind_waker_dive_store
    li r5, -1
_gz_wind_waker_dive_store:
    sth r5, 0x6918(r29)
    b _gz_wind_waker_dive_continue
