    cmpwi r3, 0
    bne _gz_identity_field_none
    lwz r8, 0(r31)
    lis r9, 0x4944
    ori r9, r9, 0x4731
    cmpw r8, r9
    bne _gz_identity_field_none
    mr r3, r31
    lwz r4, 0(r30)
    bl _gz_identity_row
    cmpwi r3, 0
    beq _gz_identity_field_none
    lhz r8, 4(r3)
    cmpwi r8, 255
    bne _gz_identity_field_none
    lwz r8, 8(r3)
    lwz r9, 8(r30)
    cmpw r8, r9
    bne _gz_identity_field_none
    addi r8, r3, 16
    addi r9, r30, 16
    li r10, 19
_gz_identity_field_home:
    lbz r11, 0(r8)
    lbz r12, 0(r9)
    cmpw r11, r12
    bne _gz_identity_field_none
    addi r8, r8, 1
    addi r9, r9, 1
    addi r10, r10, -1
    cmpwi r10, 0
    bne _gz_identity_field_home
    mr r3, r31
    lwz r4, 0(r30)
    li r5, 0
    bl _gz_identity_resolve
    b _gz_identity_field_done
_gz_identity_field_none:
    li r3, 0
_gz_identity_field_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr

.origin = codecave
; Verified owner edges: format2, graph+20512, 208 rows of12 bytes.
; Kinds1..4 identify exact native process-ID fields, never raw pointers.
; Bokoblin189 +1360, container453 slots +8BC/+8D8/+8F4 -> weapon463.
; Captured actor pointers are read only during synchronous graph construction.
_gz_identity_edges_capture:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    mr r31, r3
    lwz r30, 4(r31)
    addi r29, r31, 32
    addi r28, r31, 20512
    li r27, 0
_gz_identity_edges_capture_row:
    cmpwi r30, 0
    beq _gz_identity_edges_capture_ok
    li r26, 1
_gz_identity_edges_capture_kind:
    mr r3, r26
    bl _gz_identity_edge_descriptor
    lhz r8, 4(r29)
    cmpw r8, r4
    bne _gz_identity_edges_capture_next_kind
    lwz r8, 36(r29)
    lwzx r4, r8, r3
    cmpwi r4, 0
    beq _gz_identity_edges_capture_next_kind
    cmpwi r4, -1
    beq _gz_identity_edges_capture_next_kind
    mr r3, r31
    bl _gz_identity_row
    cmpwi r3, 0
    beq _gz_identity_edges_capture_next_kind
    lhz r8, 4(r3)
    cmpwi r8, 463
    bne _gz_identity_edges_capture_next_kind
    cmplwi r27, 208
    bge _gz_identity_edges_capture_bad
    lwz r8, 0(r3)
    stw r8, 4(r28)
    lwz r8, 0(r29)
    stw r8, 0(r28)
    stw r26, 8(r28)
    addi r28, r28, 12
    addi r27, r27, 1
_gz_identity_edges_capture_next_kind:
    addi r26, r26, 1
    cmpwi r26, 4
    ble _gz_identity_edges_capture_kind
    addi r29, r29, 40
    addi r30, r30, -1
    b _gz_identity_edges_capture_row
_gz_identity_edges_capture_ok:
    stw r27, 12(r31)
    li r3, 0
    b _gz_identity_edges_capture_done
_gz_identity_edges_capture_bad:
    li r3, 23
_gz_identity_edges_capture_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr

; Called only after all graph rows are validated, before archive commit.
_gz_identity_edges_safe:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    mr r31, r3
    lwz r8, 8(r31)
    cmpwi r8, 1
    beq _gz_identity_edges_safe_ok
    lwz r30, 12(r31)
    addi r29, r31, 20512
    li r28, 0
_gz_identity_edges_safe_row:
    cmpw r28, r30
    beq _gz_identity_edges_safe_ok
    lwz r8, 8(r29)
    mr r3, r8
    bl _gz_identity_edge_descriptor
    cmpwi r3, 0
    beq _gz_identity_edges_safe_bad
    stw r4, 16(r1)
    mr r3, r31
    lwz r4, 0(r29)
    bl _gz_identity_row
    cmpwi r3, 0
    beq _gz_identity_edges_safe_bad
    lhz r8, 4(r3)
    lwz r9, 16(r1)
    cmpw r8, r9
    bne _gz_identity_edges_safe_bad
    mr r3, r31
    lwz r4, 4(r29)
    bl _gz_identity_row
    cmpwi r3, 0
    beq _gz_identity_edges_safe_bad
    lhz r8, 4(r3)
    cmpwi r8, 463
    bne _gz_identity_edges_safe_bad
    addi r27, r31, 20512
    li r26, 0
_gz_identity_edges_safe_unique:
    cmpw r26, r28
    beq _gz_identity_edges_safe_next
    lwz r8, 0(r27)
    lwz r9, 0(r29)
    cmpw r8, r9
    bne _gz_identity_edges_safe_unique_next
    lwz r8, 8(r27)
    lwz r9, 8(r29)
    cmpw r8, r9
    beq _gz_identity_edges_safe_bad
_gz_identity_edges_safe_unique_next:
    addi r27, r27, 12
    addi r26, r26, 1
    b _gz_identity_edges_safe_unique
_gz_identity_edges_safe_next:
    addi r29, r29, 12
    addi r28, r28, 1
    b _gz_identity_edges_safe_row
_gz_identity_edges_safe_ok:
    li r3, 0
    b _gz_identity_edges_safe_done
_gz_identity_edges_safe_bad:
    li r3, 28
_gz_identity_edges_safe_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr

; Every changed-PID fallback must honor any recorded incoming owner edges.
; r3 validated graph, r4 saved targetPID, r5 depth, r6 resolved parentPID.
; Requires every saved owner edge to point at the same current matching actor.
; r4 result:0 no recorded incoming edge,1 resolved,5 unresolved/conflicting.
; No pointers or IDs are written to game objects or snapshots.
_gz_identity_owner_resolve:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    mr r31, r3
    stw r4, 16(r1)
    stw r5, 20(r1)
    stw r6, 24(r1)
    lwz r8, 8(r31)
    cmpwi r8, 2
    bne _gz_identity_owner_none
    bl _gz_identity_row
    mr r30, r3
    cmpwi r30, 0
    beq _gz_identity_owner_bad
    lwz r29, 12(r31)
    addi r28, r31, 20512
    li r27, 0
_gz_identity_owner_edge:
    cmpwi r29, 0
    beq _gz_identity_owner_end
    lwz r8, 4(r28)
    lwz r9, 16(r1)
    cmpw r8, r9
    bne _gz_identity_owner_next
    lwz r3, 8(r28)
    bl _gz_identity_edge_descriptor
    cmpwi r3, 0
    beq _gz_identity_owner_bad
    stw r3, 28(r1)
    mr r3, r31
    lwz r4, 0(r28)
    lwz r5, 20(r1)
    bl _gz_identity_resolve
    cmpwi r3, 0
    beq _gz_identity_owner_bad
    lwz r8, 28(r1)
    lwzx r4, r3, r8
    cmpwi r4, 0
    beq _gz_identity_owner_bad
    cmpwi r4, -1
    beq _gz_identity_owner_bad
    lis r8, 0x101F
    lwz r26, 0x3328(r8)
    li r7, 4096
_gz_identity_owner_scan:
    cmpwi r26, 0
    beq _gz_identity_owner_bad
    addi r7, r7, -1
    cmpwi r7, 0
    beq _gz_identity_owner_bad
    lwz r3, 12(r26)
    cmpwi r3, 0
    beq _gz_identity_owner_scan_next
    lwz r8, 4(r3)
    cmpw r8, r4
    beq _gz_identity_owner_candidate
_gz_identity_owner_scan_next:
    lwz r26, 8(r26)
    b _gz_identity_owner_scan
_gz_identity_owner_candidate:
    lhz r8, 8(r3)
    lhz r9, 4(r30)
    cmpw r8, r9
    bne _gz_identity_owner_bad
    lhz r8, 0x2D8(r3)
    lhz r9, 6(r30)
    cmpw r8, r9
    bne _gz_identity_owner_bad
    lwz r8, 0xB0(r3)
    lwz r9, 8(r30)
    cmpw r8, r9
    bne _gz_identity_owner_bad
