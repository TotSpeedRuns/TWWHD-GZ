    lwz r8, 4(r30)
    lwz r9, 8(r30)
    mullw r5, r8, r9
    add r26, r26, r5
    bl _gz_player_copy_bytes
    lwz r8, 16(r30)
    add r4, r29, r8
    mr r3, r26
    lwz r5, 20(r30)
    add r26, r26, r5
    bl _gz_player_copy_bytes
    lwz r8, 24(r30)
    add r4, r29, r8
    mr r3, r26
    lwz r5, 28(r30)
    bl _gz_player_copy_bytes
_gz_foliage_capture_group_next:
