0x020F9AF4 = b _gz_molgera_trace_entry
0x020F9AF8 = _gz_molgera_trace_resume:
.origin = codecave
_gz_molgera_trace_entry:
    stwu r1, -0x30(r1)
    stw r0, 28(r1)
    .int 0x7C000026 ; mfcr r0
    stw r0, 32(r1)
    stw r8, 8(r1)
    stw r9, 12(r1)
    stw r10, 16(r1)
    stw r11, 20(r1)
    stw r12, 24(r1)
    ; A genuine later anm_init supersedes the initial-constructor binding.
    lis r8, _gz_molg_ctor_binding@ha
    li r9, 0
    stw r9, _gz_molg_ctor_binding@l(r8)
    lis r8, _gz_molgera_animation_trace@ha
    addi r8, r8, _gz_molgera_animation_trace@l
    lwz r9, 4(r3)
    stw r9, 0(r8)
    lis r9, _gz_mss_frame_counter@ha
    lwz r9, _gz_mss_frame_counter@l(r9)
    stw r9, 4(r8)
    stw r4, 8(r8)
    stw r5, 12(r8)
    stw r6, 16(r8)
    stfs f1, 20(r8)
    stfs f2, 24(r8)
    stw r3, 28(r8)
    lwz r0, 32(r1)
    .int 0x7C0FF120 ; mtcrf 0xFF,r0
    lwz r8, 8(r1)
    lwz r9, 12(r1)
    lwz r10, 16(r1)
    lwz r11, 20(r1)
    lwz r12, 24(r1)
    lwz r0, 28(r1)
    addi r1, r1, 0x30
    stwu r1, -0x58(r1)
    b _gz_molgera_trace_resume
.align 4
