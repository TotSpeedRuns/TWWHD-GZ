    b _gz_join_value
_gz_widget_skip241:
_gz_join_done:
    li r9, 0
    stb r9, 0(r8)
    blr

_gz_circle:
    addi r3, r3, 16
    addi r4, r4, -80
    lis r12, _gz_state@ha
    addi r12, r12, _gz_state@l
    lwz r12, 12(r12)
    mullw r9, r5, r5
    neg r7, r5
_gz_circle_row:
    neg r8, r5
_gz_circle_pixel:
    mullw r10, r7, r7
    mullw r11, r8, r8
    add r10, r10, r11
    cmpw r10, r9
    ble _gz_widget_skip242
    b _gz_circle_next
_gz_widget_skip242:
    add r10, r4, r7
    mulli r10, r10, 5120
    add r11, r3, r8
    slwi r11, r11, 2
    add r10, r10, r11
    stwx r6, r12, r10
_gz_circle_next:
    addi r8, r8, 1
    cmpw r8, r5
    bgt _gz_widget_skip243
    b _gz_circle_pixel
_gz_widget_skip243:
    addi r7, r7, 1
    cmpw r7, r5
    bgt _gz_widget_skip244
    b _gz_circle_row
_gz_widget_skip244:
    blr
_gz_widget_rect:
    addi r3, r3, 16
    addi r4, r4, -80
    lis r12, _gz_state@ha
    addi r12, r12, _gz_state@l
    lwz r12, 12(r12)
    li r8, 0
_gz_rect_row:
    add r10, r4, r8
    mulli r10, r10, 5120
    add r10, r10, r12
    slwi r11, r3, 2
    add r10, r10, r11
    li r9, 0
_gz_rect_pixel:
