_gz_world_replay_ready:
    ; The owned phase-1 hook runs after the old scene has been discarded and
    ; applies persistent state before destination actor construction. Waiting
    ; for it prevents a same-room restore from consuming an old actor's slot.
    lis r8, _gz_route_active@ha
    lwz r8, _gz_route_active@l(r8)
    cmpwi r8, 0
    beq _gz_world_replay_resume
    lis r8, _gz_route_phase_applied@ha
    lwz r8, _gz_route_phase_applied@l(r8)
    cmpwi r8, 0
    beq _gz_world_replay_not_ready
    li r3, 1
    blr
_gz_world_replay_not_ready:
    li r3, 0
    blr

_gz_world_replay_resume:
    ; Tail call preserves the apply wrapper's LR. Only documented typed
    ; fields are replayed; native constructors retain their fresh pointers.
    b _gz_world_resume_check
_gz_world_resume_check_core:
    lis r8, _gz_world_resume_pending@ha
    lwz r3, _gz_world_resume_pending@l(r8)
    cmpwi r3, 0
    beqlr
    lis r9, _gz_world_lights_pending@ha
    lwz r9, _gz_world_lights_pending@l(r9)
    lis r10, _gz_world_enemies_pending@ha
    lwz r10, _gz_world_enemies_pending@l(r10)
    add r9, r9, r10
    lis r10, _gz_world_bridges_pending@ha
    lwz r10, _gz_world_bridges_pending@l(r10)
    add r9, r9, r10
    lis r10, _gz_camera_pending@ha
    lwz r10, _gz_camera_pending@l(r10)
    add r9, r9, r10
    lis r10, _gz_ftravel_pending@ha
    lwz r10, _gz_ftravel_pending@l(r10)
    add r9, r9, r10
    lis r10, _gz_field_travel_pending@ha
    lwz r10, _gz_field_travel_pending@l(r10)
    add r9, r9, r10
    cmpwi r9, 0
    beq _gz_world_resume_complete
    lis r9, _gz_mss_frame_counter@ha
    lwz r9, _gz_mss_frame_counter@l(r9)
    lis r10, _gz_world_resume_frame@ha
    lwz r10, _gz_world_resume_frame@l(r10)
    subf r9, r10, r9
    cmplwi r9, 120
    blelr
    ; Bound unsupported/missing actor replay and record failure instead of
    ; permitting a stale component to affect a later unrelated scene.
    li r9, 0
    lis r10, _gz_camera_pending@ha
    stw r9, _gz_camera_pending@l(r10)
    lis r10, _gz_world_lights_pending@ha
    stw r9, _gz_world_lights_pending@l(r10)
    lis r10, _gz_world_enemies_pending@ha
    stw r9, _gz_world_enemies_pending@l(r10)
    lis r10, _gz_world_bridges_pending@ha
    stw r9, _gz_world_bridges_pending@l(r10)
    lis r10, _gz_ftravel_pending@ha
    stw r9, _gz_ftravel_pending@l(r10)
    lis r10, _gz_field_travel_pending@ha
    stw r9, _gz_field_travel_pending@l(r10)
    lis r10, _gz_status@ha
    li r9, 28
    stw r9, _gz_status@l(r10)
    lis r10, _gz_world_resume_failed@ha
    li r9, 1
    stw r9, _gz_world_resume_failed@l(r10)
_gz_world_resume_complete:

    lis r9, _gz_route_choice@ha
    lwz r9, _gz_route_choice@l(r9)
    cmpwi r9, 680
    bne _gz_rng_resume_done
    lis r9, _gz_inplace_enabled@ha
    lwz r9, _gz_inplace_enabled@l(r9)
    cmpwi r9, 0
    beq _gz_rng_resume_done
    lis r9, _gz_rng_valid@ha
    lwz r9, _gz_rng_valid@l(r9)
    cmpwi r9, 1
    bne _gz_rng_resume_done
    lis r9, _gz_world_resume_failed@ha
    lwz r9, _gz_world_resume_failed@l(r9)
    cmpwi r9, 0
    bne _gz_rng_resume_done
    lis r9, _gz_rng_saved@ha
    addi r9, r9, _gz_rng_saved@l
    lis r10, 0x1021
    addi r10, r10, -1580
    lis r11, _gz_rng_observed@ha
    addi r11, r11, _gz_rng_observed@l
    lwz r12, 0(r9)
    stw r12, 0(r10)
    lwz r12, 0(r10)
    stw r12, 0(r11)
    lwz r12, 4(r9)
    stw r12, 4(r10)
    lwz r12, 4(r10)
    stw r12, 4(r11)
    lwz r12, 8(r9)
    stw r12, 8(r10)
    lwz r12, 8(r10)
    stw r12, 8(r11)
