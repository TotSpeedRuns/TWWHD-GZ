    lis r9, 0x3F80
    cmplw r8, r9
    blt _gz_camera_read_bad
    lis r9, 0x4334
    cmplw r8, r9
    bgt _gz_camera_read_bad
    mr r3,r31
    bl _gz_snapshot_ui_capture_context
    li r8, 1
    stw r8, 0(r31)
    li r3, 0
    b _gz_camera_read_done
_gz_camera_read_bad:
    li r8, 0
    stw r8, 0(r31)
    li r3, 27
_gz_camera_read_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr
_gz_camera_commit:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    lis r3, _gz_camera_saved@ha
    addi r3, r3, _gz_camera_saved@l
    lis r4, _gz_camera_working@ha
    addi r4, r4, _gz_camera_working@l
    li r5, 2048
    bl _gz_player_copy_bytes
_gz_camera_commit_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr
_gz_camera_preflight:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    lis r31, _gz_camera_saved@ha
    addi r31, r31, _gz_camera_saved@l
    lwz r8, 0(r31)
    cmpwi r8, 1
    bne _gz_camera_preflight_bad
    bl _gz_camera_current
    cmpwi r3, 0
    beq _gz_camera_preflight_bad
    lwz r8, 8(r31)
    cmpw r8, r4
    bne _gz_camera_preflight_bad
    lwz r8, 12(r31)
    lwz r9, 4(r4)
    cmpw r8, r9
    bne _gz_camera_preflight_bad
    lwz r8, 16(r31)
    cmpw r8, r5
    bne _gz_camera_preflight_bad
    li r26, 0
_gz_camera_preflight_links:
    slwi r8, r26, 2
    addi r8, r8, 32
    lwzx r3, r31, r8
    cmpwi r3, -1
    beq _gz_camera_preflight_next
    bl _gz_camera_find_actor
