; Native owned Bomb2 Execute starts with mflr r0. Pause only during
; constructor reconciliation or the existing short atomic world replay.
0x020C9E78 = b _gz_bomb2_execute_hook
0x020C9E7C = _gz_bomb2_execute_resume:
.origin = codecave
_gz_bomb2_execute_hook:
    lis r8, _gz_bomb2_create_phase@ha
    addi r8, r8, _gz_bomb2_create_phase@l
    lwz r8, 0(r8)
    cmpwi r8, 0
