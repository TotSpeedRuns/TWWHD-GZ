    addi r5, r5, _gz_v103_floor_canonical@l
    lwzx r3, r5, r3
    cmpwi r3, -1
    beq _gz_user_totg_arrival_scene_selected
_gz_v103_arrival_before_floor_aliases:
    cmplwi r3, 541
    blt _gz_v103_arrival_original
    cmplwi r3, 551
    bgt _gz_v103_arrival_original
    addi r3, r3, -541
    mulli r3, r3, 4
    lis r5, _gz_v103_totg_original_indices@ha
    addi r5, r5, _gz_v103_totg_original_indices@l
    lwzx r3, r5, r3
    cmpwi r3, -1
    beq _gz_user_totg_arrival_scene_selected
_gz_v103_arrival_original:
    cmplwi r3, 179
    blt _gz_v102_arrival_try_nomss
    cmplwi r3, 186
    bgt _gz_v102_arrival_try_nomss
    addi r3, r3, -179
    b _gz_v102_arrival_selected
_gz_v102_arrival_try_nomss:
    cmplwi r3, 295
    blt _gz_v102_arrival_try_gl
    cmplwi r3, 302
    bgt _gz_v102_arrival_try_gl
    addi r3, r3, -295
    b _gz_v102_arrival_selected
_gz_v102_arrival_try_gl:
    cmplwi r3, 487
    blt _gz_user_totg_arrival_not_scene
    cmplwi r3, 494
    bgt _gz_user_totg_arrival_not_scene
    addi r3, r3, -487
_gz_v102_arrival_selected:
    cmplwi r9, 0x7A8
    blt _gz_user_totg_arrival_scene_selected
    mulli r3, r3, 4
    lis r5, _gz_user_totg_unused_zone@ha
    addi r5, r5, _gz_user_totg_unused_zone@l
    lwzx r3, r5, r3
    cmpwi r3, 0
    bne _gz_route_patch_next
_gz_user_totg_arrival_scene_selected:
