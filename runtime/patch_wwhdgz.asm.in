    blt _gz_v103_seed_original
    cmplwi r8, 550
    ble _gz_v102_seed_selected
_gz_v103_seed_original:
    cmplwi r8, 179
    blt _gz_v102_seed_try_nomss
    cmplwi r8, 186
    ble _gz_v102_seed_selected
_gz_v102_seed_try_nomss:
