_gz_slot_detail_draw:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x20(r1)
    mr r26, r3
    bl _gz_slot_descriptor
    mr r30, r3
    cmpwi r3, 0
    beq _gz_slot_detail_done
    lis r27, _gz_slot_detail_buffer@ha
    addi r27, r27, _gz_slot_detail_buffer@l
    addi r28, r27, 128
    mr r3, r27
    mr r4, r28
    lis r5, _gz_slot_text_source@ha
    addi r5, r5, _gz_slot_text_source@l
    li r6, 16
    bl _gz_slot_append
    mr r29, r3
    mr r3, r26
    bl _gz_slot_origin_lookup
    cmpwi r3, -1
    beq _gz_slot_detail_native
    slwi r8, r3, 2
    lis r9, _gz_slot_route_areas@ha
    addi r9, r9, _gz_slot_route_areas@l
    lwzx r31, r9, r8
    mulli r8, r3, 20
    lis r9, _gz_route_records@ha
    addi r9, r9, _gz_route_records@l
    lwzx r5, r9, r8
    b _gz_slot_detail_source
_gz_slot_detail_native:
    lis r5, _gz_slot_text_native@ha
    addi r5, r5, _gz_slot_text_native@l
    mr r31, r5
_gz_slot_detail_source:
    mr r3, r29
    mr r4, r28
    li r6, 112
    bl _gz_slot_append
    mr r3, r27
    li r4, 1
    bl _gz_slot_label_fit
    mr r3, r28
    addi r4, r28, 128
    mr r5, r31
    li r6, 48
    bl _gz_slot_append
    mr r4, r28
    addi r4, r4, 128
    lis r5, _gz_slot_text_slash@ha
    addi r5, r5, _gz_slot_text_slash@l
    li r6, 3
    bl _gz_slot_append
    mr r29, r3
    mr r3, r30
    bl _gz_slot_location
    mr r5, r3
    mr r3, r29
    addi r4, r28, 128
    li r6, 32
    bl _gz_slot_append
    mr r3, r28
    li r4, 1
    bl _gz_slot_label_fit
    ; Position in the same grid as the established picker, with smaller native
    ; face for complete selected names and distinct route/area information.
    li r29, 42
    li r30, 448
    li r31, 480
_gz_slot_detail_positions:
    mr r4, r29
    mr r5, r30
    mr r6, r27
    bl _gz_font_small
    lis r8, _gz_slots_notice@ha
    lwz r8, _gz_slots_notice@l(r8)
    cmpwi r8, 0
    bne _gz_slot_detail_done
    mr r4, r29
    mr r5, r31
    mr r6, r28
    bl _gz_font_small
_gz_slot_detail_done:
    lmw r26, 0x20(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr


