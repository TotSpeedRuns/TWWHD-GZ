    bne _gz_resource_face_selected_1
    lhz r4, 4508(r31)
_gz_resource_face_selected_1:
    mr r3, r28
    li r5, 0
    bl _gz_resource_load_btk
    mr r4, r3
    mr r3, r28
    lhz r5, 27010(r28)
    bl _gz_resource_bind_btk
    addi r3, r28, 26080
    addi r4, r31, 4508
    li r5, 8
    bl _gz_player_copy_bytes
    mr r3, r28
    bl _gz_resource_reset_sound
    lwz r26, 112(r31)
    cmpwi r26, -1
    beq _gz_resource_sound_done
    lwz r27, 116(r31)
    slwi r8, r27, 2
    addi r8, r8, 88
    lwzx r9, r31, r8
