_gz_slot_origin_restore_begin:
    lis r8, _gz_slot_origin_pending@ha
    addi r8, r8, _gz_slot_origin_pending@l
    lis r9, _gz_slot_origin_captured@ha
    lwz r10, _gz_slot_origin_captured@l(r9)
    stw r10, 4(r8)
    lis r9, _gz_route_records@ha
    addi r9, r9, _gz_route_records@l
    addi r9, r9, 13600
    lwz r10, 4(r9)
    stw r10, 8(r8)
    lwz r10, 8(r9)
    stw r10, 12(r8)
    lwz r10, 12(r9)
    srwi r10, r10, 8
    andi. r10, r10, 255
    stw r10, 16(r8)
    li r10, 1
    stw r10, 0(r8)
    b _gz_slot_origin_clear
; The two result hooks keep queued/accepted operations pending; only complete
; file success or the world-completion hook may adopt provenance.
_gz_slot_origin_result:
    lis r8, _gz_slot_origin_pending@ha
    addi r8, r8, _gz_slot_origin_pending@l
    lwz r9, 0(r8)
    cmpwi r9, 0
    beqlr
    cmpwi r3, 10
    beqlr
    cmpwi r3, 15
    beqlr
    cmpwi r3, 11
    beq _gz_slot_origin_result_complete
    li r9, 0
    stw r9, 0(r8)
    blr
_gz_slot_origin_result_complete:
    lis r9, _gz_world_resume_pending@ha
    lwz r9, _gz_world_resume_pending@l(r9)
    cmpwi r9, 0
    bnelr
    b _gz_slot_origin_adopt
_gz_slot_origin_resume_done:
    lis r8, _gz_slot_origin_pending@ha
