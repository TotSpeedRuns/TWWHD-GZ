.string "Roll clip: --"
_gz_roll_clip_wait:
.string "Partial wall clip: --"
_gz_roll_clip_yes:
.string "Partial wall clip: detected"
_gz_roll_clip_no:
.string "Partial wall clip: not detected"
_gz_roll_frame_early:
.string " frame early"
_gz_roll_frame_late:
.string " frame late"
