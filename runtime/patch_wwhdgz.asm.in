    cmpwi r3, 0
    beq _gz_native_map_fixed_pane_next
    b _gz_native_map_fixed_pane_draw
_gz_v103_map_not_island:
    ori r10, r10, 0
    lis r10, 0x505F
    ori r10, r10, 0x4772
    cmpw r9, r10
    beq _gz_native_map_fixed_pane_draw
    lis r10, 0x505F
    ori r10, r10, 0x4D61
    cmpw r9, r10
    bne _gz_native_map_fixed_pane_next
    lwz r9, 132(r31)
    lis r10, 0x704D
    ori r10, r10, 0x6172
    cmpw r9, r10
    bne _gz_native_map_fixed_pane_next
    ; Respect the native mark's parent visibility: hide inactive warps.
    lwz r9, 12(r31)
    cmpwi r9, 0
    beq _gz_native_map_fixed_pane_next
    lbz r9, 68(r9)
    andi. r9, r9, 1
    beq _gz_native_map_fixed_pane_next
_gz_native_map_fixed_pane_draw:
