    ; The owning boss must be the captured allocation and ready component.
    lis r8, _gz_molgera_component@ha
    lwz r5, _gz_molgera_component@l+4(r8)
    li r4, 217
    bl _gz_life_find_actor
    cmpwi r3, 0
