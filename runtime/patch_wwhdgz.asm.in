    li r9, 0
    stw r9, _gz_item_retire_probe@l(r8)
    bl _gz_v103_restore_ready
    cmpwi r3, 0
    bne _gz_item_retire_prepare_done
    lis r31, _gz_player_record@ha
    addi r31, r31, _gz_player_record@l
    lis r8, _gz_item_retire_phase@ha
    lwz r8, _gz_item_retire_phase@l(r8)
    cmpwi r8, 1
    beq _gz_item_retire_wait_child
    lwz r8, 0(r31)
    cmpwi r8, 1
    bne _gz_item_retire_not_needed
    lwz r8, 4(r31)
    lwz r9, 4(r11)
    cmpw r8, r9
    bne _gz_item_retire_not_needed
    lwz r8, 108(r31)
    cmpwi r8, 0x100
    bne _gz_item_retire_not_needed
    lwz r8, 36(r31)
    cmpwi r8, 0
    bne _gz_item_retire_not_needed
    lwz r8, 52(r31)
    cmpwi r8, -1
    bne _gz_item_retire_not_needed
    lhz r8, 0x69B0(r11)
    li r28, 169
    cmpwi r8, 0x2F
    beq _gz_item_retire_check_owned_child
    li r28, 446
    cmpwi r8, 0x25
    bne _gz_item_retire_not_needed
_gz_item_retire_check_owned_child:
    lwz r29, 0x6590(r11)
    cmpwi r29, -1
    beq _gz_item_retire_not_needed
    lwz r30, 0x6594(r11)
    lis r8, 0x1000
    cmplw r30, r8
    blt _gz_item_retire_not_needed
    lis r8, 0xC000
    cmplw r30, r8
    bge _gz_item_retire_not_needed
    andi. r8, r30, 3
    bne _gz_item_retire_not_needed
    lwz r8, 4(r30)
    cmpw r8, r29
    bne _gz_item_retire_not_needed
    lhz r8, 8(r30)
    cmpw r8, r28
    bne _gz_item_retire_not_needed
    ; Resolve the queue identity; an ActorKeep pointer alone is insufficient.
    mr r4, r28
    mr r5, r29
    bl _gz_life_find_actor
    cmpw r3, r30
    bne _gz_item_retire_not_needed
    lis r8, _gz_item_retire_actor@ha
    stw r30, _gz_item_retire_actor@l(r8)
    lis r8, _gz_item_retire_pid@ha
    stw r29, _gz_item_retire_pid@l(r8)
    lis r8, _gz_item_retire_profile@ha
    stw r28, _gz_item_retire_profile@l(r8)
    lis r8, _gz_item_retire_probe@ha
    li r9, 1
    stw r9, _gz_item_retire_probe@l(r8)
    b _gz_item_retire_not_needed
_gz_item_retire_wait_child:
    lwz r8, 4(r31)
    lwz r9, 4(r11)
    cmpw r8, r9
    bne _gz_item_retire_cancel
    lis r8, _gz_item_retire_profile@ha
    lwz r4, _gz_item_retire_profile@l(r8)
    lis r8, _gz_item_retire_pid@ha
    lwz r5, _gz_item_retire_pid@l(r8)
    bl _gz_life_find_actor
    cmpwi r3, 0
    beq _gz_item_retire_completed
    lis r8, _gz_mss_frame_counter@ha
    lwz r9, _gz_mss_frame_counter@l(r8)
    lis r8, _gz_item_retire_started@ha
    lwz r8, _gz_item_retire_started@l(r8)
    subf r8, r8, r9
    cmplwi r8, 120
    bgt _gz_item_retire_cancel
    lis r8, _gz_pending@ha
    li r9, 11
    stw r9, _gz_pending@l(r8)
    li r3, 5
    b _gz_item_retire_prepare_done
_gz_item_retire_completed:
    lis r8, _gz_item_retire_phase@ha
    li r9, 0
    stw r9, _gz_item_retire_phase@l(r8)
_gz_item_retire_not_needed:
    li r3, 0
    b _gz_item_retire_prepare_done
_gz_item_retire_cancel:
    lis r8, _gz_item_retire_phase@ha
    li r9, 0
    stw r9, _gz_item_retire_phase@l(r8)
    li r3, 28
