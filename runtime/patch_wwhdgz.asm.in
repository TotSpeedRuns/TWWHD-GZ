    cmpwi r8, 1
    bne _gz_bflower_component_regular
    lhz r8, 8(r11)
    cmpwi r8, 295
    beq _gz_inplace_check_next
    cmpwi r8, 422
    beq _gz_inplace_check_next
_gz_bflower_component_regular:
    cmpwi r29, 0
    beq _gz_inplace_lifetime_changed
    ; The complete identity set was validated before this component walk.
    lhz r8, 8(r11)
    ; A Molgera/larva component is not yet complete. Do not silently apply
    ; persistent state and call that a complete boss rewind.
    cmpwi r8, 217
    bne _gz_molgera_not_head
    mr r3, r11
    bl _gz_molgera_component_preflight
    cmpwi r3, 0
    bne _gz_inplace_coverage_pending
    b _gz_inplace_check_component_done
_gz_molgera_not_head:
    cmpwi r8, 218
    bne _gz_larva_not_child
    mr r3, r11
    bl _gz_larva_preflight
    cmpwi r3, 0
    bne _gz_inplace_coverage_pending
    b _gz_inplace_check_component_done
_gz_larva_not_child:
    cmpwi r8, 89
    bne _gz_inplace_check_component_done
    lwz r8, 0x550(r11)
    cmpwi r8, 0
    beq _gz_inplace_coverage_pending
_gz_inplace_check_component_done:
    addi r28, r28, 8
    addi r29, r29, -1
_gz_inplace_check_next:
    lwz r27, 8(r27)
    b _gz_inplace_check_node
_gz_inplace_check_end:
    cmpwi r29, 0
    bne _gz_inplace_lifetime_changed
    bl _gz_mca_blend_preflight
    cmpwi r3, 0
    bne _gz_inplace_coverage_pending
    bl _gz_camera_preflight
    cmpwi r3, 0
    bne _gz_inplace_coverage_pending
    bl _gz_route_heap_check
    cmpwi r3, 0
    bne _gz_inplace_done
    lis r8, _gz_item_retire_probe@ha
    lwz r8, _gz_item_retire_probe@l(r8)
    cmpwi r8, 1
    bne _gz_v103_item_preflight_complete
    ; No save, camera or actor snapshot writes have happened yet.
    lis r8, _gz_item_retire_profile@ha
    lwz r8, _gz_item_retire_profile@l(r8)
    cmpwi r8, 422
    beq _gz_bflower_retire_native_child
    cmpwi r8, 295
    bne _gz_bflower_retire_equipped_item
_gz_bflower_retire_native_child:
    lis r8, _gz_item_retire_actor@ha
    lwz r3, _gz_item_retire_actor@l(r8)
    bl _gz_life_native_delete
    b _gz_bflower_retire_requested
_gz_bflower_retire_equipped_item:
    lwz r3, 8(r1)
    li r4, 0
    bl _gz_player_native_delete_item
_gz_bflower_retire_requested:
    lis r8, _gz_item_retire_phase@ha
    li r9, 1
    stw r9, _gz_item_retire_phase@l(r8)
    lis r8, _gz_mss_frame_counter@ha
    lwz r9, _gz_mss_frame_counter@l(r8)
    lis r8, _gz_item_retire_started@ha
    stw r9, _gz_item_retire_started@l(r8)
    lis r8, _gz_pending@ha
    li r9, 11
    stw r9, _gz_pending@l(r8)
    li r3, 5
    b _gz_inplace_done
_gz_v103_item_preflight_complete:
    lis r8, _gz_route_choice@ha
    li r9, 680
    stw r9, _gz_route_choice@l(r8)
    lwz r3, 16(r31)
    stw r3, 12(r1)
    bl _gz_route_apply
    bl _gz_molgera_component_apply
    bl _gz_larva_apply_all
    bl _gz_ext_apply_all
    bl _gz_bflower_apply
    bl _gz_field_apply
    ; Restore exact captured pose using current native position globals.
    lwz r9, 12(r1)
    lwz r11, 8(r1)
    lis r8, _gz_position_store@ha
    addi r8, r8, _gz_position_store@l
    lwz r10, 4(r9)
    stw r10, 0(r8)
    stw r10, 0x314(r11)
    stw r10, 0x300(r11)
    lwz r10, 8(r9)
    stw r10, 4(r8)
    stw r10, 0x318(r11)
    stw r10, 0x304(r11)
    stw r10, 0x7294(r11)
    stw r10, 0x6A48(r11)
    stw r10, 0x6A4C(r11)
    lwz r10, 12(r9)
    stw r10, 8(r8)
    stw r10, 0x31C(r11)
    stw r10, 0x308(r11)
    lwz r10, 16(r9)
    sth r10, 0x322(r11)
    sth r10, 0x32A(r11)
    sth r10, 0x30E(r11)
    lis r8, _gz_angle_store@ha
    sth r10, _gz_angle_store@l+2(r8)
    lis r8, _gz_shape_store@ha
    sth r10, _gz_shape_store@l+2(r8)
    lis r8, _gz_camera_pending@ha
    li r9, 1
    stw r9, _gz_camera_pending@l(r8)
    bl _gz_world_prepare_file_lights
    bl _gz_world_begin_light_restore
    bl _gz_world_begin_enemy_restore
    bl _gz_world_begin_bridge_restore
    lis r8, _gz_mss_frame_counter@ha
    lwz r8, _gz_mss_frame_counter@l(r8)
    lis r9, _gz_world_resume_frame@ha
    stw r8, _gz_world_resume_frame@l(r9)
    lis r9, _gz_world_resume_pending@ha
    li r8, 1
    stw r8, _gz_world_resume_pending@l(r9)
    li r3, 15
    b _gz_inplace_done
_gz_inplace_disabled:
    li r3, 0
    b _gz_inplace_done
_gz_inplace_busy:
    li r3, 5
    b _gz_inplace_done
_gz_inplace_empty:
    li r3, 2
    b _gz_inplace_done
_gz_inplace_scene_mismatch:
    li r3, 26
    b _gz_inplace_done
_gz_inplace_lifetime_changed:
    li r3, 27
    b _gz_inplace_done
_gz_inplace_coverage_pending:
    li r3, 28
_gz_inplace_done:
    lis r8, _gz_item_retire_probe@ha
    li r9, 0
    stw r9, _gz_item_retire_probe@l(r8)
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr
.align 4
