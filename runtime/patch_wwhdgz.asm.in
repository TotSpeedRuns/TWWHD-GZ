    lis r8, _gz_world_resume_pending@ha
    addi r8, r8, _gz_world_resume_pending@l
    lwz r8, 0(r8)
    cmpwi r8, 0
    bne _gz_bomb2_execute_paused
    mflr r0
    b _gz_bomb2_execute_resume
_gz_bomb2_execute_paused:
    li r3, 1
    blr
