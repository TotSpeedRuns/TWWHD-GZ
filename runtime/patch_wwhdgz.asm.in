_gz_upcharge_input:
    lis r11, _gz_tools_flags@ha
    lwz r9, _gz_tools_flags@l(r11)
    andi. r9, r9, 8
    beq _gz_after_hotkeys
    ; Menu navigation and higher-priority save/menu chords retain ownership.
    lwz r10, 0(r29)
    cmpwi r10, 0
    bne _gz_after_hotkeys
    lis r11, _gz_bind_masks@ha
    lwz r9, _gz_bind_masks@l+28(r11)
    and r10, r8, r9
    cmpw r10, r9
    bne _gz_upcharge_try_air_button
    lwz r10, 0x18(r1)
    and r10, r10, r9
    cmpw r10, r9
    beq _gz_upcharge_try_air_button
    li r12, 6
    b _gz_upcharge_queue_action
_gz_upcharge_try_air_button:
    ; D-pad Right refills native air even if the speed bind was reassigned.
    andi. r10, r8, 0x400
    beq _gz_after_hotkeys
    lwz r10, 0x18(r1)
    andi. r10, r10, 0x400
    bne _gz_after_hotkeys
    li r12, 13
_gz_upcharge_queue_action:
    lis r11, _gz_pending@ha
    stw r12, _gz_pending@l(r11)
    li r10, 0
    stw r10, 0(r31)
    stw r10, 4(r31)
    stw r10, 8(r31)
    b _gz_input_done
_gz_frame_upcharge:
    lis r8, _gz_tools_flags@ha
    addi r8, r8, _gz_tools_flags@l
    lwz r8, 0(r8)
    andi. r8, r8, 8
    bne _gz_widget_skip365
    b _gz_frame_done
_gz_widget_skip365:
    bl _gz_live_check
    cmpwi r3, 0
    beq _gz_widget_skip366
    b _gz_frame_done
_gz_widget_skip366:
    lis r8, _gz_tools_flags@ha
    lwz r8, _gz_tools_flags@l(r8)
    lis r9, _gz_upcharge_direction@ha
    lwz r9, _gz_upcharge_direction@l(r9)
    lis r10, 0x4416
    cmpwi r9, 1
    bne _gz_upcharge_sign_ready
    lis r10, 0xC416
_gz_upcharge_sign_ready:
    andi. r8, r8, 512
    beq _gz_upcharge_capped
    ; Preserve interrupted native floating-point state. Apply signed600 delta.
    stfd f0, 0x30(r1)
    stfd f1, 0x38(r1)
    stw r10, 0x40(r1)
    lfs f1, 0x40(r1)
    lfs f0, 0x6A14(r11)
    fadds f0, f0, f1
    stfs f0, 0x6A14(r11)
    lfd f0, 0x30(r1)
    lfd f1, 0x38(r1)
    b _gz_upcharge_refill_air
_gz_upcharge_capped:
    stw r10, 0x6A14(r11)
_gz_frame_upcharge_air_only:
    lis r8, _gz_state@ha
    lwz r8, _gz_state@l(r8)
    cmpwi r8, 0
    bne _gz_frame_done
    lis r8, _gz_tools_flags@ha
    lwz r8, _gz_tools_flags@l(r8)
    andi. r8, r8, 8
    beq _gz_frame_done
    bl _gz_live_check
    cmpwi r3, 0
    bne _gz_frame_done
_gz_upcharge_refill_air:
    ; Actual native GetPlay base is static1046F0B0, not the heap save block.
    ; Owned EUR GetPlay025200D8 and swim-init023F9018/24 establish these fields.
    ; Refill only an existing native air gauge; never create an air timer.
    lis r8, 0x1047
    addi r8, r8, -0x0F50
    lbz r9, 0x5BB0(r8)
    cmpwi r9, 0
    beq _gz_frame_done
    lwz r9, 0x5B50(r8)
    cmpwi r9, 0
    ble _gz_frame_done
    stw r9, 0x5B4C(r8)
    b _gz_frame_done
_gz_upcharge_name:
.string "Upcharge"
_gz_upcharge_no_cap_name:
.string "No Speed Cap"

.align 4
_gz_nav_repeat_state:
; held navigation mask, next game frame, page
.int 0, 0, 0
_gz_nav_repeat:
    ; Uses game frames, not controller polling frequency. Leaves r8 intact.
    li r3, 0
    lis r4, _gz_nav_repeat_state@ha
    addi r4, r4, _gz_nav_repeat_state@l
    lwz r5, 0(r29)
    cmpwi r5, 0
    beq _gz_nav_repeat_reset
    lwz r5, 4(r29)
    cmpwi r5, 0
    bne _gz_nav_repeat_reset
    lis r5, _gz_rebind_mode@ha
    lwz r5, _gz_rebind_mode@l(r5)
    cmpwi r5, 0
    bne _gz_nav_repeat_reset
    lis r5, _gz_bind_masks@ha
    addi r5, r5, _gz_bind_masks@l
    lwz r6, 12(r5)
    and r7, r8, r6
    cmpw r7, r6
    bne _gz_nav_repeat_check_down
    mr r3, r6
_gz_nav_repeat_check_down:
    lwz r6, 16(r5)
    and r7, r8, r6
    cmpw r7, r6
    bne _gz_nav_repeat_direction
    cmpwi r3, 0
    bne _gz_nav_repeat_reset
    mr r3, r6
_gz_nav_repeat_direction:
    cmpwi r3, 0
    beq _gz_nav_repeat_reset
    lis r5, _gz_page@ha
    lwz r5, _gz_page@l(r5)
    lis r6, 0x1020
    lwz r6, -0xAA8(r6)
    lwz r7, 0(r4)
    cmpw r3, r7
    bne _gz_nav_repeat_start
    lwz r7, 8(r4)
    cmpw r5, r7
    bne _gz_nav_repeat_start
    lwz r7, 4(r4)
    subf r7, r7, r6
    cmpwi r7, 0
    blt _gz_nav_repeat_wait
    addi r6, r6, 3
    stw r6, 4(r4)
    blr
_gz_nav_repeat_start:
    stw r3, 0(r4)
    stw r5, 8(r4)
    addi r6, r6, 15
    stw r6, 4(r4)
_gz_nav_repeat_wait:
    li r3, 0
    blr
_gz_nav_repeat_reset:
    li r3, 0
    stw r3, 0(r4)
    blr

.align 4
_gz_keep_equipment:
; Three user-selected item IDs and preferred inventory indices, Y/X/R order.
.int 0xFFFFFFFF, 0xFFFFFFFF
_gz_keep_equipment_capture:
    lis r4, _gz_keep_equipment@ha
    addi r4, r4, _gz_keep_equipment@l
    lis r5, _gz_equip_store@ha
    addi r5, r5, _gz_equip_store@l
    lis r6, _gz_route_heap@ha
    lwz r6, _gz_route_heap@l(r6)
    li r7, 0
_gz_keep_equipment_capture_loop:
    lbzx r8, r5, r7
    stbx r8, r4, r7
    addi r9, r7, 9
    lbzx r8, r6, r9
    addi r9, r7, 3
    stbx r8, r4, r9
    addi r7, r7, 1
    cmpwi r7, 3
    blt _gz_keep_equipment_capture_loop
    blr
_gz_keep_equipment_apply:
    lis r4, _gz_keep_equipment@ha
    addi r4, r4, _gz_keep_equipment@l
    lis r5, _gz_equip_store@ha
    addi r5, r5, _gz_equip_store@l
    lis r6, _gz_route_heap@ha
    lwz r6, _gz_route_heap@l(r6)
    addi r7, r6, 0x3C
    li r8, 0
_gz_keep_equipment_button:
    lbzx r9, r4, r8
    li r10, 255
    cmpwi r9, 255
    beq _gz_keep_equipment_write
    addi r11, r8, 3
    lbzx r10, r4, r11
    cmplwi r10, 21
    bge _gz_keep_equipment_search
    lbzx r11, r7, r10
    cmpw r11, r9
    beq _gz_keep_equipment_write
_gz_keep_equipment_search:
    li r10, 0
_gz_keep_equipment_search_loop:
    lbzx r11, r7, r10
    cmpw r11, r9
    beq _gz_keep_equipment_write
    addi r10, r10, 1
    cmpwi r10, 21
    blt _gz_keep_equipment_search_loop
    li r9, 255
    li r10, 255
_gz_keep_equipment_write:
    stbx r9, r5, r8
    addi r11, r8, 9
    stbx r10, r6, r11
    addi r8, r8, 1
    cmpwi r8, 3
    blt _gz_keep_equipment_button
    blr

; EUR v0 procedure table entries 54/55, verified against the original RPX.
0x1003707C = .int _gz_mss_wait_hook
0x10037088 = .int _gz_mss_move_hook
0x0242F594 = _gz_mss_wait_original:
0x0242F710 = _gz_mss_move_original:
_gz_mss_wait_hook:
    stwu r1, -0x30(r1)
    mflr r0
    stw r0, 0x34(r1)
    stw r3, 8(r1)
    lwz r4, 0x6A14(r3)
    stw r4, 16(r1)
    lhz r5, 0x32A(r3)
    stw r5, 20(r1)
    bl _gz_mss_wait_original
    b _gz_mss_hook_return
_gz_mss_move_hook:
    stwu r1, -0x30(r1)
    mflr r0
    stw r0, 0x34(r1)
    stw r3, 8(r1)
    lwz r4, 0x6A14(r3)
    stw r4, 16(r1)
    lhz r5, 0x32A(r3)
    stw r5, 20(r1)
    bl _gz_mss_move_original
_gz_mss_hook_return:
    stw r3, 12(r1)
    lwz r3, 8(r1)
    lwz r4, 16(r1)
    lwz r5, 20(r1)
    bl _gz_mss_sample
    lwz r3, 12(r1)
    lwz r0, 0x34(r1)
    mtlr r0
    addi r1, r1, 0x30
    blr

_gz_mss_enabled:
    lis r8, _gz_tools_flags@ha
    addi r8, r8, _gz_tools_flags@l
    lwz r8, 0(r8)
    andi. r8, r8, 16
    beqlr
    lis r8, _gz_state@ha
    addi r8, r8, _gz_state@l
    lwz r8, 0(r8)
    cmpwi r8, 0
    li r8, 0
    bnelr
    li r8, 1
    blr

; Called only after the game's real swimming procedure ran, never on renders.
_gz_mss_sample:
    stwu r1, -0x30(r1)
    mflr r0
    stw r0, 0x34(r1)
    stw r3, 8(r1)
    stw r4, 12(r1)
    stw r5, 16(r1)
    bl _gz_mss_enabled
    cmpwi r8, 0
    bne _gz_mss_skip1
    b _gz_mss_sample_done
_gz_mss_skip1:
    lis r8, _gz_mss_state@ha
    addi r8, r8, _gz_mss_state@l
    lwz r3, 8(r1)
    li r9, 1
    stw r9, 4(r8)
    lwz r9, 0(r8)
    cmpw r9, r3
    bne _gz_mss_skip2
    b _gz_mss_same_actor
_gz_mss_skip2:
    stw r3, 0(r8)
    li r9, 0
    stw r9, 8(r8)
    stw r9, 12(r8)
    stw r9, 16(r8)
    stw r9, 92(r8)
    stw r9, 96(r8)
_gz_mss_same_actor:
    lwz r9, 12(r8)
    cmpwi r9, 0
    bne _gz_mss_skip3
    b _gz_mss_sample_running
_gz_mss_skip3:
    li r9, 0
    stw r9, 12(r8)
    stw r9, 52(r8)
    stw r9, 16(r8)
    stw r9, 32(r8)
    stw r9, 36(r8)
    lwz r9, 56(r8)
    lwz r10, 60(r8)
    cmpwi r10, 0
    beq _gz_mss_skip4
    b _gz_mss_sample_running
_gz_mss_skip4:
    stw r9, 60(r8)
    lwz r10, 100(r8)
    stw r10, 136(r8)
    li r10, 0
    stw r10, 112(r8)
_gz_mss_sample_running:
    lwz r9, 16(r8)
    cmpwi r9, 0
    beq _gz_mss_skip5
    b _gz_mss_sample_count
_gz_mss_skip5:
    lwz r10, 12(r1)
    stw r10, 20(r8)
_gz_mss_sample_count:
    addi r9, r9, 1
    stw r9, 16(r8)
    lwz r10, 0x6A14(r3)
    stw r10, 24(r8)
    ; 6A08 is the effective stick distance tested by the swim procedure.
    lwz r10, 0x6A08(r3)
    rlwinm r10, r10, 0, 1, 31
    cmpwi r10, 0
    beq _gz_mss_skip6
    b _gz_mss_sample_turn
_gz_mss_skip6:
    lwz r10, 32(r8)
    addi r10, r10, 1
    stw r10, 32(r8)
_gz_mss_sample_turn:
    lhz r10, 0x32A(r3)
    lwz r11, 16(r1)
    subf r11, r11, r10
    extsh r11, r11
    cmpwi r11, 0
    blt _gz_mss_skip7
    b _gz_mss_face_absolute
_gz_mss_skip7:
    neg r11, r11
_gz_mss_face_absolute:
    cmpwi r11, 24576
    bge _gz_mss_skip8
    b _gz_mss_sample_done
_gz_mss_skip8:
    lwz r10, 36(r8)
    addi r10, r10, 1
    stw r10, 36(r8)
_gz_mss_sample_done:
    lwz r0, 0x34(r1)
    mtlr r0
    addi r1, r1, 0x30
    blr

; Input poll timing is deliberately separate from the count of swim updates.
_gz_mss_input:
    stwu r1, -0x20(r1)
    mflr r0
    stw r0, 0x24(r1)
    bl _gz_mss_enabled
    cmpwi r8, 0
    bne _gz_mss_skip9
    b _gz_mss_input_done
_gz_mss_skip9:
    lis r8, _gz_mss_state@ha
    addi r8, r8, _gz_mss_state@l
    lwz r9, 56(r8)
    addi r9, r9, 1
    stw r9, 56(r8)
    lis r12, _gz_input_snapshot@ha
    addi r12, r12, _gz_input_snapshot@l
    bl _gz_mss_scan_sequence
    lwz r10, 0(r12)
    lwz r11, 44(r8)
    stw r10, 44(r8)
    andc r11, r10, r11
    or r11, r11, r3
    ; B can resume the native pause screen for insta pausa.
    andi. r10, r11, 0x4000
    beq _gz_mss_check_start
    lwz r10, 12(r8)
    cmpwi r10, 0
    beq _gz_mss_check_start
    li r10, 3
    stw r10, 140(r8)
    b _gz_mss_skip11
_gz_mss_check_start:
    andi. r11, r11, 8
    bne _gz_mss_skip10
    b _gz_mss_input_stick
_gz_mss_skip10:
    lwz r10, 12(r8)
    cmpwi r10, 0
    bne _gz_mss_skip11
    b _gz_mss_request_pause
_gz_mss_skip11:
    lwz r10, 52(r8)
    cmpwi r10, 0
    beq _gz_mss_skip12
    b _gz_mss_request_pause
_gz_mss_skip12:
    li r10, 1
    stw r10, 52(r8)
    lwz r10, 140(r8)
    cmpwi r10, 3
    beq _gz_mss_resume_kind_ready
    li r10, 1
    stw r10, 140(r8)
_gz_mss_resume_kind_ready:
    li r10, 0
    stw r10, 160(r8)
    stw r9, 60(r8)
    li r10, -1
    stw r10, 64(r8)
    stw r10, 40(r8)
    b _gz_mss_input_stick
_gz_mss_request_pause:
_gz_mss_request_kind_done:
    li r10, 0
    stw r10, 160(r8)
    li r10, 1
    stw r10, 48(r8)
    stw r9, 68(r8)
    lwz r10, 16(r8)
    stw r10, 132(r8)
_gz_mss_input_stick:
    lwz r10, 28(r12)
    lwz r11, 104(r8)
    stw r10, 104(r8)
    cmpwi r10, 80
    ble _gz_mss_skip13
    b _gz_mss_input_direction
_gz_mss_skip13:
    cmpwi r11, 80
    bgt _gz_mss_skip14
    b _gz_mss_input_done
_gz_mss_skip14:
    lwz r10, 112(r8)
    addi r10, r10, 1
    stw r10, 112(r8)
    b _gz_mss_input_done
_gz_mss_input_direction:
    lwz r10, 32(r12)
    lwz r11, 136(r8)
    stw r10, 100(r8)
    subf r11, r11, r10
    cmpwi r11, 0
    blt _gz_mss_skip15
    b _gz_mss_input_angle_abs
_gz_mss_skip15:
    neg r11, r11
_gz_mss_input_angle_abs:
    cmpwi r11, 18000
    bgt _gz_mss_skip16
    b _gz_mss_input_angle_short
_gz_mss_skip16:
    li r10, 36000
    subf r11, r11, r10
_gz_mss_input_angle_short:
    cmpwi r11, 1000
    bge _gz_mss_skip17
    b _gz_mss_input_done
_gz_mss_skip17:
    lwz r10, 64(r8)
    cmpwi r10, -1
    beq _gz_mss_skip18
    b _gz_mss_input_done
_gz_mss_skip18:
    stw r9, 64(r8)
    lwz r10, 16(r8)
    lwz r11, 12(r8)
    cmpwi r11, 0
    bne _gz_mss_skip19
    b _gz_mss_input_move_frame
_gz_mss_skip19:
    li r10, 0
_gz_mss_input_move_frame:
    stw r10, 40(r8)
_gz_mss_input_done:
    lwz r0, 0x24(r1)
    mtlr r0
    addi r1, r1, 0x20
    blr

; Engine pass boundary: a pause request plus suspended swim execution is
; observable without confusing display frames with swimming frames.
_gz_mss_tick:
    stwu r1, -0x30(r1)
    mflr r0
    stw r0, 0x34(r1)
    stfd f1, 16(r1)
    stfd f2, 24(r1)
    bl _gz_mss_enabled
    cmpwi r8, 0
    bne _gz_mss_skip20
    b _gz_mss_reset
_gz_mss_skip20:
    bl _gz_live_check
    cmpwi r3, 0
    beq _gz_mss_skip21
    b _gz_mss_reset
_gz_mss_skip21:
    lwz r9, 0x65F0(r11)
    cmpwi r9, 54
    bne _gz_mss_skip22
    b _gz_mss_tick_swimming
_gz_mss_skip22:
    cmpwi r9, 55
    beq _gz_mss_skip23
    b _gz_mss_reset
_gz_mss_skip23:
_gz_mss_tick_swimming:
    lis r8, _gz_mss_state@ha
    addi r8, r8, _gz_mss_state@l
    lwz r9, 4(r8)
    li r10, 0
    stw r10, 4(r8)
    cmpwi r9, 0
    beq _gz_mss_skip24
    b _gz_mss_tick_running
_gz_mss_skip24:
    lwz r9, 12(r8)
    cmpwi r9, 0
    beq _gz_mss_skip25
    b _gz_mss_tick_done
_gz_mss_skip25:
    lwz r9, 48(r8)
    cmpwi r9, 0
    bne _gz_mss_skip26
    b _gz_mss_tick_done
_gz_mss_skip26:
    li r9, 1
    stw r9, 12(r8)
    li r9, 0
    stw r9, 48(r8)
    stw r9, 52(r8)
    lwz r9, 8(r8)
    cmpwi r9, 0
    beq _gz_mss_skip27
    b _gz_mss_finish
_gz_mss_skip27:
    li r9, 1
    stw r9, 8(r8)
    b _gz_mss_tick_done
_gz_mss_tick_running:
    lwz r9, 48(r8)
    cmpwi r9, 0
    bne _gz_mss_skip28
    b _gz_mss_tick_done
_gz_mss_skip28:
    lwz r9, 16(r8)
    lwz r10, 132(r8)
    subf r9, r10, r9
    cmpwi r9, 6
    bge _gz_mss_skip29
    b _gz_mss_tick_done
_gz_mss_skip29:
    li r9, 5
    stw r9, 92(r8)
    lwz r9, 160(r8)
    cmpwi r9, 0
    bne _gz_mss_early_count_done
    li r9, 1
    stw r9, 160(r8)
    lwz r9, 156(r8)
    addi r9, r9, 1
    stw r9, 156(r8)
    li r9, 0
    stw r9, 152(r8)
_gz_mss_early_count_done:
    li r9, 4
    lwz r10, 156(r8)
    cmpwi r10, 2
    blt _gz_mss_early_tip_store
    li r9, 5
_gz_mss_early_tip_store:
    stw r9, 164(r8)
    li r9, 0
    stw r9, 96(r8)
    b _gz_mss_tick_done
_gz_mss_finish:
    lwz r9, 16(r8)
    stw r9, 72(r8)
    lwz r10, 32(r8)
    stw r10, 76(r8)
    lwz r10, 36(r8)
    stw r10, 80(r8)
    lwz r10, 112(r8)
    stw r10, 116(r8)
    lwz r10, 40(r8)
    stw r10, 84(r8)
    lwz r10, 64(r8)
    cmpwi r10, -1
    bne _gz_mss_skip30
    b _gz_mss_finish_delta
_gz_mss_skip30:
    lwz r11, 60(r8)
    subf r10, r11, r10
    lwz r12, 68(r8)
    subf r12, r11, r12
    cmpwi r12, 0
    bgt _gz_mss_skip31
    b _gz_mss_finish_delta
_gz_mss_skip31:
    cmpwi r10, 0
    bge _gz_mss_skip32
    b _gz_mss_finish_delta
_gz_mss_skip32:
    cmpw r10, r12
    ble _gz_mss_skip33
    b _gz_mss_finish_delta
_gz_mss_skip33:
    mulli r10, r10, 100
    divwu r10, r10, r12
    stw r10, 88(r8)
_gz_mss_finish_delta:
    lfs f1, 24(r8)
    lfs f2, 20(r8)
    fsubs f1, f1, f2
    stfs f1, 28(r8)
    ; Keep the measured value; latch only a separate display copy.
    lwz r12, 28(r8)
    rlwinm r12, r12, 0, 1, 8
    lis r11, 0x7F80
    cmpw r12, r11
    beq _gz_mss_positive_hold_skip
    lis r11, _gz_mss_positive_threshold@ha
    lfs f2, _gz_mss_positive_threshold@l(r11)
    fcmpu cr0, f1, f2
    ble _gz_mss_positive_hold_skip
    lis r11, _gz_mss_positive_hold@ha
    addi r11, r11, _gz_mss_positive_hold@l
    stfs f1, 4(r11)
    lis r12, _gz_mss_frame_counter@ha
    lwz r12, _gz_mss_frame_counter@l(r12)
    stw r12, 8(r11)
    li r12, 1
    stw r12, 0(r11)
_gz_mss_positive_hold_skip:
    li r10, 2
    cmpwi r9, 1
    beq _gz_mss_skip34
    b _gz_mss_grade_neutral
_gz_mss_skip34:
    li r10, 1
_gz_mss_grade_neutral:
    lwz r11, 76(r8)
    cmpwi r11, 0
    bne _gz_mss_skip35
    b _gz_mss_grade_turn
_gz_mss_skip35:
    li r10, 3
    b _gz_mss_grade_store
_gz_mss_grade_turn:
    lwz r11, 80(r8)
    cmpwi r11, 0
    beq _gz_mss_skip36
    b _gz_mss_grade_speed
_gz_mss_skip36:
    li r10, 4
    b _gz_mss_grade_store
_gz_mss_grade_speed:
    cmpwi r10, 1
    beq _gz_mss_skip37
    b _gz_mss_grade_store
_gz_mss_skip37:
    lis r11, _gz_mss_min_gain@ha
    addi r11, r11, _gz_mss_min_gain@l
    lfs f2, 0(r11)
    fcmpu cr0, f1, f2
    ble _gz_mss_grade_store
    li r10, 6
_gz_mss_grade_store:
    stw r10, 92(r8)
    bl _gz_mss_coach_cycle
    lwz r11, 96(r8)
    cmpwi r10, 1
    bne _gz_mss_skip39
    b _gz_mss_streak_add
_gz_mss_skip39:
    li r11, -1
_gz_mss_streak_add:
    addi r11, r11, 1
    stw r11, 96(r8)
    lwz r11, 128(r8)
    addi r11, r11, 1
    stw r11, 128(r8)
    li r11, 0
    stw r11, 140(r8)
    b _gz_mss_tick_done
_gz_mss_reset:
    lis r8, _gz_mss_state@ha
    addi r8, r8, _gz_mss_state@l
    li r9, 0
    li r10, 50
_gz_mss_reset_loop:
    stw r9, 0(r8)
    addi r8, r8, 4
    addi r10, r10, -1
    cmpwi r10, 0
    beq _gz_mss_skip40
    b _gz_mss_reset_loop
_gz_mss_skip40:
    lis r8, _gz_mss_state@ha
    addi r8, r8, _gz_mss_state@l
    li r9, -1
    stw r9, 88(r8)
_gz_mss_tick_done:
    lfd f1, 16(r1)
    lfd f2, 24(r1)
    lwz r0, 0x34(r1)
    mtlr r0
    addi r1, r1, 0x30
    blr

_gz_mss_draw:
    stwu r1, -0x30(r1)
    mflr r0
    stw r0, 0x34(r1)
    stw r31, 0x20(r1)
    lis r8, _gz_tools_flags@ha
    addi r8, r8, _gz_tools_flags@l
    lwz r8, 0(r8)
    andi. r8, r8, 16
    bne _gz_mss_skip41
    b _gz_mss_draw_done
_gz_mss_skip41:
    lis r8, _gz_state@ha
    addi r8, r8, _gz_state@l
    lwz r8, 0(r8)
    cmpwi r8, 0
    beq _gz_mss_skip42
    b _gz_mss_draw_done
_gz_mss_skip42:
    lis r31, _gz_mss_state@ha
    addi r31, r31, _gz_mss_state@l
    lis r6, _gz_mss_title@ha
    addi r6, r6, _gz_mss_title@l
    li r4, 16
    li r5, 324
    bl _gz_font_small
    lwz r8, 92(r31)
    slwi r8, r8, 2
    lis r6, _gz_mss_results@ha
    addi r6, r6, _gz_mss_results@l
    lwzx r6, r6, r8
    li r4, 16
    li r5, 350
    li r3, 1
    lis r7, 0xFF40
    ori r7, r7, 0x40FF
    lwz r8, 92(r31)
    cmpwi r8, 1
    beq _gz_mss_skip43
    b _gz_mss_draw_result_yellow
_gz_mss_skip43:
    lis r7, 0x40FF
    ori r7, r7, 0x70FF
    b _gz_mss_draw_result_color
_gz_mss_draw_result_yellow:
    cmpwi r8, 2
    beq _gz_mss_skip44
    b _gz_mss_draw_result_white
_gz_mss_skip44:
    lis r7, 0xFFE0
    ori r7, r7, 0x40FF
    b _gz_mss_draw_result_color
_gz_mss_draw_result_white:
    cmpwi r8, 0
    beq _gz_mss_skip45
    b _gz_mss_draw_result_color
_gz_mss_skip45:
    li r7, -256
_gz_mss_draw_result_color:
    bl _gz_font_draw_px
    lwz r3, 72(r31)
    bl _gz_decimal
    mr r4, r6
    lis r3, _gz_mss_frames_label@ha
    addi r3, r3, _gz_mss_frames_label@l
    bl _gz_debug_join
    li r4, 16
    li r5, 376
    bl _gz_font_small
    lfs f1, 28(r31)
    lis r8, _gz_mss_positive_hold@ha
    addi r8, r8, _gz_mss_positive_hold@l
    lwz r9, 0(r8)
    cmpwi r9, 0
    beq _gz_mss_positive_draw_ready
    lis r9, _gz_mss_frame_counter@ha
    lwz r9, _gz_mss_frame_counter@l(r9)
    lwz r10, 8(r8)
    subf r9, r10, r9
    cmplwi r9, 90
    blt _gz_mss_positive_draw_latched
    li r9, 0
    stw r9, 0(r8)
    b _gz_mss_positive_draw_ready
_gz_mss_positive_draw_latched:
    lfs f1, 4(r8)
_gz_mss_positive_draw_ready:
    bl _gz_float_text
    mr r4, r6
    lis r3, _gz_mss_delta_label@ha
    addi r3, r3, _gz_mss_delta_label@l
    bl _gz_debug_join
    li r4, 16
    li r5, 402
    bl _gz_font_small
    lwz r8, 92(r31)
    slwi r8, r8, 2
    lis r6, _gz_mss_stick_messages@ha
    addi r6, r6, _gz_mss_stick_messages@l
    lwzx r6, r6, r8
    li r4, 16
    li r5, 428
    bl _gz_font_small
_gz_mss_draw_after_stick:
    lwz r3, 76(r31)
    bl _gz_decimal
    mr r4, r6
    lis r3, _gz_mss_neutral_label@ha
    addi r3, r3, _gz_mss_neutral_label@l
    bl _gz_debug_join
    li r4, 16
    li r5, 454
    bl _gz_font_small
    lwz r3, 96(r31)
    bl _gz_decimal
    mr r4, r6
    lis r3, _gz_mss_streak_label@ha
    addi r3, r3, _gz_mss_streak_label@l
    bl _gz_debug_join
    li r4, 16
    li r5, 480
    bl _gz_font_small
    lfs f1, 24(r31)
    bl _gz_float_text
    mr r4, r6
    lis r3, _gz_mss_speed_label@ha
    addi r3, r3, _gz_mss_speed_label@l
    bl _gz_debug_join
    li r4, 16
    li r5, 506
    bl _gz_font_small
    lwz r8, 168(r31)
    cmpwi r8, 2
    beq _gz_mss_draw_pending_fast
    cmpwi r8, 3
    beq _gz_mss_draw_pending_slow
    lwz r8, 148(r31)
    b _gz_mss_draw_type_name
_gz_mss_draw_pending_fast:
    lwz r8, 188(r31)
    cmpwi r8, 1
    li r8, 1
    bne _gz_mss_draw_type_name
    li r8, 3
    b _gz_mss_draw_type_name
_gz_mss_draw_pending_slow:
    li r8, 2
_gz_mss_draw_type_name:
    cmpwi r8, 0
    beq _gz_mss_draw_type_hidden
    slwi r8, r8, 2
    lis r6, _gz_mss_types@ha
    addi r6, r6, _gz_mss_types@l
    lwzx r6, r6, r8
    li r4, 16
    li r5, 532
    bl _gz_font_small
_gz_mss_draw_type_hidden:
    lwz r8, 164(r31)
    slwi r8, r8, 2
    lis r6, _gz_mss_tips@ha
    addi r6, r6, _gz_mss_tips@l
    lwzx r6, r6, r8
    li r4, 16
    li r5, 558
    bl _gz_font_small
_gz_mss_draw_done:
    lwz r31, 0x20(r1)
    lwz r0, 0x34(r1)
    mtlr r0
    addi r1, r1, 0x30
    blr
.align 4
_gz_mss_min_gain:
.float -2.8999
; Minimum 2.9 observed gain, plus a 0.0001 float32 subtraction guard.
; This compares observed gain only; it never writes swim speed.
_gz_mss_results:
.int _gz_mss_waiting,_gz_mss_perfect,_gz_mss_late,_gz_mss_neutral,_gz_mss_no_turn,_gz_mss_no_pause,_gz_mss_other
_gz_mss_name:
.string "MSS Trainer"
_gz_mss_title:
.string "MSS Trainer"
_gz_mss_waiting:
.string "Swim, then pause to start monitoring"
_gz_mss_perfect:
.string "Success: clean 1-frame turnaround"
_gz_mss_late:
.string "Multiple frames: late buffer"
_gz_mss_neutral:
.string "Effective neutral sampled"
_gz_mss_no_turn:
.string "Missed turnaround"
_gz_mss_no_pause:
.string "Pause not observed: possible early press"
_gz_mss_other:
.string "1 frame + turn: low gain"
_gz_mss_frames_label:
.string "Buffer frames: "
_gz_mss_delta_label:
.string "Speed change: "
_gz_mss_stick_label:
.string "Stick movement: "
_gz_mss_percent:
.string "% of input window"
_gz_mss_neutral_label:
.string "Neutral gameplay frames: "
_gz_mss_streak_label:
.string "Perfect streak: "
_gz_mss_speed_label:
.string "Speed: "

