; Captured Morth Hover trick-state entry, separate from route categories.
.origin = codecave
_gz_mht_enter_menu:
    lis r9, _gz_page@ha
    li r10, 50
    stw r10, _gz_page@l(r9)
    li r10, 0
    stw r10, 8(r29)
    b _gz_mask
_gz_mht_select_menu:
    lis r9, _gz_bind_masks@ha
    lwz r9, _gz_bind_masks@l+20(r9)
    and. r0, r8, r9
    beq _gz_mht_selection_done
    lwz r0, 0(r31)
    and r0, r0, r9
    cmpw r0, r9
    bne _gz_mht_selection_done
    bl _gz_mht_choose
_gz_mht_selection_done:
    b _gz_mask
_gz_mht_draw_menu:
    stwu r1, -0x20(r1)
    mflr r0
    stw r0, 0x24(r1)
    li r3, 0
    li r4, 2
    li r5, 1
    lis r6, _gz_mht_title@ha
    addi r6, r6, _gz_mht_title@l
    bl _gz_game_text
    li r3, 0
    li r4, 4
    li r5, 3
    lis r6, _gz_mht_name@ha
    addi r6, r6, _gz_mht_name@l
    bl _gz_game_text
    li r3, 0
    li r4, 2
    li r5, 3
    lis r6, _gz_marker@ha
    addi r6, r6, _gz_marker@l
    bl _gz_game_text
    li r3, 0
    li r4, 2
    li r5, 8
    lis r6, _gz_mht_controls@ha
    addi r6, r6, _gz_mht_controls@l
    bl _gz_game_text
    lwz r0, 0x24(r1)
    mtlr r0
    addi r1, r1, 0x20
    blr
_gz_mht_title:
.string "Tricks"
_gz_mht_name:
.string "Morth Hover"
_gz_mht_controls:
.string "A: Restore setup    B: Back"
.align 4
