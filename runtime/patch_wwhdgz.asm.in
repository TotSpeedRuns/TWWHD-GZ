; EUR-v0 real options state, based on the user's normal/storage captures.
; Mode 0 was observed with the game's Pro Controller selected.
_gz_menu_memory:
.int 0
.int 0
.int 0
.int 0
.int 0
.int 0
.int 0
.int 0
.int 0
.int 0
.int 0
.int 0
_gz_remember_menu:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stw r8, 8(r1)
    stw r9, 12(r1)
    stw r10, 16(r1)
    stw r11, 20(r1)
    stw r12, 24(r1)
    lis r8, _gz_state@ha
    addi r8, r8, _gz_state@l
    lwz r9, 0(r8)
    cmpwi r9, 0
    beq _gz_remember_menu_done
    lis r10, _gz_page@ha
    lwz r10, _gz_page@l(r10)
    cmpwi r10, 0
    beq _gz_remember_menu_done
    lis r11, _gz_menu_memory@ha
    addi r11, r11, _gz_menu_memory@l
    li r9, 1
    stw r9, 0(r11)
    lwz r9, 8(r8)
    stw r9, 4(r11)
    lis r12, _gz_page@ha
    addi r12, r12, _gz_page@l
    lwz r9, 0(r12)
    stw r9, 8(r11)
    lis r12, _gz_group_selection@ha
    addi r12, r12, _gz_group_selection@l
    lwz r9, 0(r12)
    stw r9, 12(r11)
    lis r12, _gz_list_base@ha
    addi r12, r12, _gz_list_base@l
    lwz r9, 0(r12)
    stw r9, 16(r11)
    lis r12, _gz_list_count@ha
    addi r12, r12, _gz_list_count@l
    lwz r9, 0(r12)
    stw r9, 20(r11)
    lis r12, _gz_list_offset@ha
    addi r12, r12, _gz_list_offset@l
    lwz r9, 0(r12)
    stw r9, 24(r11)
    lis r12, _gz_list_title@ha
    addi r12, r12, _gz_list_title@l
    lwz r9, 0(r12)
    stw r9, 28(r11)
    lis r12, _gz_route_selection@ha
    addi r12, r12, _gz_route_selection@l
    lwz r9, 0(r12)
    stw r9, 32(r11)
    lis r12, _gz_area_selection@ha
    addi r12, r12, _gz_area_selection@l
    lwz r9, 0(r12)
    stw r9, 36(r11)
    lis r12, _gz_warp_cursor@ha
    addi r12, r12, _gz_warp_cursor@l
    lwz r9, 0(r12)
    stw r9, 40(r11)
    lis r12, _gz_warp_top@ha
    addi r12, r12, _gz_warp_top@l
    lwz r9, 0(r12)
    stw r9, 44(r11)
_gz_remember_menu_done:
    lwz r8, 8(r1)
    lwz r9, 12(r1)
    lwz r10, 16(r1)
    lwz r11, 20(r1)
    lwz r12, 24(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr
_gz_reopen_menu:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stw r8, 8(r1)
    stw r9, 12(r1)
    stw r10, 16(r1)
    stw r11, 20(r1)
    stw r12, 24(r1)
    ; Reopen at the main practice menu.
    lis r8, _gz_state@ha
    addi r8, r8, _gz_state@l
    lwz r9, 0(r8)
    cmpwi r9, 0
    beq _gz_reopen_menu_done
    li r9, 0
    stw r9, 8(r8)
    lis r10, _gz_page@ha
    stw r9, _gz_page@l(r10)
    lis r10, _gz_list_offset@ha
    stw r9, _gz_list_offset@l(r10)
_gz_reopen_menu_done:
    lwz r8, 8(r1)
    lwz r9, 12(r1)
    lwz r10, 16(r1)
    lwz r11, 20(r1)
    lwz r12, 24(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr

.align 4

; Inventory-owned page51. Input only queues requests; the existing validated
; inventory tick applies them. mCollect.mTact is save+BD, bits0..5 (d_item).
_gz_song_open:
    lis r9, _gz_page@ha
    li r10, 51
    stw r10, _gz_page@l(r9)
    li r10, 0
    stw r10, 8(r29)
    b _gz_mask
_gz_song_input:
    bl _gz_inventory_dpad_read
    lwz r9, 0(r29)
    cmpwi r9, 0
    bne _gz_song_input_active
    b _gz_input_done
_gz_song_input_active:
    lwz r8, 0x10(r1)
    lis r11, _gz_bind_masks@ha
    addi r11, r11, _gz_bind_masks@l
    lwz r9, 24(r11)
    and. r9, r8, r9
    beq _gz_song_navigation
    lis r9, _gz_page@ha
    li r10, 8
    stw r10, _gz_page@l(r9)
    li r10, 4
    stw r10, 8(r29)
    b _gz_mask
_gz_song_navigation:
    lwz r9, 0x1C(r1)
    or r8, r8, r9
    lis r9, _gz_inventory_dpad_repeat@ha
    lwz r9, _gz_inventory_dpad_repeat@l(r9)
    or r8, r8, r9
    lwz r10, 8(r29)
    lwz r9, 12(r11)
    ori r9, r9, 0x0200
    and. r9, r8, r9
    beq _gz_song_down
    addi r10, r10, -1
_gz_song_down:
    lwz r9, 16(r11)
    ori r9, r9, 0x0100
    and. r9, r8, r9
    beq _gz_song_lower
    addi r10, r10, 1
_gz_song_lower:
    cmpwi r10, 0
    bge _gz_song_upper
    li r10, 5
_gz_song_upper:
    cmpwi r10, 5
    ble _gz_song_select
    li r10, 0
_gz_song_select:
    stw r10, 8(r29)
    lwz r8, 0x10(r1)
    lwz r9, 20(r11)
    and. r9, r8, r9
    beq _gz_song_remove
    addi r10, r10, 920
    b _gz_inv_queue
_gz_song_remove:
    andi. r9, r8, 0x2000
    beq _gz_song_input_done
    addi r10, r10, 930
    b _gz_inv_queue
_gz_song_input_done:
    b _gz_mask

; r27 request920..925 Give,930..935 Remove; r28 validated save base.
; Preserve every other song bit; granting also provides a usable Wind Waker.
_gz_song_apply:
    addi r9, r27, -920
    cmplwi r9, 5
    ble _gz_song_give
    addi r9, r27, -930
    cmplwi r9, 5
    bgtlr
    li r8, 1
    slw r8, r8, r9
    lbz r10, 0xBD(r28)
    andc r10, r10, r8
    stb r10, 0xBD(r28)
    blr
_gz_song_give:
    li r8, 1
    slw r8, r8, r9
    lbz r10, 0xBD(r28)
    or r10, r10, r8
    stb r10, 0xBD(r28)
    li r8, 0x22
    stb r8, 0x3E(r28)
    lbz r8, 0x53(r28)
    ori r8, r8, 1
    stb r8, 0x53(r28)
    blr

_gz_song_draw:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    li r3, 2
    li r4, 120
    li r5, 128
    lis r6, _gz_song_title@ha
    addi r6, r6, _gz_song_title@l
    bl _gz_inv_text_shadow
    bl _gz_route_heap_check
    cmpwi r3, 0
    bne _gz_song_draw_done
    lis r8, _gz_route_heap@ha
    lwz r28, _gz_route_heap@l(r8)
    lwz r26, 8(r29)
    li r27, 0
_gz_song_draw_row:
    lis r8, _gz_song_names@ha
    addi r8, r8, _gz_song_names@l
    slwi r9, r27, 2
    lwzx r6, r8, r9
    li r4, 150
    mulli r5, r27, 58
    addi r5, r5, 225
    bl _gz_inv_text_small
    li r8, 1
    slw r8, r8, r27
    lbz r9, 0xBD(r28)
    and. r8, r8, r9
    lis r6, _gz_song_missing@ha
    addi r6, r6, _gz_song_missing@l
    beq _gz_song_draw_status
    lis r6, _gz_song_learned@ha
    addi r6, r6, _gz_song_learned@l
_gz_song_draw_status:
    li r4, 750
    mulli r5, r27, 58
    addi r5, r5, 225
    bl _gz_inv_text_small
    cmpw r26, r27
    bne _gz_song_draw_next
    lis r6, _gz_marker@ha
    addi r6, r6, _gz_marker@l
    li r4, 120
    mulli r5, r27, 58
    addi r5, r5, 225
    bl _gz_inv_cursor
_gz_song_draw_next:
    addi r27, r27, 1
    cmpwi r27, 6
    blt _gz_song_draw_row
    lis r6, _gz_song_help@ha
    addi r6, r6, _gz_song_help@l
    li r4, 120
    li r5, 635
    bl _gz_inv_text_small
_gz_song_draw_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr
.align 4
_gz_song_names:
.int _gz_song_name0,_gz_song_name1,_gz_song_name2,_gz_song_name3,_gz_song_name4,_gz_song_name5
_gz_song_title:
.string "Inventory / Wind Waker Songs"
_gz_song_name0:
.string "Wind's Requiem"
_gz_song_name1:
.string "Ballad of Gales"
_gz_song_name2:
.string "Command Melody"
_gz_song_name3:
.string "Earth God's Lyric"
_gz_song_name4:
.string "Wind God's Aria"
_gz_song_name5:
.string "Song of Passing"
_gz_song_learned:
.string "Learned"
_gz_song_missing:
.string "Not learned"
_gz_song_help:
.string "A: Give Song    X: Remove Song    B: Inventory"
.align 4

; Always available independently of tools. ZL80+ZR40 and Right400/Left800.
; Queue existing validated capacity-only refills. Never overwrite work already
; queued by capture/restore, a route or an inventory action.
_gz_refill_hotkey_input:
    lwz r8, 0(r31)
    andi. r9, r8, 0x0CC0
    cmpwi r9, 0x04C0
    beq _gz_refill_hotkey_magic
    cmpwi r9, 0x08C0
    beq _gz_refill_hotkey_health
    cmpwi r9, 0x0CC0
    bne _gz_refill_hotkey_continue
    b _gz_mask
_gz_refill_hotkey_magic:
    li r10, 702
    li r12, 0x04C0
    b _gz_refill_hotkey_match
_gz_refill_hotkey_health:
    li r10, 703
    li r12, 0x08C0
_gz_refill_hotkey_match:
    lwz r9, 0x18(r1)
    and r9, r9, r12
    cmpw r9, r12
    bne _gz_refill_hotkey_edge
    b _gz_mask
_gz_refill_hotkey_edge:
    lis r9, _gz_pending@ha
    lwz r9, _gz_pending@l(r9)
    cmpwi r9, 0
    bne _gz_refill_hotkey_busy
    lis r9, _gz_world_resume_pending@ha
    lwz r9, _gz_world_resume_pending@l(r9)
    cmpwi r9, 0
    bne _gz_refill_hotkey_busy
    lis r9, _gz_mht_phase@ha
    lwz r9, _gz_mht_phase@l(r9)
    cmpwi r9, 0
    bne _gz_refill_hotkey_busy
    lis r9, _gz_inv_request@ha
    lwz r9, _gz_inv_request@l(r9)
    cmpwi r9, 0
    bne _gz_refill_hotkey_busy
    b _gz_inv_queue
_gz_refill_hotkey_busy:
    b _gz_mask

_gz_inventory_begin:
_gz_inv_root_choose:
    lwz r8, 0x10(r1)
    lis r9, _gz_bind_masks@ha
    addi r9, r9, _gz_bind_masks@l
    lwz r9, 20(r9)
    and. r8, r8, r9
    bne _gz_inv_far_1
    b _gz_mask
_gz_inv_far_1:
    lis r9, _gz_page@ha
    li r10, 8
    stw r10, _gz_page@l(r9)
    li r10, 0
    stw r10, 8(r29)
    b _gz_mask
_gz_inventory_input:
    bl _gz_inventory_dpad_read
    lis r9, _gz_page@ha
    lwz r9, _gz_page@l(r9)
    cmpwi r9, 12
    bne _gz_refill_not_page
    b _gz_refill_input
_gz_refill_not_page:
    cmpwi r9, 9
    blt _gz_inv_far_2
    b _gz_spoils_input
_gz_inv_far_2:
    lwz r9, 0(r29)
    cmpwi r9, 0
    bne _gz_inv_far_3
    b _gz_input_done
_gz_inv_far_3:
    lwz r8, 0x10(r1)
    andi. r9, r8, 0x1000
    beq _gz_refill_no_open
    li r10, 12
    lis r9, _gz_page@ha
    stw r10, _gz_page@l(r9)
    li r10, 0
    stw r10, 8(r29)
    b _gz_mask
_gz_refill_no_open:
    andi. r9, r8, 0x0010
    bne _gz_inv_far_4
    b _gz_inv_normal_input
_gz_inv_far_4:
    li r10, 24
    stw r10, 8(r29)
    b _gz_mask
_gz_inv_normal_input:
    lis r9, _gz_bind_masks@ha
    addi r9, r9, _gz_bind_masks@l
    lwz r9, 24(r9)
    and. r9, r8, r9
    beq _gz_inv_far_5
    b _gz_inv_back
_gz_inv_far_5:
