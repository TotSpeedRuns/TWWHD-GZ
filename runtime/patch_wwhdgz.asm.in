    addi r4, r29, 4
    li r5, 18
    bl _gz_stone_birth_copy
    lbz r8, 0x21(r29)
    stb r8, 42(r28)
    li r8, 0
    stb r8, 43(r28)
    stw r8, 60(r28)
    lhz r8, 0x16(r29)
    sth r8, 44(r28)
    li r8, 454
    sth r8, 46(r28)
    addi r3, r28, 48
    lis r4, _gz_stage_store@ha
    addi r4, r4, _gz_stage_store@l
    li r5, 8
    bl _gz_stone_birth_copy
    lis r8, _gz_layer_store@ha
    lbz r8, _gz_layer_store@l(r8)
    stw r8, 56(r28)
    li r8, 1
    stw r8, 0(r28)
    lwz r8, 20(r31)
    addi r8, r8, 1
    stw r8, 20(r31)
    li r3, 2
    mr r4, r30
    li r5, 0
    bl _gz_stone_birth_trace
_gz_stone_birth_request_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr

; r3 actor,r4 still-live creation append pointer. Captures original inputs.
_gz_stone_birth_create:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    mr r30, r3
    mr r29, r4
    lhz r8, 8(r30)
    cmpwi r8, 454
    bne _gz_stone_birth_create_done
    lis r31, _gz_stone_birth_header@ha
    addi r31, r31, _gz_stone_birth_header@l
    lwz r8, 8(r31)
    cmpwi r8, 0
    beq _gz_stone_birth_create_done
    lis r27, _gz_stone_birth_live@ha
    addi r27, r27, _gz_stone_birth_live@l
    li r26, 64
    li r28, 0
_gz_stone_birth_create_scan:
    lwz r8, 0(r27)
    cmpwi r8, 0
    beq _gz_stone_birth_create_free
    lwz r8, 8(r27)
    cmpw r8, r30
    beq _gz_stone_birth_create_collision
    lwz r8, 4(r27)
    lwz r9, 4(r30)
    cmpw r8, r9
    bne _gz_stone_birth_create_next
_gz_stone_birth_create_collision:
    li r8, 0
    stw r8, 0(r27)
    lwz r8, 36(r31)
    addi r8, r8, 1
    stw r8, 36(r31)
_gz_stone_birth_create_free:
    cmpwi r28, 0
    bne _gz_stone_birth_create_next
    mr r28, r27
_gz_stone_birth_create_next:
    addi r27, r27, 80
    addi r26, r26, -1
    cmpwi r26, 0
    bne _gz_stone_birth_create_scan
    cmpwi r28, 0
    bne _gz_stone_birth_create_serial
    li r3, 2
    bl _gz_stone_birth_error
    b _gz_stone_birth_create_done
_gz_stone_birth_create_serial:
    lwz r8, 12(r31)
    cmpwi r8, -1
    bne _gz_stone_birth_create_write
    li r3, 4
    bl _gz_stone_birth_error
    b _gz_stone_birth_create_done
_gz_stone_birth_create_write:
    addi r8, r8, 1
    stw r8, 12(r31)
    stw r8, 12(r28)
    lwz r8, 4(r30)
    stw r8, 4(r28)
    stw r30, 8(r28)
    lwz r8, 8(r31)
    stw r8, 16(r28)
    li r8, 0
    stw r8, 20(r28)
    stw r8, 60(r28)
    stw r8, 76(r28)
    lwz r8, 0xB0(r30)
    stw r8, 24(r28)
    lwz r8, 0x2E8(r30)
    stw r8, 28(r28)
    addi r3, r28, 32
    addi r4, r30, 0x2EC
    li r5, 19
    bl _gz_stone_birth_copy
    li r8, 0
    stb r8, 51(r28)
    lhz r8, 0x2D8(r30)
    sth r8, 52(r28)
    li r8, 454
    sth r8, 54(r28)
    stw r29, 56(r28)
    addi r3, r28, 64
    lis r4, _gz_stage_store@ha
    addi r4, r4, _gz_stage_store@l
    li r5, 8
    bl _gz_stone_birth_copy
    lis r8, _gz_layer_store@ha
    lbz r8, _gz_layer_store@l(r8)
    stw r8, 72(r28)
    lis r27, _gz_stone_birth_pending@ha
    addi r27, r27, _gz_stone_birth_pending@l
    li r26, 32
_gz_stone_birth_create_request_scan:
    lwz r8, 0(r27)
    cmpwi r8, 1
    bne _gz_stone_birth_create_request_next
    lwz r8, 4(r27)
    lwz r9, 4(r30)
    cmpw r8, r9
    bne _gz_stone_birth_create_request_next
    lwz r8, 8(r27)
    cmpw r8, r29
    bne _gz_stone_birth_create_request_next
    ; A matched PID/append entry is consumed even if a digest was modified.
    li r8, 0
    stw r8, 0(r27)
    lwz r8, 12(r27)
    lwz r9, 16(r28)
    cmpw r8, r9
    bne _gz_stone_birth_create_request_bad
    addi r3, r27, 16
    addi r4, r28, 24
    li r5, 27
    bl _gz_stone_birth_equal
    cmpwi r3, 0
    beq _gz_stone_birth_create_request_bad
    lhz r8, 44(r27)
    lhz r9, 52(r28)
    cmpw r8, r9
    bne _gz_stone_birth_create_request_bad
    addi r3, r27, 48
    addi r4, r28, 64
    li r5, 12
    bl _gz_stone_birth_equal
    cmpwi r3, 0
    beq _gz_stone_birth_create_request_bad
    li r8, 1
    stw r8, 20(r28)
    b _gz_stone_birth_create_publish
_gz_stone_birth_create_request_bad:
    li r3, 8
    bl _gz_stone_birth_error
    b _gz_stone_birth_create_publish
_gz_stone_birth_create_request_next:
    addi r27, r27, 64
    addi r26, r26, -1
    cmpwi r26, 0
    bne _gz_stone_birth_create_request_scan
_gz_stone_birth_create_publish:
    li r8, 1
    stw r8, 0(r28)
    lwz r8, 24(r31)
    addi r8, r8, 1
    stw r8, 24(r31)
    li r3, 3
    lwz r4, 4(r30)
    mr r5, r30
    bl _gz_stone_birth_trace
_gz_stone_birth_create_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr

; Pointer/PID pair lookup only into this private live ledger. No rebinding.
_gz_stone_birth_find:
    lwz r10, 4(r3)
    mr r11, r3
    lis r3, _gz_stone_birth_live@ha
    addi r3, r3, _gz_stone_birth_live@l
    li r9, 64
_gz_stone_birth_find_loop:
    lwz r8, 0(r3)
    cmpwi r8, 0
    beq _gz_stone_birth_find_next
    lwz r8, 4(r3)
    cmpw r8, r10
    bne _gz_stone_birth_find_next
    lwz r8, 8(r3)
    cmpw r8, r11
    beqlr
_gz_stone_birth_find_next:
    addi r3, r3, 80
    addi r9, r9, -1
    cmpwi r9, 0
    bne _gz_stone_birth_find_loop
    li r3, 0
    blr

_gz_stone_birth_rng:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    mr r30, r3
    lhz r8, 8(r30)
    cmpwi r8, 454
    bne _gz_stone_birth_rng_done
    bl _gz_stone_birth_find
    mr r28, r3
    cmpwi r28, 0
    beq _gz_stone_birth_rng_missing
    lwz r8, 0(r28)
    cmpwi r8, 1
    bne _gz_stone_birth_rng_bad
    lis r31, _gz_stone_birth_header@ha
    addi r31, r31, _gz_stone_birth_header@l
    lwz r8, 8(r31)
    lwz r9, 16(r28)
    cmpw r8, r9
    bne _gz_stone_birth_rng_bad
    lwz r8, 24(r28)
    lwz r9, 0xB0(r30)
    cmpw r8, r9
    bne _gz_stone_birth_rng_bad
    lwz r8, 28(r28)
    lwz r9, 0x2E8(r30)
    cmpw r8, r9
    bne _gz_stone_birth_rng_bad
    lhz r8, 52(r28)
    lhz r9, 0x2D8(r30)
    cmpw r8, r9
    bne _gz_stone_birth_rng_bad
    addi r3, r28, 32
    addi r4, r30, 0x2EC
    li r5, 19
    bl _gz_stone_birth_equal
    cmpwi r3, 0
    beq _gz_stone_birth_rng_bad
    lwz r8, 0x78C(r30)
    stw r8, 60(r28)
    lha r8, 0x2FA(r30)
    stw r8, 76(r28)
    lwz r8, 20(r28)
    ori r8, r8, 2
    stw r8, 20(r28)
    li r8, 2
    stw r8, 0(r28)
    lwz r8, 28(r31)
    addi r8, r8, 1
    stw r8, 28(r31)
    li r3, 4
    lwz r4, 4(r30)
    mr r5, r30
    bl _gz_stone_birth_trace
    b _gz_stone_birth_rng_done
_gz_stone_birth_rng_bad:
    li r8, 3
    stw r8, 0(r28)
    li r3, 16
    bl _gz_stone_birth_error
    b _gz_stone_birth_rng_done
_gz_stone_birth_rng_missing:
    lis r8, _gz_stone_birth_header@ha
    addi r8, r8, _gz_stone_birth_header@l
    lwz r9, 40(r8)
    addi r9, r9, 1
    stw r9, 40(r8)
    li r3, 64
    bl _gz_stone_birth_error
_gz_stone_birth_rng_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr

_gz_stone_birth_retire:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    mr r30, r3
    lhz r8, 8(r30)
    cmpwi r8, 454
    bne _gz_stone_birth_retire_done
    bl _gz_stone_birth_find
    cmpwi r3, 0
    beq _gz_stone_birth_retire_done
    li r8, 0
    stw r8, 0(r3)
    lis r8, _gz_stone_birth_header@ha
    addi r8, r8, _gz_stone_birth_header@l
    lwz r9, 32(r8)
    addi r9, r9, 1
    stw r9, 32(r8)
    li r3, 5
    lwz r4, 4(r30)
    mr r5, r30
    bl _gz_stone_birth_trace
_gz_stone_birth_retire_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr

