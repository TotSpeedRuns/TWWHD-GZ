    addi r30, r30, 1
    b _gz_native_map_fixed_pane_loop
_gz_native_map_fixed_pane_done:
    lmw r28, 0x10(r1)
    lwz r0, 0x24(r1)
    mtlr r0
    addi r1, r1, 0x20
    blr

