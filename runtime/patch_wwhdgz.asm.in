_gz_cursor_720:
    mulli r4, r4, 32
    mulli r5, r5, 48
    addi r5, r5, 9
    lis r6, _gz_cursor_pixels@ha
    addi r6, r6, _gz_cursor_pixels@l
    li r3, 32
_gz_cursor_positioned:
    lwz r7, 12(r29)
    li r8, 0
_gz_cursor_row:
    add r10, r5, r8
    mulli r10, r10, 5120
    add r10, r10, r7
    slwi r11, r4, 2
    add r10, r10, r11
    li r9, 0
_gz_cursor_pixel:
    lwz r11, 0(r6)
    andi. r12, r11, 0xFF
    bne _gz_widget_skip264
    b _gz_cursor_next
_gz_widget_skip264:
    stw r11, 0(r10)
_gz_cursor_next:
    addi r6, r6, 4
    addi r10, r10, 4
    addi r9, r9, 1
