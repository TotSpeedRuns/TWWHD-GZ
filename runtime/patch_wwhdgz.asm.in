_gz_widget_skip141:
    lis r8, _gz_route_ticks@ha
    addi r8, r8, _gz_route_ticks@l
    lwz r10, 0(r8)
    cmpwi r10, 60
    bge _gz_widget_skip142
    b _gz_route_finish_done
_gz_widget_skip142:
    lis r8, _gz_route_seen_loading@ha
    addi r8, r8, _gz_route_seen_loading@l
    lwz r10, 0(r8)
    cmpwi r10, 0
    beq _gz_widget_skip143
    b _gz_route_arrived
_gz_widget_skip143:
    lis r8, _gz_route_old_actor@ha
    addi r8, r8, _gz_route_old_actor@l
    lwz r10, 0(r8)
    cmpw r10, r11
    bne _gz_widget_skip144
    b _gz_route_finish_done
_gz_widget_skip144:
_gz_route_arrived:
    b _gz_it_arrival_hook
_gz_td_late_continue:
    ; Only the position-return request waits for scripted entry animations.
    lis r8, _gz_position_return_pending@ha
    lwz r8, _gz_position_return_pending@l(r8)
    cmpwi r8, 0
    beq _gz_position_arrival_guard_done
    lwz r8, 0x65F0(r11)
    cmpwi r8, 169
    blt _gz_position_arrival_check_event
    cmpwi r8, 221
    bgt _gz_position_arrival_check_event
    b _gz_route_finish_done
_gz_position_arrival_check_event:
    lis r8, 0x1047
    lbz r8, 0x4342(r8)
    cmpwi r8, 0
    beq _gz_position_arrival_guard_done
    b _gz_route_finish_done
_gz_position_arrival_guard_done:
    bl _gz_route_heap_check
    cmpwi r3, 0
    beq _gz_widget_skip145
    b _gz_route_finish_done
_gz_widget_skip145:
    lis r9, _gz_route_active@ha
    addi r9, r9, _gz_route_active@l
    lwz r9, 0(r9)
    lwz r3, 16(r9)
    stw r3, 8(r1)
    bl _gz_route_apply_arrival
    bl _gz_if_apply_c
    bl _gz_v103_bow_statue_setup
    bl _gz_os_checkpoint_select_call
    bl _gz_fm_arrival_prepare
    cmpwi r3, 0
    bne _gz_route_finish_done
    b _gz_mc_prepare_hook
_gz_mc_prepare_continue:
    lwz r9, 8(r1)
    lwz r10, 20(r9)
    andi. r10, r10, 1
    cmpwi r10, 0
    bne _gz_widget_skip146
    b _gz_route_loaded
_gz_widget_skip146:
    lis r8, _gz_link_slot@ha
    addi r8, r8, _gz_link_slot@l
    lwz r11, 0(r8)
    lis r8, _gz_position_store@ha
    addi r8, r8, _gz_position_store@l
    lwz r10, 4(r9)
    stw r10, 0(r8)
    stw r10, 788(r11)
    stw r10, 768(r11)
    lwz r10, 8(r9)
    stw r10, 4(r8)
    stw r10, 792(r11)
    stw r10, 772(r11)
    lwz r10, 12(r9)
    stw r10, 8(r8)
    stw r10, 796(r11)
    stw r10, 776(r11)
    lwz r10, 16(r9)
    lis r8, _gz_angle_store@ha
    addi r8, r8, _gz_angle_store@l
    sth r10, 2(r8)
    lis r8, _gz_shape_store@ha
    addi r8, r8, _gz_shape_store@l
    sth r10, 2(r8)
    sth r10, 0x322(r11)
    sth r10, 0x32A(r11)
    sth r10, 0x30E(r11)
    li r10, 0
    stw r10, 828(r11)
    stw r10, 832(r11)
    stw r10, 836(r11)
    stw r10, 880(r11)
    stw r10, 27156(r11)
_gz_route_loaded:
    bl _gz_fm_bind_prepare
    cmpwi r3, 0
    bne _gz_route_finish_done
    lis r8, _gz_world_bridges_pending@ha
    lwz r8, _gz_world_bridges_pending@l(r8)
    cmpwi r8, 0
    bne _gz_route_finish_done
    lis r8, _gz_world_enemies_pending@ha
    lwz r8, _gz_world_enemies_pending@l(r8)
    cmpwi r8, 0
    bne _gz_route_finish_done
    lis r8, _gz_world_lights_pending@ha
    lwz r8, _gz_world_lights_pending@l(r8)
    cmpwi r8, 0
    bne _gz_route_finish_done
    lis r8, _gz_position_return_pending@ha
    lwz r8, _gz_position_return_pending@l(r8)
    cmpwi r8, 0
    beq _gz_position_regular_checkpoint
    li r8, 0
    lis r9, _gz_position_return_pending@ha
    stw r8, _gz_position_return_pending@l(r9)
    bl _gz_restore_state
    b _gz_route_finish_result
_gz_position_regular_checkpoint:
    bl _gz_il_file_loaded_observe
    bl _gz_slot_origin_file_loaded
    bl _gz_world_finish_file_lights
    lis r8, _gz_route_choice@ha
    lwz r8, _gz_route_choice@l(r8)
    cmplwi r8, 679
    beq _gz_v73_do_not_remember
    cmplwi r8, 680
    beq _gz_v73_do_not_remember
    lis r9, _gz_v73_last_memfile@ha
    stw r8, _gz_v73_last_memfile@l(r9)
_gz_v73_do_not_remember:
    cmplwi r8, 680
    beq _gz_world_full_snapshot_loaded
    lis r9, _gz_world_file_lights_active@ha
    lwz r9, _gz_world_file_lights_active@l(r9)
    cmpwi r9, 0
    beq _gz_world_ordinary_loaded_message
    bl _gz_world_begin_light_restore
    b _gz_world_mark_resume
_gz_world_full_snapshot_loaded:
    bl _gz_world_begin_light_restore
    bl _gz_world_begin_enemy_restore
    bl _gz_world_begin_bridge_restore
_gz_world_mark_resume:
    lis r8, _gz_mss_frame_counter@ha
    lwz r8, _gz_mss_frame_counter@l(r8)
    lis r9, _gz_world_resume_frame@ha
    stw r8, _gz_world_resume_frame@l(r9)
    li r8, 1
    lis r9, _gz_world_resume_pending@ha
    stw r8, _gz_world_resume_pending@l(r9)
    li r3, 15
    b _gz_route_finish_result
_gz_world_ordinary_loaded_message:
    li r3, 11
    b _gz_route_finish_result
_gz_route_timeout:
    bl _gz_il_load_failed_observe
    lis r8, _gz_world_bridges_pending@ha
    li r10, 0
    stw r10, _gz_world_bridges_pending@l(r8)
    lis r8, _gz_world_enemies_pending@ha
    li r10, 0
    stw r10, _gz_world_enemies_pending@l(r8)
    lis r8, _gz_world_lights_pending@ha
    li r10, 0
    stw r10, _gz_world_lights_pending@l(r8)
    lis r8, _gz_position_return_pending@ha
    li r10, 0
    stw r10, _gz_position_return_pending@l(r8)
