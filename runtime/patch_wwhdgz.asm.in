    addi r30, r30, 1
    cmpwi r30, 8
    bge _gz_inv_far_90
    b _gz_spoils_draw_row
_gz_inv_far_90:
_gz_bag_draw_help:
    lis r6, _gz_spoils_help@ha
    addi r6, r6, _gz_spoils_help@l
    lwz r8, 16(r26)
    cmpwi r8, 0
    beq _gz_inv_far_91
    b _gz_bag_draw_footer
_gz_inv_far_91:
    lis r6, _gz_bag_delivery_help@ha
    addi r6, r6, _gz_bag_delivery_help@l
    lis r8, _gz_bag_full@ha
    lwz r8, _gz_bag_full@l(r8)
    cmpwi r8, 0
    bne _gz_inv_far_92
    b _gz_bag_draw_footer
_gz_inv_far_92:
    lis r6, _gz_bag_full_text@ha
    addi r6, r6, _gz_bag_full_text@l
_gz_bag_draw_footer:
    li r4, 120
    li r5, 635
    bl _gz_inv_text_small
    b _gz_inv_draw_done
_gz_inv_cursor:
    li r3, 21
    lis r6, _gz_cursor_pixels21@ha
    addi r6, r6, _gz_cursor_pixels21@l
    b _gz_cursor_positioned
_gz_inv_hearts_text:
    stwu r1, -0x10(r1)
    mflr r0
    stw r0, 0x14(r1)
    andi. r8, r3, 3
    stw r8, 8(r1)
    srwi r3, r3, 2
    bl _gz_decimal
    lis r8, _gz_inv_health_text@ha
    addi r8, r8, _gz_inv_health_text@l
    mr r10, r6
    mr r6, r8
_gz_inv_fraction_end:
    lbz r9, 0(r10)
    stb r9, 0(r8)
    cmpwi r9, 0
    bne _gz_inv_far_93
    b _gz_inv_fraction_append
_gz_inv_far_93:
    addi r8, r8, 1
    addi r10, r10, 1
    b _gz_inv_fraction_end
_gz_inv_fraction_append:
    li r9, 46
    stb r9, 0(r8)
    lwz r9, 8(r1)
    mulli r9, r9, 25
    li r10, 10
    divwu r11, r9, r10
    mulli r12, r11, 10
    subf r12, r12, r9
    addi r11, r11, 48
    addi r12, r12, 48
    stb r11, 1(r8)
    stb r12, 2(r8)
    li r9, 0
    stb r9, 3(r8)
    lwz r0, 0x14(r1)
    mtlr r0
    addi r1, r1, 0x10
    blr
