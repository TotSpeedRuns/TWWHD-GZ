_gz_identity_owner_home:
    lbz r11, 0(r8)
    lbz r12, 0(r9)
    cmpw r11, r12
    bne _gz_identity_owner_bad
    addi r8, r8, 1
    addi r9, r9, 1
    addi r10, r10, -1
