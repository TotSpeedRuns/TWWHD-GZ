; Versioned extensions inside the existing camera/player component allocations.
; No saved native pointers are introduced. Older records lack the marker and
; retain their previous behavior. Only a successful admitted replay arms UI.
.origin = codecave
_gz_snapshot_ui_capture_context:
    li r8,0
    stw r8,1536(r3)
    stw r8,1540(r3)
    stw r8,1544(r3)
    lis r9,_gz_ps_ui_state_root@ha
    lwz r9,_gz_ps_ui_state_root@l(r9)
    andi. r10,r9,3
    bnelr
    lis r10,0x1000
    cmplw r9,r10
    bltlr
    lis r10,0xBFFF
    cmplw r9,r10
    bgelr
    lwz r11,12(r9)
    lis r10,_gz_ps_play@ha
    addi r10,r10,_gz_ps_play@l
    cmpw r11,r10
    bne _gz_snapshot_ui_capture_menu
    lis r10,_gz_snapshot_native_pause@ha
    lbz r10,_gz_snapshot_native_pause@l(r10)
    cmpwi r10,0
    bnelr
    b _gz_snapshot_ui_capture_publish
_gz_snapshot_ui_capture_menu:
    lis r10,_gz_ps_menu@ha
    addi r10,r10,_gz_ps_menu@l
    cmpw r11,r10
    bnelr
    lis r10,_gz_snapshot_native_pause@ha
    lbz r10,_gz_snapshot_native_pause@l(r10)
    cmpwi r10,1
    bnelr
    lwz r10,0x224(r9)
    cmplwi r10,2
    bgtlr
    lwz r11,0x228(r9)
    cmpw r10,r11
    bnelr
    stw r10,1544(r3)
    li r8,1
_gz_snapshot_ui_capture_publish:
    stw r8,1540(r3)
    lis r8,0x5549
    ori r8,r8,0x5331
    stw r8,1536(r3)
    blr

_gz_snapshot_ui_arm:
    lis r8,_gz_snapshot_ui_pending@ha
    addi r8,r8,_gz_snapshot_ui_pending@l
    li r9,0
    stw r9,0(r8)
    lis r10,_gz_camera_saved@ha
    addi r10,r10,_gz_camera_saved@l
    lwz r11,1536(r10)
    lis r12,0x5549
    ori r12,r12,0x5331
    cmpw r11,r12
    bnelr
    lwz r11,1540(r10)
    cmplwi r11,1
    bgtlr
    lwz r12,1544(r10)
    cmplwi r12,2
    bgtlr
    stw r11,4(r8)
    stw r12,8(r8)
    lis r10,_gz_mss_frame_counter@ha
    lwz r10,_gz_mss_frame_counter@l(r10)
    stw r10,12(r8)
    li r9,1
    stw r9,0(r8)
    blr

; Called with the current native UI owner, after its normal update. It never
; fabricates a menu state, camera pause byte, controller mode or scene load.
_gz_snapshot_ui_step:
    stwu r1,-0x30(r1)
    mflr r0
    stw r0,0x34(r1)
    stmw r29,0x24(r1)
    mr r31,r3
    lis r30,_gz_snapshot_ui_pending@ha
    addi r30,r30,_gz_snapshot_ui_pending@l
    lwz r8,0(r30)
    cmpwi r8,0
    beq _gz_snapshot_ui_done
    lis r8,_gz_world_resume_failed@ha
    lwz r8,_gz_world_resume_failed@l(r8)
    cmpwi r8,0
    bne _gz_snapshot_ui_cancel
    lis r8,_gz_world_resume_pending@ha
    lwz r8,_gz_world_resume_pending@l(r8)
    cmpwi r8,0
    bne _gz_snapshot_ui_done
    lis r8,_gz_route_active@ha
    lwz r8,_gz_route_active@l(r8)
    cmpwi r8,0
    bne _gz_snapshot_ui_done
    lis r8,_gz_loading_store@ha
    lbz r8,_gz_loading_store@l(r8)
    cmpwi r8,0
    bne _gz_snapshot_ui_done
    lis r8,_gz_state@ha
    lwz r8,_gz_state@l(r8)
    cmpwi r8,0
    bne _gz_snapshot_ui_done
    lis r8,_gz_tools_flags@ha
    lwz r8,_gz_tools_flags@l(r8)
    andi. r8,r8,32
    bne _gz_snapshot_ui_cancel
    lis r8,_gz_ps_ui_state_root@ha
    lwz r8,_gz_ps_ui_state_root@l(r8)
    cmpw r8,r31
    bne _gz_snapshot_ui_cancel
    andi. r8,r31,3
    bne _gz_snapshot_ui_cancel
    lis r8,0x1000
    cmplw r31,r8
    blt _gz_snapshot_ui_cancel
    lis r8,0xBFFF
    cmplw r31,r8
    bge _gz_snapshot_ui_cancel
    lis r8,_gz_mss_frame_counter@ha
    lwz r8,_gz_mss_frame_counter@l(r8)
    lwz r9,12(r30)
    subf r8,r9,r8
    cmplwi r8,180
    bgt _gz_snapshot_ui_cancel
    lwz r29,12(r31)
    lwz r8,4(r30)
    cmpwi r8,0
    beq _gz_snapshot_ui_want_play
    cmpwi r8,1
    bne _gz_snapshot_ui_cancel
    lis r8,_gz_ps_play@ha
    addi r8,r8,_gz_ps_play@l
    cmpw r29,r8
    bne _gz_snapshot_ui_wait_menu
    addi r3,r31,0x10
    lis r4,_gz_ps_to_menu@ha
    addi r4,r4,_gz_ps_to_menu@l
    bl _gz_ps_change_state
    b _gz_snapshot_ui_done
_gz_snapshot_ui_wait_menu:
    lis r8,_gz_ps_menu@ha
    addi r8,r8,_gz_ps_menu@l
    cmpw r29,r8
    bne _gz_snapshot_ui_done
    lis r8,_gz_snapshot_native_pause@ha
    lbz r8,_gz_snapshot_native_pause@l(r8)
    cmpwi r8,1
    bne _gz_snapshot_ui_done
    lwz r9,8(r30)
    cmplwi r9,2
    bgt _gz_snapshot_ui_cancel
    lwz r8,0x224(r31)
    cmpw r8,r9
    bne _gz_snapshot_ui_select_tab
    lwz r8,0x228(r31)
    cmpw r8,r9
    beq _gz_snapshot_ui_cancel
    b _gz_snapshot_ui_done
_gz_snapshot_ui_select_tab:
    ; Let an already running native tab transition finish first.
    lwz r10,0x228(r31)
    cmpw r8,r10
    bne _gz_snapshot_ui_done
    lwz r3,0x184(r31)
    andi. r8,r3,3
    bne _gz_snapshot_ui_cancel
    lis r8,0x1000
    cmplw r3,r8
    blt _gz_snapshot_ui_cancel
    lis r8,0xBFFF
    cmplw r3,r8
    bge _gz_snapshot_ui_cancel
    stw r9,0x60(r3)
    mr r3,r31
    bl _gz_ps_native_select_tab
    b _gz_snapshot_ui_done
_gz_snapshot_ui_want_play:
    lis r8,_gz_ps_play@ha
    addi r8,r8,_gz_ps_play@l
    cmpw r29,r8
    bne _gz_snapshot_ui_close_menu
    lis r8,_gz_snapshot_native_pause@ha
    lbz r8,_gz_snapshot_native_pause@l(r8)
    cmpwi r8,0
    beq _gz_snapshot_ui_cancel
    b _gz_snapshot_ui_done
_gz_snapshot_ui_close_menu:
    lis r8,_gz_ps_menu@ha
    addi r8,r8,_gz_ps_menu@l
    cmpw r29,r8
    bne _gz_snapshot_ui_done
    addi r3,r31,0x10
    lis r4,_gz_ps_to_play@ha
    addi r4,r4,_gz_ps_to_play@l
    bl _gz_ps_change_state
    b _gz_snapshot_ui_done
_gz_snapshot_ui_cancel:
    li r8,0
    stw r8,0(r30)
_gz_snapshot_ui_done:
    lmw r29,0x24(r1)
    lwz r0,0x34(r1)
    mtlr r0
    addi r1,r1,0x30
    blr
.align 4
_gz_snapshot_ui_pending:
.int 0,0,0,0

; r3=current Link; r4=existing 8192-byte player component. Gravity and
; max-fall-speed are native actor fields374/378. Acch flags834 and ground
; height8A0 are documented native scalars; no collision owner is copied.
_gz_player_motion_capture:
    lwz r8,0x374(r3)
    stw r8,4612(r4)
    lwz r8,0x378(r3)
    stw r8,4616(r4)
    lwz r8,0x834(r3)
    stw r8,4620(r4)
    lwz r8,0x8A0(r3)
    stw r8,4624(r4)
    lis r8,0x4149
    ori r8,r8,0x5231
    stw r8,4608(r4)
    blr
_gz_player_motion_apply:
    lwz r8,4608(r4)
    lis r9,0x4149
    ori r9,r9,0x5231
    cmpw r8,r9
    bnelr
    lwz r8,4612(r4)
    stw r8,0x374(r3)
    lwz r8,4616(r4)
    stw r8,0x378(r3)
    lwz r8,4620(r4)
    stw r8,0x834(r3)
    lwz r8,4624(r4)
    stw r8,0x8A0(r3)
    blr

