; Verified EUR phase-table slot 3 originally points to 0x025B1550.
; Runs after outgoing scene deletion and before destination archive creation.
.origin = 0x101EAC70
.int _gz_route_phase_hook
.origin = codecave
_gz_route_phase_hook:
    stwu r1, -0x20(r1)
    mflr r0
    stw r0, 0x24(r1)
    stw r3, 8(r1)
    bl _gz_stone_birth_new_epoch
    bl _gz_route_apply_phase
    bl _gz_fmi_seed_c
    bl _gz_world_clear_animation_trace
    lwz r3, 8(r1)
    bl _gz_native_phase1
    lwz r0, 0x24(r1)
    mtlr r0
    addi r1, r1, 0x20
    blr
0x025B1550 = _gz_native_phase1:
_gz_route_apply_phase:
    stwu r1, -0x20(r1)
    mflr r0
    stw r0, 0x24(r1)
    lis r8, _gz_route_active@ha
    addi r8, r8, _gz_route_active@l
