    li r8, 1
    slw r8, r8, r9
    lwz r9, 0x90(r28)
    andc r9, r9, r8
    stw r9, 0x90(r28)
    b _gz_inv_apply_done
_gz_bag_add:
    lwz r9, 20(r30)
    add r10, r28, r9
    li r8, 0
    li r12, -1
_gz_bag_add_scan:
    lbzx r9, r10, r8
    cmpw r9, r31
    bne _gz_inv_far_67
    b _gz_bag_grant
_gz_inv_far_67:
    cmpwi r9, 255
    beq _gz_inv_far_68
    b _gz_bag_add_next
_gz_inv_far_68:
    cmpwi r12, -1
    beq _gz_inv_far_69
    b _gz_bag_add_next
_gz_inv_far_69:
    mr r12, r8
_gz_bag_add_next:
    addi r8, r8, 1
    cmpwi r8, 8
    bge _gz_inv_far_70
    b _gz_bag_add_scan
_gz_inv_far_70:
    cmpwi r12, -1
    beq _gz_inv_far_71
    b _gz_bag_add_store
_gz_inv_far_71:
    li r8, 1
    lis r9, _gz_bag_full@ha
    stw r8, _gz_bag_full@l(r9)
    b _gz_inv_apply_done
_gz_bag_add_store:
    stbx r31, r10, r12
_gz_bag_grant:
    lwz r9, 28(r30)
    add r10, r28, r9
    lwz r8, 32(r30)
    stb r8, 0x3C(r10)
    lbz r8, 0x51(r10)
    ori r8, r8, 1
    stb r8, 0x51(r10)
    lwz r8, 16(r30)
    cmpwi r8, 0
    beq _gz_inv_far_72
    b _gz_inv_apply_done
_gz_inv_far_72:
    addi r9, r31, -140
    li r8, 1
    slw r8, r8, r9
    lwz r9, 0x90(r28)
    or r9, r9, r8
    stw r9, 0x90(r28)
    b _gz_inv_apply_done
_gz_inv_apply_done:
    lmw r27, 0x1C(r1)
    lwz r0, 0x34(r1)
    mtlr r0
    addi r1, r1, 0x30
    blr

; r3 descriptor, r4 save base. Return current progression level in r3.
_gz_inv_level:
    lwz r8, 0(r3)
    cmpwi r8, 4
    beq _gz_inv_far_73
    b _gz_inv_level_regular
_gz_inv_far_73:
    li r3, 1
    blr
_gz_inv_level_regular:
    lwz r9, 4(r3)
    add r9, r4, r9
    cmpwi r8, 0
    beq _gz_inv_far_74
    b _gz_inv_level_equipment
_gz_inv_far_74:
    lbz r10, 0x3C(r9)
    b _gz_inv_level_search
_gz_inv_level_equipment:
    lbz r10, 0xE(r9)
_gz_inv_level_search:
    lwz r11, 8(r3)
    lwz r12, 12(r3)
    li r3, 0
_gz_inv_level_loop:
    lwz r8, 0(r12)
    cmpw r8, r10
    beqlr
    addi r3, r3, 1
    addi r12, r12, 8
    cmpw r3, r11
    bge _gz_inv_far_75
    b _gz_inv_level_loop
_gz_inv_far_75:
    ; Other bottle contents still mean an owned bottle.
    cmpwi r10, 255
    li r3, 0
    beqlr
    li r3, 1
    blr

; r3 full 64x64 native RGBA8, r4/r5 canvas position; preserve r29.
; Full eight-bit alpha retains the native antialiased edges. No color
; quantization, per-pixel gamma calculation, or palette lookup at draw time.
_gz_inv_blit:
    lwz r12, 12(r29)
    mulli r5, r5, 5120
    slwi r4, r4, 2
    add r12, r12, r5
    add r12, r12, r4
    li r8, 64
_gz_inv_blit_row:
    li r9, 64
    mr r10, r12
_gz_inv_blit_pixel:
    lwz r11, 0(r3)
    addi r3, r3, 4
    andi. r0, r11, 255
    beq _gz_inv_blit_next
    stw r11, 0(r10)
_gz_inv_blit_next:
    addi r10, r10, 4
    addi r9, r9, -1
    cmpwi r9, 0
    bne _gz_inv_blit_pixel
    addi r12, r12, 5120
    addi r8, r8, -1
    cmpwi r8, 0
    bne _gz_inv_blit_row
    blr

_gz_inventory_draw:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    lis r8, _gz_page@ha
    lwz r8, _gz_page@l(r8)
    cmpwi r8, 12
    bne _gz_refill_not_draw
    b _gz_refill_draw
_gz_refill_not_draw:
    cmpwi r8, 9
    blt _gz_inv_far_80
    b _gz_spoils_draw
_gz_inv_far_80:
    li r3, 2
    li r4, 120
    li r5, 128
    lis r6, _gz_inventory_title@ha
    addi r6, r6, _gz_inventory_title@l
    bl _gz_inv_text_shadow
    bl _gz_route_heap_check
    cmpwi r3, 0
    beq _gz_inv_far_81
    b _gz_inv_draw_done
_gz_inv_far_81:
    lis r8, _gz_route_heap@ha
    lwz r28, _gz_route_heap@l(r8)
    lwz r26, 8(r29)
    li r27, 0
_gz_inv_draw_cell:
    mulli r8, r27, 20
    lis r30, _gz_inv_records@ha
    addi r30, r30, _gz_inv_records@l
    add r30, r30, r8
    mr r3, r30
    mr r4, r28
    bl _gz_inv_level
    slwi r8, r3, 3
    lwz r9, 12(r30)
    add r9, r9, r8
    lwz r3, 4(r9)
    li r9, 6
    divwu r31, r27, r9
    mulli r8, r31, 6
    subf r8, r8, r27
    mulli r4, r8, 100
    addi r4, r4, 120
    mulli r5, r31, 90
    addi r5, r5, 195
    bl _gz_inv_blit
    cmpw r26, r27
    beq _gz_inv_far_82
    b _gz_inv_draw_next
_gz_inv_far_82:
    li r9, 6
    divwu r31, r27, r9
    mulli r8, r31, 6
    subf r8, r8, r27
    mulli r4, r8, 100
    addi r4, r4, 100
    mulli r5, r31, 90
    addi r5, r5, 214
    lis r6, _gz_marker@ha
    addi r6, r6, _gz_marker@l
    bl _gz_inv_cursor
    mr r3, r30
    mr r4, r28
    bl _gz_inv_level
    slwi r9, r3, 2
    slwi r8, r27, 2
    lis r6, _gz_inv_stage_labels@ha
    addi r6, r6, _gz_inv_stage_labels@l
    lwzx r6, r6, r8
    lwzx r6, r6, r9
    li r4, 120
    li r5, 635
    bl _gz_inv_text_small
_gz_inv_draw_next:
    addi r27, r27, 1
    cmpwi r27, 24
    bge _gz_inv_far_83
    b _gz_inv_draw_cell
_gz_inv_far_83:
    lis r3, _gz_inv_icon_heart@ha
    addi r3, r3, _gz_inv_icon_heart@l
    li r4, 810
    li r5, 210
    bl _gz_inv_blit
    lis r6, _gz_inv_health_name@ha
    addi r6, r6, _gz_inv_health_name@l
    li r4, 885
    li r5, 210
    bl _gz_inv_text_small
    lhz r3, 2(r28)
    bl _gz_inv_hearts_text
    li r4, 885
    li r5, 244
    bl _gz_inv_text_small
    lis r3, _gz_inv_icon_container@ha
    addi r3, r3, _gz_inv_icon_container@l
    li r4, 810
    li r5, 340
    bl _gz_inv_blit
    lis r6, _gz_inv_max_name@ha
    addi r6, r6, _gz_inv_max_name@l
    li r4, 885
    li r5, 340
    bl _gz_inv_text_small
    lhz r3, 0(r28)
    srwi r3, r3, 2
    bl _gz_decimal
    li r4, 885
    li r5, 374
    bl _gz_inv_text_small
    bl _gz_inventory_magic_draw
    lis r6, _gz_inv_help@ha
    addi r6, r6, _gz_inv_help@l
    li r4, 120
    li r5, 675
    bl _gz_inv_text_small
    cmpwi r26, 24
    bge _gz_inv_far_84
    b _gz_inv_draw_done
_gz_inv_far_84:
    lis r6, _gz_marker@ha
    addi r6, r6, _gz_marker@l
    li r4, 790
    li r5, 230
    cmpwi r26, 24
    bne _gz_inv_far_85
    b _gz_inv_health_marker
_gz_inv_far_85:
    li r5, 360
    cmpwi r26, 26
    bne _gz_inv_health_marker
    li r5, 490
_gz_inv_health_marker:
    bl _gz_inv_cursor
_gz_inv_draw_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr
_gz_refill_draw:
    lis r6, _gz_refill_title@ha
    addi r6, r6, _gz_refill_title@l
    li r3, 2
    li r4, 120
    li r5, 128
    bl _gz_inv_text_shadow
    lwz r26, 8(r29)
    li r27, 0
_gz_refill_draw_row:
    lis r8, _gz_refill_icons@ha
    addi r8, r8, _gz_refill_icons@l
    slwi r9, r27, 2
    lwzx r3, r8, r9
    li r4, 150
    mulli r5, r27, 70
    addi r5, r5, 212
    bl _gz_inv_blit
    lis r8, _gz_refill_names@ha
    addi r8, r8, _gz_refill_names@l
    slwi r9, r27, 2
    lwzx r6, r8, r9
    li r4, 235
    mulli r5, r27, 70
    addi r5, r5, 230
    bl _gz_inv_text_small
    cmpw r26, r27
    bne _gz_refill_draw_next
    lis r6, _gz_marker@ha
    addi r6, r6, _gz_marker@l
    li r4, 120
    mulli r5, r27, 70
    addi r5, r5, 230
    bl _gz_inv_cursor
_gz_refill_draw_next:
    addi r27, r27, 1
    cmpwi r27, 4
    blt _gz_refill_draw_row
    lis r6, _gz_refill_help@ha
    addi r6, r6, _gz_refill_help@l
    li r4, 120
    li r5, 635
    bl _gz_inv_text_small
    lis r6, _gz_refill_shortcuts_help@ha
    addi r6, r6, _gz_refill_shortcuts_help@l
    li r4, 120
    li r5, 675
    bl _gz_inv_text_small
    b _gz_inv_draw_done
.align 4
