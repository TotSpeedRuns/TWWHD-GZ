_gz_widget_skip239:
    b _gz_join_label
_gz_join_value:
    lbz r9, 0(r4)
    cmpwi r9, 0
    bne _gz_widget_skip240
    b _gz_join_done
_gz_widget_skip240:
    stb r9, 0(r8)
    addi r4, r4, 1
    addi r8, r8, 1
    addi r10, r10, 1
    cmpwi r10, 126
