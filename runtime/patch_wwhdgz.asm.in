0x023E98BC = _gz_wind_waker_dive_continue:

.align 4
; GC's endDemoMode leaves an airborne baton procedure intact. HD additionally
; forces special-demo procedures to WAIT, preventing the first dry-storage
; cancel from leaving HUD-off/baton-out. Disable only that extra HD transition
; for a player-started TACT_WAIT while the Dry Storage practice toggle is on.
; Ground, ship, scripted-song and other event cleanup remain native.
_gz_storage_cancel_demo_exit:
    lis r11, _gz_tools_flags@ha
    lwz r11, _gz_tools_flags@l(r11)
    andi. r11, r11, 1024
    beq _gz_storage_cancel_original
    cmpwi r10, 154
    bne _gz_storage_cancel_original
    lwz r11, 0x69C0(r31)
    cmpwi r11, -1
    bne _gz_storage_cancel_original
    li r30, 0
_gz_storage_cancel_original:
    cmpwi r30, 0
    b _gz_storage_cancel_demo_continue
0x023F22B4 = b _gz_storage_cancel_demo_exit
0x023F22B8 = _gz_storage_cancel_demo_continue:

.align 4
_gz_position_return_pending:
.int 0
_gz_position_return_descriptor:
; Zero persistent patches; route loader handles the native stage transition.
; Exact pose and full orientation are restored only after arrival settles.
.int 0,0,0,0,0,0
_gz_position_return_name:
.string "Saved Position"
_gz_position_return_begin:
    stwu r1, -0x10(r1)
    mflr r0
    stw r0, 0x14(r1)
    lis r8, _gz_route_active@ha
    lwz r8, _gz_route_active@l(r8)
    cmpwi r8, 0
    bne _gz_position_return_busy
    lis r9, _gz_savedmeta@ha
    addi r9, r9, _gz_savedmeta@l
    lis r8, _gz_route_records@ha
    addi r8, r8, _gz_route_records@l
    addi r8, r8, 13580
    lwz r10, 0(r9)
    stw r10, 4(r8)
    lwz r10, 4(r9)
    stw r10, 8(r8)
    lwz r10, 36(r9)
    slwi r10, r10, 16
    lwz r11, 8(r9)
    slwi r11, r11, 8
    or r10, r10, r11
    lwz r11, 12(r9)
    or r10, r10, r11
    stw r10, 12(r8)
    lis r8, _gz_route_choice@ha
    li r10, 679
    stw r10, _gz_route_choice@l(r8)
    bl _gz_route_load
    cmpwi r3, 10
    bne _gz_position_return_done
    ; Normal route loading clears its old position slot; retain this slot.
    lis r8, _gz_state@ha
    li r10, 1
    stw r10, _gz_state@l+16(r8)
    lis r8, _gz_position_return_pending@ha
    stw r10, _gz_position_return_pending@l(r8)
    b _gz_position_return_done
_gz_position_return_busy:
    li r3, 5
_gz_position_return_done:
    lwz r0, 0x14(r1)
    mtlr r0
    addi r1, r1, 0x10
    blr

