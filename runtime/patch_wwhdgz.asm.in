.origin = codecave

; Current origin is factual only within the successfully loaded stage and room.
_gz_slot_origin_clear:
    lis r8, _gz_slot_origin_current@ha
    li r9, -1
    stw r9, _gz_slot_origin_current@l(r8)
    blr
; Picker-specific compact native font grid fits all ten rows plus two detail
; lines and footer on both1280x720 and1920x1080 targets. Same native renderer.
_gz_slot_picker_text:
    mulli r4, r4, 21
    mulli r5, r5, 32
    li r3, 2
    li r7, -256
    b _gz_font_draw_px
_gz_slot_origin_tick:
    lis r8, _gz_route_active@ha
    lwz r8, _gz_route_active@l(r8)
    cmpwi r8, 0
    bnelr
    lis r8, _gz_slot_origin_pending@ha
    lwz r8, _gz_slot_origin_pending@l(r8)
    cmpwi r8, 0
    bnelr
    lis r8, _gz_loading_store@ha
    lbz r8, _gz_loading_store@l(r8)
    cmpwi r8, 0
    bne _gz_slot_origin_clear
    lis r8, _gz_link_slot@ha
    lwz r8, _gz_link_slot@l(r8)
    lis r9, 0x1000
    cmplw r8, r9
    blt _gz_slot_origin_clear
    lis r9, 0xC000
    cmplw r8, r9
    bge _gz_slot_origin_clear
    lis r8, _gz_slot_origin_current@ha
    addi r8, r8, _gz_slot_origin_current@l
    lis r9, _gz_stage_store@ha
    addi r9, r9, _gz_stage_store@l
    lwz r10, 0(r9)
    lwz r11, 4(r8)
    cmpw r10, r11
    bne _gz_slot_origin_clear
    lwz r10, 4(r9)
    lwz r11, 8(r8)
    cmpw r10, r11
    bne _gz_slot_origin_clear
    lis r9, _gz_room_store@ha
    lbz r10, _gz_room_store@l(r9)
    lwz r11, 12(r8)
    cmpw r10, r11
    bne _gz_slot_origin_clear
    blr
; Called only from the actual completed record, never its mutable menu choice.
_gz_slot_origin_file_loaded:
    lis r8, _gz_route_active@ha
    lwz r8, _gz_route_active@l(r8)
    lis r9, _gz_route_records@ha
    addi r9, r9, _gz_route_records@l
    li r10, 0
_gz_slot_origin_find_record:
    cmpw r8, r9
    beq _gz_slot_origin_found_record
    addi r9, r9, 20
    addi r10, r10, 1
    cmpwi r10, 762
    blt _gz_slot_origin_find_record
    blr
_gz_slot_origin_found_record:
    cmpwi r10, 679
    beqlr
    cmpwi r10, 680
    beqlr
    lis r8, _gz_slot_origin_pending@ha
    addi r8, r8, _gz_slot_origin_pending@l
    stw r10, 4(r8)
    lwz r10, 4(r9)
    stw r10, 8(r8)
    lwz r10, 8(r9)
    stw r10, 12(r8)
    lwz r10, 12(r9)
    srwi r10, r10, 8
    andi. r10, r10, 255
    stw r10, 16(r8)
    li r10, 1
    stw r10, 0(r8)
    b _gz_slot_origin_clear
_gz_slot_origin_capture:
    lis r8, _gz_slot_origin_current@ha
    addi r8, r8, _gz_slot_origin_current@l
    li r7, -1
    lis r9, _gz_world_working_record@ha
    addi r9, r9, _gz_world_working_record@l
    lwz r10, 4(r9)
    lwz r11, 4(r8)
    cmpw r10, r11
    bne _gz_slot_origin_capture_commit
    lwz r10, 8(r9)
    lwz r11, 8(r8)
    cmpw r10, r11
    bne _gz_slot_origin_capture_commit
    lwz r10, 12(r9)
    srwi r10, r10, 8
    andi. r10, r10, 255
    lwz r11, 12(r8)
    cmpw r10, r11
    bne _gz_slot_origin_capture_commit
    lwz r7, 0(r8)
_gz_slot_origin_capture_commit:
    lis r8, _gz_slot_origin_captured@ha
    stw r7, _gz_slot_origin_captured@l(r8)
    blr
_gz_slot_origin_store:
    slwi r8, r3, 3
    lis r9, _gz_slot_origin_sidecars@ha
    addi r9, r9, _gz_slot_origin_sidecars@l
    add r9, r9, r8
    lis r8, _gz_slot_origin_captured@ha
    lwz r8, _gz_slot_origin_captured@l(r8)
    stw r8, 4(r9)
    .int 0x7C0004AC
    stw r4, 0(r9)
    blr
_gz_slot_origin_install:
    slwi r8, r3, 3
    lis r9, _gz_slot_origin_sidecars@ha
    addi r9, r9, _gz_slot_origin_sidecars@l
    add r9, r9, r8
    li r10, -1
    lwz r8, 0(r9)
    cmpw r8, r4
    bne _gz_slot_origin_install_commit
    lwz r10, 4(r9)
_gz_slot_origin_install_commit:
    lis r8, _gz_slot_origin_captured@ha
    stw r10, _gz_slot_origin_captured@l(r8)
