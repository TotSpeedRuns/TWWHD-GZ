_gz_td_early_continue:
    lis r9, _gz_route_active@ha
    lwz r9, _gz_route_active@l(r9)
    cmpwi r9, 0
    beq _gz_v103_bgwait_original
    lis r10, _gz_v103_spawn_trace@ha
    addi r10, r10, _gz_v103_spawn_trace@l
    lwz r11, 0(r10)
    addi r11, r11, 1
