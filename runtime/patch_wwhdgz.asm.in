; Button labels use measured bitmap ink bounds; native action panes have
; different bearings and must not reposition these fixed controller labels.
_gz_pad_button_label:
    stwu r1, -0x20(r1)
    mflr r0
    stw r0, 0x24(r1)
    stw r4, 8(r1)
    stw r5, 12(r1)
    stw r6, 16(r1)
    lis r8, _gz_v103_input_centers@ha
    addi r8, r8, _gz_v103_input_centers@l
    li r9, 8
_gz_v103_input_center_next:
    lwz r10, 0(r8)
    cmpw r10, r6
    beq _gz_v103_input_center_found
    addi r8, r8, 12
    addi r9, r9, -1
    cmpwi r9, 0
    bne _gz_v103_input_center_next
    b _gz_v103_input_center_fallback
_gz_v103_input_center_found:
    lwz r4, 4(r8)
    lwz r5, 8(r8)
    addi r4, r4, 16
    addi r5, r5, -80
    li r3, 1
    li r7, -250
    bl _gz_native_action_queue_label
    cmpwi r3, 0
    bne _gz_v103_input_center_done
_gz_v103_input_center_fallback:
    lwz r4, 8(r1)
    lwz r5, 12(r1)
    lwz r6, 16(r1)
    addi r4, r4, 16
    addi r5, r5, -80
    li r3, 1
    li r7, -256
    bl _gz_font_draw_fill_px
_gz_v103_input_center_done:
    lwz r0, 0x24(r1)
    mtlr r0
    addi r1, r1, 0x20
    blr

_gz_pad_font_small:
    addi r4, r4, 16
    addi r5, r5, -80
    b _gz_font_small
_gz_pad_font_draw_px:
    addi r4, r4, 16
    addi r5, r5, -80
    b _gz_font_draw_px

_gz_start_toast:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    .int 0x7C000026
    stw r0, 0x08(r1)
    stw r3, 12(r1)
    stw r4, 16(r1)
    stw r5, 20(r1)
    stw r6, 24(r1)
    stw r7, 28(r1)
    stw r8, 32(r1)
    stw r9, 36(r1)
    stw r10, 40(r1)
    stw r11, 44(r1)
    stw r12, 48(r1)
    lis r3, 0x1020
    lwz r3, -0xAA8(r3)
    lis r8, _gz_toast_started@ha
    addi r8, r8, _gz_toast_started@l
    stw r3, 0(r8)
    li r9, 60 ; two seconds at the game's 30 updates per second
    lis r8, _gz_toast_duration@ha
    addi r8, r8, _gz_toast_duration@l
    stw r9, 0(r8)
    lis r8, _gz_toast_active@ha
    addi r8, r8, _gz_toast_active@l
    li r9, 1
    stw r9, 0(r8)
    lwz r3, 12(r1)
    lwz r4, 16(r1)
    lwz r5, 20(r1)
    lwz r6, 24(r1)
    lwz r7, 28(r1)
    lwz r8, 32(r1)
    lwz r9, 36(r1)
    lwz r10, 40(r1)
    lwz r11, 44(r1)
    lwz r12, 48(r1)
    lwz r0, 0x08(r1)
    .int 0x7C0FF120
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr
_gz_draw_toast:
    stwu r1, -0x10(r1)
    mflr r0
    stw r0, 0x14(r1)
    lis r8, _gz_toast_active@ha
    addi r8, r8, _gz_toast_active@l
    lwz r8, 0(r8)
    cmpwi r8, 0
    bne _gz_widget_skip261
    b _gz_toast_done
_gz_widget_skip261:
    lis r3, 0x1020
    lwz r3, -0xAA8(r3)
    lis r8, _gz_toast_started@ha
    addi r8, r8, _gz_toast_started@l
    lwz r8, 0(r8)
    subf r3, r8, r3
    lis r8, _gz_toast_duration@ha
    addi r8, r8, _gz_toast_duration@l
    lwz r8, 0(r8)
    cmplw r3, r8
    bge _gz_widget_skip262
    b _gz_toast_text
_gz_widget_skip262:
    lis r8, _gz_toast_active@ha
    addi r8, r8, _gz_toast_active@l
    li r9, 0
    stw r9, 0(r8)
    b _gz_toast_done
_gz_toast_text:
    ; Fade over the final half-second, then restore normal text opacity.
    subf r9, r3, r8
    li r10, 256
    cmplwi r9, 15
    bge _gz_toast_full_opacity
    slwi r9, r9, 8
    li r10, 15
    divwu r10, r9, r10
_gz_toast_full_opacity:
    lis r8, _gz_font_opacity@ha
    stw r10, _gz_font_opacity@l(r8)
    lis r8, _gz_status@ha
    addi r8, r8, _gz_status@l
    lwz r8, 0(r8)
    cmplwi r8, 32
    ble _gz_inplace_status_in_bounds
    li r8, 16
_gz_inplace_status_in_bounds:
    slwi r8, r8, 2
    lis r6, _gz_messages@ha
    addi r6, r6, _gz_messages@l
    lwzx r6, r6, r8
    li r4, 16
    li r5, 12
    bl _gz_font_small
    lis r8, _gz_font_opacity@ha
    li r9, 256
    stw r9, _gz_font_opacity@l(r8)
_gz_toast_done:
    lwz r0, 0x14(r1)
    mtlr r0
    addi r1, r1, 0x10
    blr
.align 4
_gz_toast_active:
.int 0
_gz_toast_started:
.int 0
_gz_toast_duration:
.int 0
_gz_font_opacity:
.int 256

_gz_draw_menu_cursor:
    lis r8, _gz_viewport@ha
    addi r8, r8, _gz_viewport@l
    lfs f0, 8(r8)
    lis r8, _gz_menu_720_width@ha
    addi r8, r8, _gz_menu_720_width@l
    lfs f1, 0(r8)
    fcmpu cr0, f0, f1
    bgt _gz_widget_skip263
