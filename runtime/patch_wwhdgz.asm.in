    addi r8, r8, -48
    cmplwi r8, 4
    bgt _gz_v103_map_island_reject
    mulli r8, r8, 10
    lbz r9, 0x8A(r3)
    addi r9, r9, -48
    cmplwi r9, 9
    bgt _gz_v103_map_island_reject
    add r8, r8, r9
    cmplwi r8, 48
    bgt _gz_v103_map_island_reject
    lbz r9, 0x8B(r3)
    cmpwi r9, 0
    bne _gz_v103_map_island_reject
    mulli r8, r8, 48
    lis r9, _gz_v103_map_island_matrices@ha
    addi r9, r9, _gz_v103_map_island_matrices@l
    add r9, r9, r8
    li r8, 0
