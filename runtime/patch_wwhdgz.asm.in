; Native shared map init/update require the parent data binding at +4B8.
; Cross-area memfile loads may leave a previously selected Map view alive
; before its new parent has bound that data. Defer that view while unbound.
; Resume the exact original prologue for every bound instance. No fake map
; data, inventory flags, UI state transitions, or actor payload changes.
.origin = codecave
_gz_map_bound_init:
    lwz r0, 0x4B8(r3)
    cmpwi r0, 0
    beqlr
    mflr r0
    b _gz_map_bound_init_resume
_gz_map_bound_update:
    lwz r0, 0x4B8(r3)
    cmpwi r0, 0
    beqlr
    mflr r0
    b _gz_map_bound_update_resume
