.align 4
_gz_controller_labels:
.int _gz_controller_gp,_gz_controller_p1,_gz_controller_p2,_gz_controller_p3,_gz_controller_p4,_gz_controller_none
_gz_controller_gp:
.string "GamePad"
_gz_controller_p1:
.string "Pro 1"
_gz_controller_p2:
.string "Pro 2"
_gz_controller_p3:
.string "Pro 3"
_gz_controller_p4:
