_gz_controller_label:
    stwu r1, -0x10(r1)
    mflr r0
    stw r0, 0x14(r1)
    lis r8, _gz_controller_state@ha
    addi r8, r8, _gz_controller_state@l
    lwz r8, 0(r8)
