    add r5, r5, r28
    slwi r6, r26, 4
    addi r6, r6, 0x5898
    add r6, r6, r28
    mr r3, r28
    bl _gz_resource_bind_sound
_gz_resource_sound_done:
    li r26, 0
    addi r30, r31, 4528
_gz_resource_apply_frame:
    slwi r8, r26, 2
    addi r8, r8, 4516
    lwzx r3, r31, r8
    mr r4, r30
    li r5, 12
    bl _gz_player_copy_bytes
    addi r30, r30, 12
    addi r26, r26, 1
    cmpwi r26, 3
    blt _gz_resource_apply_frame
    lwz r8, 4564(r31)
    lis r9, 0x101D
    stw r8, -4328(r9)
    ; Resource constructors may alter scalars, so reapply their saved values.
    lis r26, _gz_player_field_table@ha
    addi r26, r26, _gz_player_field_table@l
    addi r30, r31, 3200
_gz_resource_apply_scalar:
