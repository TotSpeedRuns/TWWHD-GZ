_gz_spoils_draw:
    addi r8, r8, -9
    mulli r8, r8, 36
    lis r26, _gz_bag_descriptors@ha
    addi r26, r26, _gz_bag_descriptors@l
    add r26, r26, r8
    lwz r6, 0(r26)
    li r3, 2
