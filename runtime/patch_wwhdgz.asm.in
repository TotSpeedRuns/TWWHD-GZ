_gz_user_totg_arrival_range:
    lis r3, _gz_route_choice@ha
    lwz r3, _gz_route_choice@l(r3)
    cmplwi r3, 681
    blt _gz_v103_story_arrival_other
    cmplwi r3, 761
    ble _gz_user_totg_arrival_scene_selected
_gz_v103_story_arrival_other:
