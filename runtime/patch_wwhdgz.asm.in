_gz_route_finish_result:
    bl _gz_slot_origin_result
    lis r8, _gz_status@ha
    addi r8, r8, _gz_status@l
    stw r3, 0(r8)
    bl _gz_start_toast
    lis r8, _gz_route_active@ha
    addi r8, r8, _gz_route_active@l
    li r10, 0
    stw r10, 0(r8)
_gz_route_finish_done:
    lwz r0, 0x24(r1)
    mtlr r0
    addi r1, r1, 0x20
    blr
.align 4
_gz_route_selection:
.int 0
_gz_route_phase_applied:
.int 0
_gz_area_selection:
