    addi r31, r31, _gz_life_phase@l
    lwz r8, 0(r31)
    cmpwi r8, 4
    beq _gz_life_main_bad
    cmpwi r8, 3
    bne _gz_life_main_return
    bl _gz_life_generic_matches
    cmpwi r3, 1
    bne _gz_life_main_bad
    ; A changed player/event is not allowed to enter the commit step.
    bl _gz_live_check
    cmpwi r3, 0
    bne _gz_life_main_bad
    mr r3, r11
    bl _gz_player_preflight
    cmpwi r3, 0
    bne _gz_life_main_bad
    lis r8, 0x1047
    lbz r8, 0x4342(r8)
