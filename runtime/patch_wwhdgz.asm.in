.origin = codecave
_gz_slots_open:
    lis r8, _gz_slots_notice@ha
    li r9, 0
    stw r9, _gz_slots_notice@l(r8)
    lis r8, _gz_slots_mode@ha
    stw r3, _gz_slots_mode@l(r8)
    lis r8, _gz_state@ha
    li r9, 1
    stw r9, _gz_state@l(r8)
    lis r8, _gz_page@ha
    li r9, 100
    stw r9, _gz_page@l(r8)
    blr
_gz_slots_close:
    li r9, 0
    lis r8, _gz_slots_mode@ha
    stw r9, _gz_slots_mode@l(r8)
    lis r8, _gz_state@ha
    stw r9, _gz_state@l(r8)
    stw r9, _gz_state@l+8(r8)
    lis r8, _gz_page@ha
    stw r9, _gz_page@l(r8)
    lis r8, _gz_slots_notice@ha
    stw r9, _gz_slots_notice@l(r8)
    blr

_gz_slots_modal_input:
    lwz r10, 0x10(r1)
    andi. r11, r10, 0x4000
    beq _gz_slots_modal_move
    bl _gz_slots_close
    b _gz_mask
_gz_slots_modal_move:
    andi. r9, r10, 0x0300
    beq _gz_slots_modal_notice_ready
    lis r11, _gz_slots_notice@ha
    li r9, 0
    stw r9, _gz_slots_notice@l(r11)
_gz_slots_modal_notice_ready:
    lis r11, _gz_slots_selected@ha
    lwz r12, _gz_slots_selected@l(r11)
    andi. r9, r10, 0x0200
    beq _gz_slots_modal_down
    addi r12, r12, -1
    cmpwi r12, 0
    bge _gz_slots_modal_down
    li r12, 9
_gz_slots_modal_down:
    andi. r9, r10, 0x0100
    beq _gz_slots_modal_select
    addi r12, r12, 1
    cmpwi r12, 9
    ble _gz_slots_modal_select
    li r12, 0
_gz_slots_modal_select:
    stw r12, _gz_slots_selected@l(r11)
    andi. r9, r10, 0x8000
    bne _gz_slots_modal_accept
    b _gz_mask
_gz_slots_modal_accept:
    lis r11, _gz_slots_mode@ha
    lwz r9, _gz_slots_mode@l(r11)
    cmpwi r9, 1
    bne _gz_slots_modal_restore
    li r12, 10
    b _gz_slots_modal_queue
_gz_slots_modal_restore:
    lis r11, _gz_slots_selected@ha
    lwz r9, _gz_slots_selected@l(r11)
    slwi r9, r9, 2
    lis r11, _gz_slots_ptrs@ha
    addi r11, r11, _gz_slots_ptrs@l
    lwzx r9, r11, r9
    cmpwi r9, 0
    bne _gz_slots_modal_restore_ready
    lis r11, _gz_pending@ha
    li r9, 12
    stw r9, _gz_pending@l(r11)
    b _gz_mask
_gz_slots_modal_restore_ready:
    li r12, 11
_gz_slots_modal_queue:
    lis r11, _gz_pending@ha
    stw r12, _gz_pending@l(r11)
    bl _gz_slots_close
    b _gz_mask

_gz_slots_save_choice_frame:
    lis r3, _gz_slots_selected@ha
    lwz r3, _gz_slots_selected@l(r3)
    bl _gz_slots_store
    b _gz_frame_result
_gz_slots_restore_choice_frame:
    lis r3, _gz_slots_selected@ha
    lwz r3, _gz_slots_selected@l(r3)
    bl _gz_slots_install
    cmpwi r3, 0
    beq _gz_slots_restore_installed
    b _gz_frame_result
_gz_slots_restore_installed:
    b _gz_slots_restore_single_frame
_gz_slots_empty_choice_frame:
    lis r8, _gz_slots_notice@ha
    li r9, 1
    stw r9, _gz_slots_notice@l(r8)
    b _gz_frame_done
