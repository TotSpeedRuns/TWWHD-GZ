_gz_gamepad_backdrop:
    lis r3, _gz_pad_art@ha
    addi r3, r3, _gz_pad_art@l
    lis r4, _gz_state@ha
    addi r4, r4, _gz_state@l
    lwz r4, 12(r4)
    lis r5, 0x1F
    ori r5, r5, 0x4F30
    add r4, r4, r5
    li r5, 688
_gz_pad_back_row:
    lwz r7, 0(r3)
    lwz r6, 4(r3)
    add r7, r7, r4
    addi r3, r3, 8
    lis r8, 0xE6EB
    ori r8, r8, 0xF0D2
_gz_pad_back_pixel:
