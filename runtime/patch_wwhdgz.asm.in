    lis r8, _gz_route_heap@ha
    lwz r28, _gz_route_heap@l(r8)
    lwz r27, 8(r29)
    srwi r27, r27, 3
    slwi r27, r27, 3
    li r30, 0
_gz_spoils_draw_row:
    lwz r8, 4(r26)
    cmpw r27, r8
    blt _gz_inv_far_87
    b _gz_bag_draw_help
_gz_inv_far_87:
    slwi r8, r27, 2
    lwz r6, 8(r26)
    lwzx r6, r6, r8
    li r4, 140
    mulli r5, r30, 48
    addi r5, r5, 195
    bl _gz_inv_text_small
    lwz r8, 16(r26)
    cmpwi r8, 0
    bne _gz_inv_far_88
    b _gz_delivery_draw_status
_gz_inv_far_88:
    add r8, r28, r8
    lbzx r3, r8, r27
    b _gz_bag_draw_number
_gz_delivery_draw_status:
    slwi r8, r27, 2
    lwz r9, 12(r26)
    lwzx r9, r9, r8
    addi r9, r9, -140
    lwz r3, 0x90(r28)
    srw r3, r3, r9
    andi. r3, r3, 1
_gz_bag_draw_number:
    bl _gz_decimal
    li r4, 600
    mulli r5, r30, 48
    addi r5, r5, 195
    bl _gz_inv_text_small
    lwz r8, 8(r29)
    cmpw r8, r27
    beq _gz_inv_far_89
