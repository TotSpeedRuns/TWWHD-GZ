_gz_world_clear_animation_trace:
    ; Room transitions can retain actors. Prune only IDs absent from the
    ; native live queue; never discard a retained actor's accepted setter.
    lis r8, _gz_world_bokoblin_animation_observed@ha
    addi r8, r8, _gz_world_bokoblin_animation_observed@l
