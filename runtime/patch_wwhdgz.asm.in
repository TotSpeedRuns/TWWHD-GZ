_gz_route_preclock_done:
    bl _gz_il_route_begin_observe
    bl _gz_td_begin
    bl _gz_pa_begin
    bl _gz_it_begin
    bl _gz_mc_begin
    bl _gz_fm_begin_c
    bl _gz_world_prepare_file_lights
    bl _gz_clear_damage_restart
    lis r9, _gz_route_active@ha
    addi r9, r9, _gz_route_active@l
    lwz r9, 0(r9)
    lis r8, _gz_next_store@ha
    addi r8, r8, _gz_next_store@l
    lwz r10, 4(r9)
    stw r10, 0(r8)
    lwz r10, 8(r9)
    stw r10, 4(r8)
    lwz r10, 12(r9)
    lis r11, _gz_route_choice@ha
    lwz r11, _gz_route_choice@l(r11)
    cmplwi r11, 691
    bne _gz_fm_entrance_request_ready
    ; Owned sea_Room20 PLYR0: 181100,0,-122800. Transient request only.
    rlwinm r10, r10, 0, 16, 31
_gz_fm_entrance_request_ready:
    stw r10, 8(r8)
    li r10, 0
    stb r10, 13(r8)
    .int 0x7C0004AC
    li r10, 1
    stb r10, 12(r8)
    lis r8, _gz_route_seen_loading@ha
    addi r8, r8, _gz_route_seen_loading@l
    stw r10, 0(r8)
    lis r9, _gz_state@ha
    addi r9, r9, _gz_state@l
    li r10, 0
    stw r10, 0(r9)
    li r10, 3
    stw r10, 8(r9)
    lis r9, _gz_page@ha
    addi r9, r9, _gz_page@l
    li r10, 0
    stw r10, 0(r9)
    li r3, 10
    b _gz_route_done
_gz_route_busy:
    li r3, 5
    b _gz_route_done
_gz_route_bad:
    li r3, 7
_gz_route_done:
    lwz r0, 0x24(r1)
    mtlr r0
    addi r1, r1, 0x20
    blr

_gz_route_heap_check:
    lis r8, _gz_heap_slot@ha
    addi r8, r8, _gz_heap_slot@l
    lwz r8, 0(r8)
    lis r9, 0x1000
    cmplw r8, r9
    bge _gz_widget_skip121
