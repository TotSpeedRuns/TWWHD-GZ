.origin = codecave
; Common fopAc header, verified native profile sizes and class tag.
; Unknown positive-health actors require their own AI/collision/resource schema.
_gz_enemy_coverage_check:
    stwu r1, -0x30(r1)
    stmw r26, 8(r1)
    lis r8, _gz_enemy_coverage_missing@ha
    li r9, -1
    stw r9, _gz_enemy_coverage_missing@l(r8)
    lis r8, _gz_inplace_enabled@ha
    lwz r8, _gz_inplace_enabled@l(r8)
    cmpwi r8, 0
    beq _gz_enemy_coverage_ok
    lis r8, 0x1047
    lwz r28, 0x4BE4(r8)
    lis r8, 0x101F
    lwz r26, 0x3328(r8)
    li r27, 4096
_gz_enemy_coverage_loop:
    cmpwi r26, 0
    beq _gz_enemy_coverage_ok
    addi r27, r27, -1
    cmpwi r27, 0
    blt _gz_enemy_coverage_bad
    lis r8, 0x1000
    cmplw r26, r8
    blt _gz_enemy_coverage_bad
    lis r8, 0xC000
    cmplw r26, r8
    bge _gz_enemy_coverage_bad
    lwz r29, 12(r26)
    cmpwi r29, 0
    beq _gz_enemy_coverage_next
    cmpw r29, r28
    beq _gz_enemy_coverage_next
    lis r8, 0x1000
    cmplw r29, r8
    blt _gz_enemy_coverage_bad
    lis r8, 0xC000
    cmplw r29, r8
