; Off -> Positive -> Negative -> Off. All other tool flags are preserved.
_gz_upcharge_cycle:
    lis r9, _gz_tools_flags@ha
    addi r9, r9, _gz_tools_flags@l
    lwz r10, 0(r9)
    lis r11, _gz_upcharge_direction@ha
    addi r11, r11, _gz_upcharge_direction@l
    andi. r0, r10, 8
    beq _gz_upcharge_cycle_positive
    lwz r0, 0(r11)
    cmpwi r0, 0
    beq _gz_upcharge_cycle_negative
    li r0, -9
    and r10, r10, r0
    li r0, 0
    b _gz_upcharge_cycle_store
_gz_upcharge_cycle_positive:
    ori r10, r10, 8
    li r0, 0
    b _gz_upcharge_cycle_store
_gz_upcharge_cycle_negative:
    li r0, 1
_gz_upcharge_cycle_store:
    stw r0, 0(r11)
    stw r10, 0(r9)
    b _gz_mask
_gz_upcharge_direction_label:
    lis r9, _gz_upcharge_direction@ha
    lwz r9, _gz_upcharge_direction@l(r9)
    lis r6, _gz_upcharge_positive@ha
    addi r6, r6, _gz_upcharge_positive@l
    cmpwi r9, 1
    beq _gz_upcharge_negative_label
    b _gz_tool_draw_toggle
_gz_upcharge_negative_label:
    lis r6, _gz_upcharge_negative@ha
    addi r6, r6, _gz_upcharge_negative@l
    b _gz_tool_draw_toggle

; Timer-only native HUD. Called before allocating/acquiring a CPU canvas.
; r29 = GZ state, r30 = target color buffer, r31 = scan target.
; Return1 only after a native label has been accepted and drawn. If native
; text is unavailable, use the existing complete canvas fallback unchanged.
.origin = codecave
