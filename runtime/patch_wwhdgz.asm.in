.int _gz_bomb2_create_phase,_gz_bomb2_base_only
_gz_bomb2_base_only:
.int 0
_gz_bomb2_create_phase:
.int 0,0,0,0,0

.origin = codecave
_gz_foliage_capture:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
