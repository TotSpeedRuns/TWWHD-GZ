    cmplwi r8, 329
    beq _gz_v103_floor_bgwait_selected
    cmplwi r8, 552
    beq _gz_v103_floor_bgwait_selected
    cmplwi r8, 562
    beq _gz_v103_floor_bgwait_selected
    cmplwi r8, 573
