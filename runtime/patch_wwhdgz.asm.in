[WWHDGZ_EUR]
moduleMatches = 0xb7e748de

; Independently written prototype. Original call sites verified against EUR RPX.
; GamePad only. Same-room restore updates live Link pose/momentum, not persistent save data.
.origin = codecave
_gz_state:
.int 0, 0, 0, 0, 0, 0
; open, chord held, selection, framebuffer, saved flag, saved X/Y/Z/angle
_gz_saved:
.int 0, 0, 0, 0
_gz_number:
.int 0, 0, 0, 0
_gz_title:
.string "TWWHD-GZ"
_gz_controls:
.string "Up/Down: select   A: choose   B: back/close"
_gz_live:
.string "Stage:"
_gz_xyz:
.string "Position (rounded):"
_gz_x:
.string "X:"
_gz_y:
.string "Y:"
_gz_z:
.string "Z:"
_gz_save:
.string "Save position"
_gz_restore:
.string "Restore position"
_gz_close:
.string "Close menu"
_gz_marker:
.string ">"
_gz_saved_msg:
.string "Position saved"
_gz_note:
.string "Live gameplay - sticks locked while open."
.align 4
_gz_prevhold:
.int 0

_gz_vpad:
    stwu r1, -0x30(r1)
    mflr r0
    stw r0, 0x34(r1)
    stw r30, 0x28(r1)
    stw r31, 0x2C(r1)
    mr r31, r4
    stw r31, 0x24(r1)
    stw r5, 0x10(r1)
    stw r6, 0x1C(r1)
    li r9, 0
    stw r9, 0x20(r1)
    stw r3, 0x14(r1)
    bl import.vpad.VPADRead
    mr r30, r3
    cmpwi r3, 0
    bgt _gz_widget_skip1
    b _gz_vpad_failed
_gz_widget_skip1:
    cmpwi r31, 0
    bne _gz_widget_skip2
    b _gz_vpad_return
_gz_widget_skip2:
    lwz r3, 0x14(r1)
    cmpwi r3, 0
    beq _gz_widget_skip3
    b _gz_vpad_mask_samples
_gz_widget_skip3:
    ; VPAD may return multiple samples. Route a complete chord even when
    ; another sample is first, then mask the entire original batch.
    mr r3, r31
    mr r4, r30
    lwz r9, 0x10(r1)
    cmplw r4, r9
    ble _gz_vpad_batch_count_valid
    mr r4, r9
_gz_vpad_batch_count_valid:
    cmplwi r4, 32
    ble _gz_vpad_batch_count_bounded
    li r4, 32
_gz_vpad_batch_count_bounded:
    bl _gz_vpad_shortcut_sample
    cmpwi r3, 0
    beq _gz_vpad_use_first_sample
    mr r31, r3
_gz_vpad_use_first_sample:
    lwz r9, 0(r31)
    stw r9, 0x18(r1)
    lwz r9, 4(r31)
    stw r9, 8(r1)
    lwz r9, 8(r31)
    stw r9, 12(r1)
    li r3, 0
    mr r4, r31
    bl _gz_choose_controller
    cmpwi r3, 0
    bne _gz_widget_skip4
    b _gz_vpad_mask_samples
_gz_widget_skip4:
    li r3, 0
    mr r4, r31
    bl _gz_process_pad
    lwz r9, 0(r31)
    lwz r10, 0x18(r1)
    cmpw r9, r10
    bne _gz_widget_skip5
    lwz r9, 4(r31)
    lwz r10, 8(r1)
    cmpw r9, r10
    bne _gz_widget_skip5
    lwz r9, 8(r31)
    lwz r10, 12(r1)
    cmpw r9, r10
    bne _gz_widget_skip5
    b _gz_vpad_mask_samples
_gz_widget_skip5:
    li r9, 1
    stw r9, 0x20(r1)
_gz_vpad_mask_samples:
    lis r8, _gz_state@ha
    addi r8, r8, _gz_state@l
    lwz r8, 0(r8)
    lis r9, _gz_mht_phase@ha
    lwz r9, _gz_mht_phase@l(r9)
    or r8, r8, r9
    cmpwi r8, 0
    beq _gz_widget_skip6
    b _gz_vpad_mask_active
_gz_widget_skip6:
    lwz r8, 0x20(r1)
    cmpwi r8, 0
    bne _gz_widget_skip7
    b _gz_vpad_return
_gz_widget_skip7:
_gz_vpad_mask_active:
    li r10, 0
    lwz r11, 0x24(r1)
    mtctr r30
_gz_vpad_mask_loop:
    lwz r9, 0(r11)
    andi. r9, r9, 2
    stw r9, 0(r11)
    lwz r9, 4(r11)
    andi. r9, r9, 2
    stw r9, 4(r11)
    lwz r9, 8(r11)
    ; A release edge may be in a different sample from the routed chord.
    lis r8, _gz_shortcut_consumed@ha
    lwz r7, _gz_shortcut_consumed@l(r8)
    andc r7, r7, r9
    stw r7, _gz_shortcut_consumed@l(r8)
    andi. r9, r9, 2
    stw r9, 8(r11)
    stw r10, 12(r11)
    stw r10, 16(r11)
    stw r10, 20(r11)
    stw r10, 24(r11)
    addi r11, r11, 0xAC
    bdnz _gz_vpad_mask_loop
    b _gz_vpad_return
_gz_vpad_failed:
    lwz r8, 0x1C(r1)
    cmpwi r8, 0
    bne _gz_widget_skip8
    b _gz_vpad_return
_gz_widget_skip8:
    lwz r8, 0(r8)
    cmpwi r8, -2
    beq _gz_widget_skip9
    b _gz_vpad_return
_gz_widget_skip9:
    li r3, 0
    bl _gz_controller_disconnect
_gz_vpad_return:
    mr r3, r30
    lwz r30, 0x28(r1)
    lwz r31, 0x2C(r1)
    lwz r0, 0x34(r1)
    mtlr r0
    addi r1, r1, 0x30
    blr
_gz_process_pad:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stw r29, 0x30(r1)
    stw r30, 0x34(r1)
    stw r31, 0x38(r1)
    mr r31, r4
    stw r3, 0x14(r1)
    li r3, 1
    mr r30, r3
    cmpwi r3, 0
    bgt _gz_widget_skip10
    b _gz_input_done
_gz_widget_skip10:
    cmpwi r31, 0
    bne _gz_widget_skip11
    b _gz_input_done
_gz_widget_skip11:
    lis r29, _gz_state@ha
    addi r29, r29, _gz_state@l
    lwz r11, 0x14(r1)
    cmpwi r11, 0
    bne _gz_widget_skip12
    b _gz_primary_pad
_gz_widget_skip12:
    lwz r9, 0(r29)
    cmpwi r9, 0
    bne _gz_widget_skip13
    b _gz_input_done
_gz_widget_skip13:
    b _gz_mask
_gz_primary_pad:
    bl _gz_read_input
    lwz r8, 0(r31)
    lis r11, _gz_prevhold@ha
    addi r11, r11, _gz_prevhold@l
    lwz r10, 0(r11)
    stw r10, 0x18(r1)
    stw r8, 0(r11)
    andc r10, r8, r10
    ; Native trigger recovers a real press if release occurred between polls.
    ; Credit a trigger once per game frame so repeated VPAD/KPAD reads cannot
    ; cascade the same A press through successive menus.
    lwz r9, 4(r31)
    and r9, r9, r8
    lis r11, _gz_menu_native_edges@ha
    addi r11, r11, _gz_menu_native_edges@l
    lis r12, _gz_game_counter@ha
    lwz r12, _gz_game_counter@l(r12)
    lwz r0, 0(r11)
    cmpw r0, r12
    beq _gz_menu_native_same_frame
    stw r12, 0(r11)
    li r0, 0
    stw r0, 4(r11)
_gz_menu_native_same_frame:
    lwz r12, 4(r11)
    andc r0, r9, r12
    or r10, r10, r0
    or r12, r12, r9
    stw r12, 4(r11)
    stw r10, 0x10(r1)
    bl _gz_nav_repeat
    stw r3, 0x1C(r1)
    lis r9, _gz_slots_mode@ha
    lwz r9, _gz_slots_mode@l(r9)
    cmpwi r9, 0
    beq _gz_slots_router_continue
    b _gz_slots_modal_input
_gz_slots_router_continue:
    lis r9, _gz_rebind_mode@ha
    addi r9, r9, _gz_rebind_mode@l
    lwz r9, 0(r9)
    cmpwi r9, 0
    beq _gz_widget_skip14
    b _gz_rebind_input
_gz_widget_skip14:
    b _gz_refill_hotkey_input
_gz_refill_hotkey_continue:
    lwz r8, 0(r31)
    lis r11, _gz_bind_masks@ha
    addi r11, r11, _gz_bind_masks@l
    lwz r9, 0(r11)
    and r10, r8, r9
    cmpw r10, r9
    beq _gz_widget_skip15
    b _gz_chord_up
_gz_widget_skip15:
    lwz r9, 4(r29)
    cmpwi r9, 0
    beq _gz_widget_skip16
    b _gz_mask
_gz_widget_skip16:
    li r9, 1
    stw r9, 4(r29)
    lwz r9, 0(r29)
    xori r9, r9, 1
    stw r9, 0(r29)
    bl _gz_reopen_menu
    b _gz_mask
_gz_chord_up:
    li r9, 0
    stw r9, 4(r29)
_gz_menu_input:
    lis r9, _gz_mht_phase@ha
    lwz r9, _gz_mht_phase@l(r9)
    cmpwi r9, 0
    beq _gz_mht_input_ordinary
    b _gz_mask
_gz_mht_input_ordinary:
    lwz r9, 0(r29)
    cmpwi r9, 0
    beq _gz_map_input_not_open
    lis r9, _gz_page@ha
    lwz r9, _gz_page@l(r9)
    cmpwi r9, 13
    bne _gz_map_long_branch_1
    b _gz_map_input
_gz_map_long_branch_1:
    cmpwi r9, 14
    bne _gz_map_long_branch_2
    b _gz_map_input
_gz_map_long_branch_2:
_gz_map_input_not_open:
    ; Inventory owns navigation and item controls while it is open.
    lwz r9, 0(r29)
    cmpwi r9, 0
    beq _gz_feedback_inventory_unlocked
    lis r9, _gz_page@ha
    lwz r9, _gz_page@l(r9)
    cmpwi r9, 51
    beq _gz_after_hotkeys
    cmpwi r9, 8
    blt _gz_feedback_inventory_unlocked
    cmpwi r9, 12
    ble _gz_after_hotkeys
_gz_feedback_inventory_unlocked:
    b _gz_hotkeys
_gz_after_hotkeys:
    lis r9, _gz_page@ha
    addi r9, r9, _gz_page@l
    lwz r9, 0(r9)
    cmpwi r9, 51
    bne _gz_song_input_ordinary
    b _gz_song_input
_gz_song_input_ordinary:
    cmpwi r9, 8
    blt _gz_inv_dispatch1
    cmpwi r9, 12
    bgt _gz_inv_dispatch1
    b _gz_inventory_input
_gz_inv_dispatch1:
    lwz r9, 0(r29)
    cmpwi r9, 0
    bne _gz_widget_skip17
    b _gz_input_done
_gz_widget_skip17:
    lwz r8, 0x10(r1)
    lis r9, _gz_bind_masks@ha
    addi r9, r9, _gz_bind_masks@l
    lwz r9, 24(r9)
    and. r0, r8, r9
    bne _gz_widget_skip18
    b _gz_bind_no_match1
_gz_widget_skip18:
    lwz r0, 0(r31)
    and r0, r0, r9
    cmpw r0, r9
    beq _gz_widget_skip19
    b _gz_bind_no_match1
_gz_widget_skip19:
    li r9, 1
    b _gz_bind_match_done1
_gz_bind_no_match1:
    li r9, 0
_gz_bind_match_done1:
    cmpwi r9, 0
    bne _gz_widget_skip20
    b _gz_select
_gz_widget_skip20:
    lis r9, _gz_page@ha
    addi r9, r9, _gz_page@l
    lwz r10, 0(r9)
    cmpwi r10, 0
    bne _gz_widget_skip21
    b _gz_root_back
_gz_widget_skip21:
    cmpwi r10, 6
    blt _gz_widget_skip22
    b _gz_custom_back
_gz_widget_skip22:
    cmpwi r10, 5
    bne _gz_widget_skip23
    b _gz_back_areas
_gz_widget_skip23:
    cmpwi r10, 4
    bne _gz_widget_skip24
    b _gz_back_routes
_gz_widget_skip24:
    cmpwi r10, 3
    bne _gz_widget_skip25
    b _gz_routes_back_root
_gz_widget_skip25:
    cmpwi r10, 2
    bne _gz_widget_skip26
    b _gz_back_folders
_gz_widget_skip26:
    cmpwi r10, 1
    beq _gz_back_folders
    li r10, 0
    stw r10, 0(r9)
    li r10, 0
    stw r10, 8(r29)
    b _gz_mask
_gz_root_back:
    li r9, 0
    stw r9, 0(r29)
    b _gz_mask
_gz_select:
    lwz r9, 0x1C(r1)
    or r8, r8, r9
    lwz r10, 8(r29)
    lis r12, _gz_page@ha
    addi r12, r12, _gz_page@l
    lwz r12, 0(r12)
    li r11, 5
    cmpwi r12, 50
    bne _gz_mht_navigation_ordinary
    li r11, 0
    b _gz_nav_limit
_gz_mht_navigation_ordinary:
    cmpwi r12, 6
    bne _gz_widget_skip27
    b _gz_bind_limit
_gz_widget_skip27:
    cmpwi r12, 7
    bne _gz_widget_skip28
    b _gz_tools_limit
_gz_widget_skip28:
    cmpwi r12, 0
    bne _gz_widget_skip29
    b _gz_nav_limit
_gz_widget_skip29:
    lis r11, _gz_list_count@ha
    addi r11, r11, _gz_list_count@l
    lwz r11, 0(r11)
    addi r11, r11, -1
    b _gz_nav_limit
_gz_bind_limit:
    li r11, 9
    b _gz_nav_limit
_gz_tools_limit:
    li r11, 11
_gz_nav_limit:
    cmpwi r11, 0
    bge _gz_widget_skip30
    b _gz_mask
_gz_widget_skip30:
    lis r9, _gz_bind_masks@ha
    addi r9, r9, _gz_bind_masks@l
    lwz r9, 12(r9)
    and. r0, r8, r9
    bne _gz_widget_skip31
    b _gz_bind_no_match2
_gz_widget_skip31:
    lwz r0, 0(r31)
    and r0, r0, r9
    cmpw r0, r9
    beq _gz_widget_skip32
    b _gz_bind_no_match2
_gz_widget_skip32:
    li r9, 1
    b _gz_bind_match_done2
_gz_bind_no_match2:
    li r9, 0
_gz_bind_match_done2:
    cmpwi r9, 0
    bne _gz_widget_skip33
    b _gz_down
_gz_widget_skip33:
    addi r10, r10, -1
    cmpwi r10, 0
    blt _gz_widget_skip34
    b _gz_down
_gz_widget_skip34:
    mr r10, r11
_gz_down:
    lis r9, _gz_bind_masks@ha
    addi r9, r9, _gz_bind_masks@l
    lwz r9, 16(r9)
    and. r0, r8, r9
    bne _gz_widget_skip35
    b _gz_bind_no_match3
_gz_widget_skip35:
    lwz r0, 0(r31)
    and r0, r0, r9
    cmpw r0, r9
    beq _gz_widget_skip36
    b _gz_bind_no_match3
_gz_widget_skip36:
    li r9, 1
    b _gz_bind_match_done3
_gz_bind_no_match3:
    li r9, 0
_gz_bind_match_done3:
    cmpwi r9, 0
    bne _gz_widget_skip37
    b _gz_selected
_gz_widget_skip37:
    addi r10, r10, 1
    cmpw r10, r11
    bgt _gz_widget_skip38
    b _gz_selected
_gz_widget_skip38:
    li r10, 0
_gz_selected:
    ; Repeats navigate only: never repeat choose/back or trigger a warp.
    lwz r8, 0x10(r1)
    stw r10, 8(r29)
    cmpwi r12, 6
    blt _gz_widget_skip39
    b _gz_custom_selected
_gz_widget_skip39:
    cmpwi r12, 0
    bne _gz_widget_skip40
    b _gz_root_selected
_gz_widget_skip40:
    lis r9, _gz_warp_cursor@ha
    addi r9, r9, _gz_warp_cursor@l
    stw r10, 0(r9)
    lis r9, _gz_warp_top@ha
    addi r9, r9, _gz_warp_top@l
    lwz r11, 0(r9)
    cmpw r10, r11
    blt _gz_widget_skip41
    b _gz_top_bottom
_gz_widget_skip41:
    stw r10, 0(r9)
    b _gz_warp_selected
_gz_top_bottom:
    addi r11, r11, 7
    cmpw r10, r11
    bgt _gz_widget_skip42
    b _gz_warp_selected
_gz_widget_skip42:
    addi r11, r10, -7
    stw r11, 0(r9)
_gz_warp_selected:
    lis r9, _gz_bind_masks@ha
    addi r9, r9, _gz_bind_masks@l
    lwz r9, 20(r9)
    and. r0, r8, r9
    bne _gz_widget_skip43
    b _gz_bind_no_match4
_gz_widget_skip43:
    lwz r0, 0(r31)
    and r0, r0, r9
    cmpw r0, r9
    beq _gz_widget_skip44
    b _gz_bind_no_match4
_gz_widget_skip44:
    li r9, 1
    b _gz_bind_match_done4
_gz_bind_no_match4:
    li r9, 0
_gz_bind_match_done4:
    cmpwi r9, 0
    bne _gz_widget_skip45
    b _gz_mask
_gz_widget_skip45:
    lis r9, _gz_warp_choice@ha
    addi r9, r9, _gz_warp_choice@l
    cmpwi r12, 3
    bne _gz_widget_skip46
    b _gz_open_route
_gz_widget_skip46:
    cmpwi r12, 4
    bne _gz_widget_skip47
    b _gz_open_area
_gz_widget_skip47:
    cmpwi r12, 5
    bne _gz_widget_skip48
    b _gz_choose_checkpoint
_gz_widget_skip48:
    cmpwi r12, 1
    bne _gz_widget_skip49
    b _gz_open_folder
_gz_widget_skip49:
    lis r11, _gz_list_offset@ha
    addi r11, r11, _gz_list_offset@l
    lwz r11, 0(r11)
    add r10, r10, r11
    stw r10, 0(r9)
    lis r9, _gz_pending@ha
    addi r9, r9, _gz_pending@l
    li r10, 3
    stw r10, 0(r9)
    b _gz_mask
_gz_open_folder:
    lis r8, _gz_hw_warp_depth@ha
    addi r8, r8, _gz_hw_warp_depth@l
    lwz r12, 0(r8)
    cmpwi r12, 4
    blt _gz_map_long_branch_3
    b _gz_mask
_gz_map_long_branch_3:
    slwi r11, r12, 5
    lis r9, _gz_hw_warp_stack@ha
    addi r9, r9, _gz_hw_warp_stack@l
    add r9, r9, r11
    stw r10, 16(r9)
    lis r11, _gz_list_base@ha
    lwz r11, _gz_list_base@l(r11)
    stw r11, 0(r9)
    lis r11, _gz_list_count@ha
    lwz r11, _gz_list_count@l(r11)
    stw r11, 4(r9)
    lis r11, _gz_list_title@ha
    lwz r11, _gz_list_title@l(r11)
    stw r11, 8(r9)
    lis r11, _gz_list_offset@ha
    lwz r11, _gz_list_offset@l(r11)
    stw r11, 12(r9)
    lis r11, _gz_warp_top@ha
    lwz r11, _gz_warp_top@l(r11)
    stw r11, 20(r9)
    addi r12, r12, 1
    stw r12, 0(r8)
    lis r9, _gz_list_base@ha
    lwz r9, _gz_list_base@l(r9)
    slwi r10, r10, 4
    add r9, r9, r10
    lwz r10, 4(r9)
    lis r11, _gz_list_offset@ha
    stw r10, _gz_list_offset@l(r11)
    lwz r12, 12(r9)
    cmpwi r12, 0
    beq _gz_hw_warp_leaf
    slwi r10, r10, 4
    lis r11, _gz_folder_records@ha
    addi r11, r11, _gz_folder_records@l
    li r12, 1
    b _gz_hw_warp_child_ready
_gz_hw_warp_leaf:
    mulli r10, r10, 20
    lis r11, _gz_warp_records@ha
    addi r11, r11, _gz_warp_records@l
    li r12, 2
_gz_hw_warp_child_ready:
    add r10, r10, r11
    lis r11, _gz_list_base@ha
    stw r10, _gz_list_base@l(r11)
    lwz r10, 8(r9)
    lis r11, _gz_list_count@ha
    stw r10, _gz_list_count@l(r11)
    lwz r10, 0(r9)
    lis r11, _gz_list_title@ha
    stw r10, _gz_list_title@l(r11)
    lis r9, _gz_page@ha
    stw r12, _gz_page@l(r9)
    li r10, 0
    stw r10, 8(r29)
    lis r9, _gz_warp_top@ha
    stw r10, _gz_warp_top@l(r9)
    b _gz_mask
_gz_root_selected:
    cmpwi r10, 4
    bne _gz_inv_dispatch0
    b _gz_inv_root_choose
_gz_inv_dispatch0:
    lis r9, _gz_bind_masks@ha
    addi r9, r9, _gz_bind_masks@l
    lwz r9, 20(r9)
    and. r0, r8, r9
    bne _gz_widget_skip50
    b _gz_bind_no_match5
_gz_widget_skip50:
    lwz r0, 0(r31)
    and r0, r0, r9
    cmpw r0, r9
    beq _gz_widget_skip51
    b _gz_bind_no_match5
_gz_widget_skip51:
    li r9, 1
    b _gz_bind_match_done5
_gz_bind_no_match5:
    li r9, 0
_gz_bind_match_done5:
    cmpwi r9, 0
    bne _gz_widget_skip52
    b _gz_mask
_gz_widget_skip52:
