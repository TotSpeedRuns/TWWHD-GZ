    addi r31, r31, 32
    lis r30, _gz_foliage_groups@ha
    addi r30, r30, _gz_foliage_groups@l
_gz_foliage_capture_group:
    lwz r8, 0(r30)
    cmpwi r8, 0
    beq _gz_foliage_capture_plants
    lis r9, 0x1047
    addi r9, r9, -3920
    lwzx r29, r9, r8
    stw r29, 0(r31)
    li r8, 0
    stw r8, 4(r31)
    stw r8, 8(r31)
    stw r8, 12(r31)
    cmpwi r29, 0
    beq _gz_foliage_capture_group_next
    mr r3, r29
    bl _gz_foliage_packet_safe
    cmpwi r3, 0
