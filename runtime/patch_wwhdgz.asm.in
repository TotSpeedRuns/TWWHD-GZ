_gz_world_capture_enemy_animation:
    ; r3 actor, r4 destination record. 92 is naturally word-aligned.
    lwz r5, 0x3D8(r3)
    cmpwi r5, 0
    beq _gz_world_animation_capture_bad
    lfs f0, 0xB0(r5)
    lis r6, _gz_world_animation_one@ha
    lfs f13, _gz_world_animation_one@l(r6)
    fcmpu cr0, f0, f13
