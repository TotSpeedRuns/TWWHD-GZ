; The snapshot's empty equip keep is preserved. Only native HIMO2 (446)
; and HOOKSHOT (169) child actors owned by the current Link can be retired.
_gz_v103_item_retire_prepare:
    stwu r1, -0x30(r1)
    mflr r0
    stw r0, 0x34(r1)
    stmw r26, 8(r1)
