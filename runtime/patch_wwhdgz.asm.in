_gz_widget_skip263:
    mulli r4, r4, 21
    mulli r5, r5, 32
    addi r5, r5, 6
    li r3, 21
    lis r6, _gz_cursor_pixels21@ha
    addi r6, r6, _gz_cursor_pixels21@l
