    ; restoring pointer-free controller fields. No old resource is copied.
    addi r8, r8, 0x98
    addi r4, r4, 104
    li r7, 16
_gz_world_animation_apply_controller:
    lbz r9, 0(r4)
    stb r9, 0(r8)
    addi r4, r4, 1
    addi r8, r8, 1
    addi r7, r7, -1
    cmpwi r7, 0
    bne _gz_world_animation_apply_controller
    lwz r3, 8(r1)
    lwz r4, 12(r1)
    lhz r9, 120(r4)
    sth r9, 0xCD8(r3)
    lbz r9, 122(r4)
    stb r9, 0xCDA(r3)
    lhz r9, 124(r4)
    sth r9, 0x426(r3)
    bl _gz_mca_blend_apply
    li r3, 0
    b _gz_world_animation_apply_done
_gz_world_animation_apply_bad:
    li r3, 16
_gz_world_animation_apply_done:
    lwz r0, 0x24(r1)
    mtlr r0
    addi r1, r1, 0x20
    blr
