    bne _gz_il_hud_fallback
    lis r8,_gz_tools_flags@ha
    lwz r8,_gz_tools_flags@l(r8)
    ; All existing visual widgets keep their complete draw path. Input-only
    ; Upcharge/Moonjump/No Speed Cap/Dry Storage do not require a canvas.
    andi. r8,r8,4599
    bne _gz_il_hud_fallback
    lis r8,_gz_toast_active@ha
    lwz r8,_gz_toast_active@l(r8)
    cmpwi r8,0
    bne _gz_il_hud_fallback
    bl _gz_il_display_c
    cmpwi r3,0
