.int 1

; Sharp glyph coverage, tight one-pixel outline.

.origin = codecave
.align 4
0x0247D270 = _gz_ff2_ship_native_create:
0x101D0394 = .int _gz_ff2_ship_guard
_gz_ff2_ship_guard:
    lis r8, _gz_route_active@ha
    lwz r8, _gz_route_active@l(r8)
    cmpwi r8, 0
    beq _gz_ff2_ship_original
    lis r8, _gz_route_choice@ha
    lwz r8, _gz_route_choice@l(r8)
    mulli r8, r8, 20
    lis r9, _gz_route_records@ha
    addi r9, r9, _gz_route_records@l
    add r9, r9, r8
    lwz r8, 4(r9)
    lis r10, 0x7365
    ori r10, r10, 0x6100
    cmpw r8, r10
    bne _gz_ff2_ship_original
    lwz r8, 8(r9)
    cmpwi r8, 0
    bne _gz_ff2_ship_original
    lwz r8, 12(r9)
    srwi r8, r8, 8
    cmpwi r8, 1
    bne _gz_ff2_ship_original
    lis r9, _gz_ff2_ship_suppressed@ha
    lwz r8, _gz_ff2_ship_suppressed@l(r9)
    addi r8, r8, 1
    stw r8, _gz_ff2_ship_suppressed@l(r9)
    ; The native constructor must run before the engine can dispose of it.
    ; Returning error before construction trips native base-actor assertions.
    stwu r1, -0x10(r1)
    mflr r0
    stw r0, 0x14(r1)
    stw r3, 8(r1)
    bl _gz_ff2_ship_native_create
    cmpwi r3, 4
    bne _gz_ff2_ship_guard_return
    ; Native cleanup does not clear GameInfo's ship pointer. Clear only the
    ; exact instance we are rejecting so later gameplay cannot use freed data.
    lwz r9, 8(r1)
    lis r10, 0x1047
    lwz r8, 0x4BEC(r10)
    cmpw r8, r9
    bne _gz_ff2_ship_no_global
    li r8, 0
    stw r8, 0x4BEC(r10)
_gz_ff2_ship_no_global:
    ; Native complete -> native error schedules the fully initialized actor's
    ; normal cleanup before it enters the active process list.
    li r3, 5
_gz_ff2_ship_guard_return:
    lwz r0, 0x14(r1)
    mtlr r0
    addi r1, r1, 0x10
    blr
_gz_ff2_ship_original:
    b _gz_ff2_ship_native_create
.align 4
_gz_ff2_ship_suppressed:
.int 0

.align 4
