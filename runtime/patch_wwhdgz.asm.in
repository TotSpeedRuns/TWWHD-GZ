0x024F7280 = _gz_camera_param_change:
0x024F8070 = _gz_camera_view_resume:
0x024F806C = b _gz_camera_view_hook
.origin = codecave
_gz_camera_current:
    lis r8, 0x1047
    lbz r5, 0x4BE0(r8)
    cmplwi r5, 1
    bgt _gz_camera_current_bad
    mulli r9, r5, 52
    ; This address needs its own relocation: the prior high half belongs to
    ; the camera-index byte and may carry differently after Cafe DATA moves.
    lis r8, 0x1047
    addi r8, r8, 0x4BA8
    lwzx r4, r8, r9
    lis r8, 0x1000
    cmplw r4, r8
    blt _gz_camera_current_bad
    lis r8, 0xC000
    cmplw r4, r8
    bge _gz_camera_current_bad
    addi r3, r4, 0x248
    lwz r8, 0(r3)
    cmpw r8, r4
    bne _gz_camera_current_bad
    lbz r10, 4(r3)
    cmplwi r10, 1
    bgt _gz_camera_current_bad
    lbz r11, 5(r3)
    cmplwi r11, 1
    bgt _gz_camera_current_bad
    cmpwi r10, 1
    bne _gz_camera_check_native_pause
    cmpwi r11, 0
    beq _gz_camera_flags_ready
_gz_camera_check_native_pause:
    ; Stopped/stayed camera is legitimate under a real, stable Plus menu.
    ; Pause Storage intentionally has gameplay-pause0 and is not this case.
    lis r8, _gz_snapshot_native_pause@ha
    lbz r8, _gz_snapshot_native_pause@l(r8)
    cmpwi r8, 1
    bne _gz_camera_current_bad
    lis r8, _gz_ps_ui_state_root@ha
    lwz r8, _gz_ps_ui_state_root@l(r8)
    andi. r9, r8, 3
    bne _gz_camera_current_bad
    lis r9, 0x1000
    cmplw r8, r9
    blt _gz_camera_current_bad
    lis r9, 0xBFFF
    cmplw r8, r9
    bge _gz_camera_current_bad
    lwz r8, 0xC(r8)
    lis r9, _gz_ps_menu@ha
    addi r9, r9, _gz_ps_menu@l
    cmpw r8, r9
    bne _gz_camera_current_bad
_gz_camera_flags_ready:
    lwz r8, 0x120(r3)
    cmpw r8, r5
    bne _gz_camera_current_bad
    lis r8, 0x1047
    lwz r8, 0x4BE4(r8)
    lwz r9, 0x128(r3)
    cmpw r8, r9
    bne _gz_camera_current_bad
    lwz r8, 0x514(r3)
    cmplwi r8, 144
    bgt _gz_camera_current_bad
    blr
_gz_camera_current_bad:
    li r3, 0
    blr

; Resolve captured IDs against the live queue; never return saved pointers.
_gz_camera_find_actor:
    cmpwi r3, -1
    beq _gz_camera_find_none
    lis r8, 0x101F
    lwz r8, 0x3328(r8)
    li r9, 4096
_gz_camera_find_loop:
    cmpwi r8, 0
    beq _gz_camera_find_none
    addi r9, r9, -1
    cmpwi r9, 0
    beq _gz_camera_find_none
    lwz r10, 12(r8)
    cmpwi r10, 0
    beq _gz_camera_find_next
    lwz r11, 4(r10)
    cmpw r3, r11
    beq _gz_camera_find_found
_gz_camera_find_next:
    lwz r8, 8(r8)
    b _gz_camera_find_loop
_gz_camera_find_found:
    mr r3, r10
    blr
_gz_camera_find_none:
    li r3, 0
    blr

; r3=algorithm; audited pointer-free work slices only.
_gz_camera_work_table:
    cmpwi r3, 1
    beq _gz_camera_work_1
    cmpwi r3, 2
    beq _gz_camera_work_2
    cmpwi r3, 4
    beq _gz_camera_work_4
    cmpwi r3, 10
    beq _gz_camera_work_10
    li r3, 0
    blr
_gz_camera_work_1:
    lis r3, _gz_camera_work_fields_1@ha
    addi r3, r3, _gz_camera_work_fields_1@l
    blr
_gz_camera_work_2:
    lis r3, _gz_camera_work_fields_2@ha
    addi r3, r3, _gz_camera_work_fields_2@l
    blr
_gz_camera_work_4:
    lis r3, _gz_camera_work_fields_4@ha
    addi r3, r3, _gz_camera_work_fields_4@l
    blr
_gz_camera_work_10:
    lis r3, _gz_camera_work_fields_10@ha
    addi r3, r3, _gz_camera_work_fields_10@l
    blr
_gz_camera_capture:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    lis r31, _gz_camera_working@ha
    addi r31, r31, _gz_camera_working@l
    li r8, 0
    mr r9, r31
    li r10, 512
_gz_camera_clear_work:
    stw r8, 0(r9)
    addi r9, r9, 4
    addi r10, r10, -1
    cmpwi r10, 0
    bne _gz_camera_clear_work
    mr r3, r31
    bl _gz_camera_read
_gz_camera_capture_done:
    lmw r26, 0x28(r1)
    lwz r0, 0x44(r1)
    mtlr r0
    addi r1, r1, 0x40
    blr
_gz_camera_read:
    stwu r1, -0x40(r1)
    mflr r0
    stw r0, 0x44(r1)
    stmw r26, 0x28(r1)
    mr r31, r3
    bl _gz_camera_current
    cmpwi r3, 0
    beq _gz_camera_read_bad
    mr r28, r3
    stw r4, 8(r31)
    lwz r8, 4(r4)
    stw r8, 12(r31)
    stw r5, 16(r31)
    lwz r8, 0x514(r28)
    stw r8, 20(r31)
    mulli r8, r8, 132
    lis r9, 0x1004
    addi r9, r9, 0x4880
    lwzx r3, r9, r8
    stw r3, 24(r31)
    bl _gz_camera_work_table
    cmpwi r3, 0
    beq _gz_camera_read_bad
    mr r30, r3
    addi r29, r31, 1200
_gz_camera_read_work:
    lhz r8, 0(r30)
    lhz r5, 2(r30)
    cmpwi r5, 0
    beq _gz_camera_read_fields_start
    addi r4, r28, 0x37C
    add r4, r4, r8
    mr r3, r29
    add r29, r29, r5
    bl _gz_player_copy_bytes
    addi r30, r30, 4
    b _gz_camera_read_work
_gz_camera_read_fields_start:
    addi r29, r31, 128
    lis r30, _gz_camera_fields@ha
    addi r30, r30, _gz_camera_fields@l
_gz_camera_read_fields:
    lhz r8, 0(r30)
    lhz r5, 2(r30)
    cmpwi r5, 0
    beq _gz_camera_read_links_start
    add r4, r28, r8
    mr r3, r29
    add r29, r29, r5
    bl _gz_player_copy_bytes
    addi r30, r30, 4
    b _gz_camera_read_fields
_gz_camera_read_links_start:
    li r26, 0
_gz_camera_read_links:
    lis r8, _gz_camera_link_fields@ha
    addi r8, r8, _gz_camera_link_fields@l
    slwi r9, r26, 1
    lhzx r8, r8, r9
    lwzx r3, r28, r8
    li r27, -1
    cmpwi r3, 0
    beq _gz_camera_read_link_store
    ; The pointer must already belong to the queue before reading its ID.
    mr r27, r3
    lis r8, 0x101F
    lwz r8, 0x3328(r8)
    li r9, 4096
_gz_camera_read_link_find:
    cmpwi r8, 0
    beq _gz_camera_read_bad
    addi r9, r9, -1
    cmpwi r9, 0
    beq _gz_camera_read_bad
    lwz r10, 12(r8)
    cmpw r10, r27
    beq _gz_camera_read_link_id
    lwz r8, 8(r8)
    b _gz_camera_read_link_find
_gz_camera_read_link_id:
    lwz r27, 4(r27)
_gz_camera_read_link_store:
    slwi r8, r26, 2
    addi r8, r8, 32
    stwx r27, r31, r8
    addi r26, r26, 1
    cmpwi r26, 5
    blt _gz_camera_read_links
    addi r3, r31, 1400
    lwz r4, 8(r31)
    addi r4, r4, 0xCC
    li r5, 0x38
    bl _gz_player_copy_bytes
    ; store() publishes process angles separately from the View. Link's
    ; subjectivity fallback reads them directly (owned 0x02416E90 routine).
    addi r3, r31, 1460
    lwz r4, 8(r31)
    addi r4, r4, 0x234
    li r5, 6
    bl _gz_player_copy_bytes
    addi r3, r31, 1472
    lwz r8, 16(r31)
    mulli r8, r8, 52
    lis r4, 0x1047
    addi r4, r4, 0x4BB0
    add r4, r4, r8
    li r5, 12
    bl _gz_player_copy_bytes
