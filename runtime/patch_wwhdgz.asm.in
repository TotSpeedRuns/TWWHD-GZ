_gz_paint_ess:
    lis r8, _gz_input_snapshot@ha
    addi r8, r8, _gz_input_snapshot@l
    lwz r8, 28(r8)
    lis r12, 0xFF40
    ori r12, r12, 0x40FF
    cmpwi r8, 60
    bge _gz_widget_skip214
    b _gz_ess_color_ready
_gz_widget_skip214:
    cmpwi r8, 120
    ble _gz_widget_skip215
    b _gz_ess_yellow
_gz_widget_skip215:
    lis r12, 0x40FF
    ori r12, r12, 0x70FF
    b _gz_ess_color_ready
_gz_ess_yellow:
    cmpwi r8, 180
    ble _gz_widget_skip216
    b _gz_ess_color_ready
_gz_widget_skip216:
    lis r12, 0xFFE0
    ori r12, r12, 0x40FF
_gz_ess_color_ready:
    lis r8, _gz_ess_color@ha
    addi r8, r8, _gz_ess_color@l
    stw r12, 0(r8)
    lwz r3, 12(r29)
    lis r4, 0x14
    ori r4, r4, 0xA800
    add r3, r3, r4
    li r4, 25
_gz_ess_paint_row:
    li r5, 96
    mr r6, r3
_gz_ess_paint_pixel:
    lwz r7, 0(r6)
    cmpwi r7, -1
    beq _gz_widget_skip217
    b _gz_ess_paint_next
_gz_widget_skip217:
    stw r12, 0(r6)
_gz_ess_paint_next:
    addi r6, r6, 4
    addi r5, r5, -1
    cmpwi r5, 0
    beq _gz_widget_skip218
    b _gz_ess_paint_pixel
_gz_widget_skip218:
    addi r3, r3, 5120
    addi r4, r4, -1
    cmpwi r4, 0
    beq _gz_widget_skip219
    b _gz_ess_paint_row
_gz_widget_skip219:
    blr
.align 4
_gz_ess_color:
.int 0xFF4040FF

_gz_game_text:
    lis r8, _gz_marker@ha
    addi r8, r8, _gz_marker@l
    cmplw r6, r8
    bne _gz_widget_skip220
    b _gz_draw_menu_cursor
_gz_widget_skip220:
    lis r8, _gz_viewport@ha
