.int 0,0,0,0,0,0,0,0

0x020F9AF4 = _gz_molgera_native_animation:
.origin = codecave
_gz_molgera_component_capture:
    stwu r1, -0x30(r1)
    stmw r26, 0x18(r1)
    lis r31, _gz_molgera_component@ha
    addi r31, r31, _gz_molgera_component@l
    li r8, 0
    stw r8, 0(r31)
    lis r9, _gz_molgera_current_actor@ha
    stw r8, _gz_molgera_current_actor@l(r9)
    lis r30, _gz_molgera_animation_trace@ha
    addi r30, r30, _gz_molgera_animation_trace@l
    lwz r28, 28(r30)
    cmpwi r28, 0
    beq _gz_molgera_capture_done
    ; The last trace pointer is only inspected if its PID is in today's
    ; captured live actor queue. Never dereference a freed prior-scene actor.
    lis r9, _gz_inplace_meta@ha
    lwz r27, _gz_inplace_meta@l+4(r9)
    lis r29, _gz_inplace_actor_ids@ha
    addi r29, r29, _gz_inplace_actor_ids@l
    lwz r10, 0(r30)
_gz_molgera_find_lifetime:
    cmpwi r27, 0
    beq _gz_molgera_capture_done
    lwz r8, 0(r29)
    cmpw r8, r10
    beq _gz_molgera_found_lifetime
    addi r29, r29, 8
    addi r27, r27, -1
    b _gz_molgera_find_lifetime
_gz_molgera_found_lifetime:
    lwz r8, 4(r29)
    cmpwi r8, 217
    bne _gz_molgera_capture_done
    lwz r8, 4(r28)
    cmpw r8, r10
    bne _gz_molgera_capture_done
    lbz r8, 0x3A1(r28)
    cmpwi r8, 0
    beq _gz_molgera_capture_done
    lwz r29, 0x3DC(r28)
    lwz r8, 0xB0(r29)
    lis r9, 0x3F80
    cmplw r8, r9
    bgt _gz_molgera_capture_done
    stw r10, 4(r31)
    lwz r8, 8(r30)
    stw r8, 8(r31)
    lwz r8, 12(r30)
    stw r8, 12(r31)
    lwz r8, 16(r30)
    stw r8, 16(r31)
    lwz r8, 24(r30)
    stw r8, 20(r31)
    stw r29, 40(r31)
    li r9, 0
_gz_molgera_capture_clock:
    addi r8, r9, 0x98
    lbzx r10, r29, r8
    addi r8, r9, 24
    stbx r10, r31, r8
    addi r9, r9, 1
    cmplwi r9, 16
    blt _gz_molgera_capture_clock
    lis r26, _gz_molgera_field_table@ha
    addi r26, r26, _gz_molgera_field_table@l
    addi r30, r31, 48
_gz_molgera_capture_field:
    lhz r8, 0(r26)
    lhz r9, 2(r26)
    cmpwi r9, 0
    beq _gz_molgera_capture_complete
    add r27, r28, r8
_gz_molgera_capture_byte:
    lbz r10, 0(r27)
    stb r10, 0(r30)
    addi r27, r27, 1
    addi r30, r30, 1
    addi r9, r9, -1
    cmpwi r9, 0
    bne _gz_molgera_capture_byte
    addi r26, r26, 4
    b _gz_molgera_capture_field
_gz_molgera_capture_complete:
    li r8, 1
    stw r8, 0(r31)
_gz_molgera_capture_done:
    lmw r26, 0x18(r1)
    addi r1, r1, 0x30
    blr
_gz_molgera_component_preflight:
    lis r8, _gz_inplace_enabled@ha
    lwz r8, _gz_inplace_enabled@l(r8)
    cmpwi r8, 2
    bne _gz_molgera_preflight_refused
    lis r8, _gz_molgera_component@ha
    addi r8, r8, _gz_molgera_component@l
    lwz r9, 0(r8)
    cmpwi r9, 1
    bne _gz_molgera_preflight_refused
    lwz r9, 4(r8)
    lwz r10, 4(r3)
    cmpw r9, r10
    bne _gz_molgera_preflight_refused
    lwz r9, 40(r8)
    lwz r10, 0x3DC(r3)
    cmpw r9, r10
    bne _gz_molgera_preflight_refused
    lis r8, _gz_molgera_current_actor@ha
    stw r3, _gz_molgera_current_actor@l(r8)
    li r3, 0
    blr
_gz_molgera_preflight_refused:
    li r3, 28
    blr
_gz_molgera_component_apply:
    lis r8, _gz_inplace_enabled@ha
    lwz r8, _gz_inplace_enabled@l(r8)
    cmpwi r8, 2
    bnelr
    lis r8, _gz_molgera_current_actor@ha
    lwz r3, _gz_molgera_current_actor@l(r8)
    cmpwi r3, 0
    beqlr
    stwu r1, -0x140(r1)
    mflr r0
    stw r0, 0x144(r1)
    stmw r26, 0x28(r1)
    stfd f0, 64(r1)
    .int 0x100004A0 ; ps_merge10
    stfs f0, 72(r1)
    stfd f1, 80(r1)
    .int 0x10210CA0 ; ps_merge10
    stfs f1, 88(r1)
    stfd f2, 96(r1)
    .int 0x104214A0 ; ps_merge10
    stfs f2, 104(r1)
    stfd f3, 112(r1)
    .int 0x10631CA0 ; ps_merge10
    stfs f3, 120(r1)
    stfd f4, 128(r1)
    .int 0x108424A0 ; ps_merge10
    stfs f4, 136(r1)
    stfd f5, 144(r1)
    .int 0x10A52CA0 ; ps_merge10
    stfs f5, 152(r1)
    stfd f6, 160(r1)
    .int 0x10C634A0 ; ps_merge10
    stfs f6, 168(r1)
    stfd f7, 176(r1)
    .int 0x10E73CA0 ; ps_merge10
    stfs f7, 184(r1)
