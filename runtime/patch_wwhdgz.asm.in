    lwz r4, 12(r1)
    lwz r5, 16(r1)
    lwz r6, 20(r1)
    lwz r7, 24(r1)
    lwz r8, 28(r1)
    lwz r9, 32(r1)
    lwz r10, 36(r1)
    lwz r11, 40(r1)
    lwz r12, 44(r1)
    lwz r0, 0x54(r1)
    mtlr r0
    addi r1, r1, 0x50
