    cmplwi r8, 494
    bgt _gz_user_totg_stage_seed_done
_gz_v102_seed_selected:
    lis r8, _gz_route_heap@ha
    lwz r8, _gz_route_heap@l(r8)
    addi r9, r8, 0x778
    addi r10, r8, 0x434
    li r11, 9
_gz_user_totg_stage_seed_loop:
    lwz r12, 0(r9)
    stw r12, 0(r10)
    addi r9, r9, 4
    addi r10, r10, 4
    addi r11, r11, -1
    cmpwi r11, 0
    bne _gz_user_totg_stage_seed_loop
_gz_user_totg_stage_seed_done:
    lis r8, _gz_route_choice@ha
    lwz r8, _gz_route_choice@l(r8)
    cmplwi r8, 680
    beqlr
    b _gz_keep_equipment_apply

_gz_route_finish:
    stwu r1, -0x20(r1)
    mflr r0
    stw r0, 0x24(r1)
    bl _gz_pa_tick
    bl _gz_td_tick
    lis r9, _gz_route_active@ha
    addi r9, r9, _gz_route_active@l
    lwz r9, 0(r9)
    cmpwi r9, 0
    bne _gz_widget_skip133
    b _gz_route_finish_done
_gz_widget_skip133:
    lis r8, _gz_route_ticks@ha
    addi r8, r8, _gz_route_ticks@l
    lwz r10, 0(r8)
    addi r10, r10, 1
    stw r10, 0(r8)
    cmpwi r10, 900
    blt _gz_widget_skip134
    b _gz_route_timeout
_gz_widget_skip134:
    lis r8, _gz_loading_store@ha
    addi r8, r8, _gz_loading_store@l
    lbz r8, 0(r8)
    cmpwi r8, 0
    bne _gz_widget_skip135
    b _gz_route_arrival_check
_gz_widget_skip135:
    lis r8, _gz_route_seen_loading@ha
    addi r8, r8, _gz_route_seen_loading@l
    li r10, 1
    stw r10, 0(r8)
    b _gz_route_finish_done
_gz_route_arrival_check:
    lis r8, _gz_route_phase_applied@ha
    addi r8, r8, _gz_route_phase_applied@l
    lwz r8, 0(r8)
    cmpwi r8, 0
    bne _gz_widget_skip136
    b _gz_route_finish_done
_gz_widget_skip136:
    bl _gz_live_check
    cmpwi r3, 0
    beq _gz_widget_skip137
    b _gz_route_finish_done
_gz_widget_skip137:
    lis r9, _gz_route_active@ha
    addi r9, r9, _gz_route_active@l
    lwz r9, 0(r9)
    lis r8, _gz_stage_store@ha
    addi r8, r8, _gz_stage_store@l
    lwz r10, 0(r8)
    lwz r12, 4(r9)
    cmpw r10, r12
    beq _gz_widget_skip138
