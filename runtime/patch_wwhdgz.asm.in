    lis r8,_gz_native_action_queue_count@ha
    li r9,0
    stw r9,_gz_native_action_queue_count@l(r8)
    bl _gz_il_format_c
    mr r6,r3
    li r3,1
    li r4,1072
    li r5,24
    li r7,-249
    bl _gz_native_action_queue_label
    cmpwi r3,0
    beq _gz_il_hud_fallback
    ; The same native batch and native font/style used by the canvas path.
    ; No full-screen quad, canvas clear/upload, fence query, or forced flush.
    lwz r9,20(r29)
    lis r8,_gz_native_action_render_context@ha
    stw r9,_gz_native_action_render_context@l(r8)
    mr r31,r30
    bl _gz_native_action_tv_batch
    lwz r3,20(r29)
    bl import.gx2.GX2SetContextState
    li r3,1
    b _gz_il_hud_return
_gz_il_hud_fallback:
    li r3,0
_gz_il_hud_return:
    lwz r31,0x1C(r1)
    lwz r0,0x24(r1)
    mtlr r0
    addi r1,r1,0x20
    blr

