    lis r8, 2
    ori r8, r8, 34432
    add r3, r31, r8
    bl _gz_wood_capture
    cmpwi r3, 0
    bne _gz_foliage_capture_bad
    li r8, 1
    stw r8, 0(r31)
    mr r3, r31
