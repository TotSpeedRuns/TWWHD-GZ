    blt _gz_v103_seed_before_floor_aliases
    cmplwi r8, 583
    bgt _gz_v103_seed_before_floor_aliases
    addi r8, r8, -552
    mulli r8, r8, 4
    lis r9, _gz_v103_floor_canonical@ha
    addi r9, r9, _gz_v103_floor_canonical@l
    lwzx r8, r9, r8
    cmpwi r8, -1
    beq _gz_v102_seed_selected
_gz_v103_seed_before_floor_aliases:
