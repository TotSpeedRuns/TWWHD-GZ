    lwz r9, 0(r8)
    cmpwi r9, 0
    beqlr
    lis r9, _gz_world_resume_failed@ha
    lwz r9, _gz_world_resume_failed@l(r9)
    cmpwi r9, 0
    beq _gz_slot_origin_adopt
    li r9, 0
    stw r9, 0(r8)
    blr
_gz_slot_origin_adopt:
    lis r9, _gz_slot_origin_current@ha
    addi r9, r9, _gz_slot_origin_current@l
    lwz r10, 4(r8)
    stw r10, 0(r9)
    lwz r10, 8(r8)
    stw r10, 4(r9)
    lwz r10, 12(r8)
    stw r10, 8(r9)
    lwz r10, 16(r8)
    stw r10, 12(r9)
    li r10, 0
    stw r10, 0(r8)
    blr
_gz_slot_origin_teardown:
    lis r8, _gz_route_active@ha
    lwz r8, _gz_route_active@l(r8)
