    lwz r28, 12(r26)
    cmpwi r28, 0
    beq _gz_foliage_capture_plant_next
    lhz r8, 8(r28)
    cmpwi r8, 274
    bne _gz_foliage_capture_plant_next
    cmplwi r30, 64
    bge _gz_foliage_capture_bad
    lwz r8, 4(r28)
    stw r8, 0(r31)
    stw r28, 4(r31)
    lwz r8, 0x3B4(r28)
    stw r8, 8(r31)
    lbz r8, 0x326(r28)
    stw r8, 12(r31)
    lwz r8, 0xB0(r28)
    stw r8, 16(r31)
    addi r3, r31, 20
    addi r4, r28, 0x524
    li r5, 9
    bl _gz_player_copy_bytes
    addi r31, r31, 32
    addi r30, r30, 1
_gz_foliage_capture_plant_next:
