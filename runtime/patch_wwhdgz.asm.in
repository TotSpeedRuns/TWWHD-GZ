.align 4
_gz_map_input:
    lwz r8, 0x10(r1)
    lis r11, _gz_bind_masks@ha
    addi r11, r11, _gz_bind_masks@l
    lwz r9, 24(r11)
    and. r0, r8, r9
    beq _gz_map_v02_no_back
    lwz r0, 0(r31)
    and r0, r0, r9
    cmpw r0, r9
    beq _gz_map_back
_gz_map_v02_no_back:
    lis r9, _gz_page@ha
    lwz r9, _gz_page@l(r9)
    cmpwi r9, 14
    beq _gz_map_list_input
    ; X retains the existing Islands/Dungeons browser.
    andi. r0, r8, 0x2000
    beq _gz_map_v02_far_1
    b _gz_setup_folders
_gz_map_v02_far_1:
    bl _gz_map_navigation_v02
    mr r8, r3
    lis r11, _gz_bind_masks@ha
    addi r11, r11, _gz_bind_masks@l
    lis r12, _gz_map_sector@ha
    lwz r10, _gz_map_sector@l(r12)
    li r9, 7
    divwu r7, r10, r9
    mulli r6, r7, 7
    subf r6, r6, r10
    andi. r0, r8, 0x0800
    beq _gz_map_no_left
    cmpwi r6, 0
    beq _gz_map_no_left
    addi r10, r10, -1
_gz_map_no_left:
    andi. r0, r8, 0x0400
    beq _gz_map_no_right
    cmpwi r6, 6
    beq _gz_map_no_right
    addi r10, r10, 1
_gz_map_no_right:
    lwz r9, 12(r11)
    and. r0, r8, r9
    beq _gz_map_no_up
    cmpwi r7, 0
    beq _gz_map_no_up
    addi r10, r10, -7
_gz_map_no_up:
    lwz r9, 16(r11)
    and. r0, r8, r9
    beq _gz_map_no_down
    cmpwi r7, 6
    beq _gz_map_no_down
    addi r10, r10, 7
_gz_map_no_down:
    stw r10, _gz_map_sector@l(r12)
    ; A must be a new edge, never a navigation repeat.
    lwz r8, 0x10(r1)
    lwz r9, 20(r11)
    and. r0, r8, r9
    bne _gz_map_v02_far_2
    b _gz_mask
_gz_map_v02_far_2:
    lwz r0, 0(r31)
    and r0, r0, r9
    cmpw r0, r9
    beq _gz_map_v02_far_3
    b _gz_mask
_gz_map_v02_far_3:
    mulli r10, r10, 12
    lis r9, _gz_map_quadrants@ha
    addi r9, r9, _gz_map_quadrants@l
    add r9, r9, r10
    lwz r10, 8(r9)
    cmpwi r10, 0
    bne _gz_map_v02_far_4
    b _gz_mask
_gz_map_v02_far_4:
    li r10, 14
    lis r9, _gz_page@ha
    stw r10, _gz_page@l(r9)
    li r10, 0
    stw r10, 8(r29)
    b _gz_mask
_gz_map_list_input:
    bl _gz_map_navigation_v02
    mr r8, r3
    lis r11, _gz_bind_masks@ha
    addi r11, r11, _gz_bind_masks@l
    lwz r10, 8(r29)
    lis r9, _gz_map_sector@ha
    lwz r9, _gz_map_sector@l(r9)
    mulli r9, r9, 12
    lis r12, _gz_map_quadrants@ha
    addi r12, r12, _gz_map_quadrants@l
    add r12, r12, r9
    lwz r7, 8(r12)

    lwz r9, 12(r11)
    and. r0, r8, r9
    beq _gz_map_list_down
    addi r10, r10, -1
    cmpwi r10, 0
    bge _gz_map_list_down
    addi r10, r7, -1
_gz_map_list_down:
    lwz r9, 16(r11)
    and. r0, r8, r9
    beq _gz_map_list_selected
    addi r10, r10, 1
    cmpw r10, r7
    blt _gz_map_list_selected
    li r10, 0
_gz_map_list_selected:
    stw r10, 8(r29)
    lwz r8, 0x10(r1)
    lwz r9, 20(r11)
    and. r0, r8, r9
    bne _gz_map_v02_far_5
    b _gz_mask
_gz_map_v02_far_5:
    lwz r0, 0(r31)
    and r0, r0, r9
    cmpw r0, r9
    beq _gz_map_v02_far_6
    b _gz_mask
_gz_map_v02_far_6:
    lwz r9, 4(r12)
    add r10, r10, r9
    slwi r10, r10, 3
    lis r9, _gz_map_destinations@ha
    addi r9, r9, _gz_map_destinations@l
    add r9, r9, r10
    lwz r10, 4(r9)
    lis r9, _gz_warp_choice@ha
    stw r10, _gz_warp_choice@l(r9)
    lis r9, _gz_pending@ha
    li r10, 3
    stw r10, _gz_pending@l(r9)
    b _gz_mask
_gz_map_back:
    lis r9, _gz_page@ha
    lwz r10, _gz_page@l(r9)
